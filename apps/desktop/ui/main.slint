    callback jump-date(string);
    callback sign-out();
    callback sign-out-all();
    callback setting-changed(string);
    callback attach(string);
    callback browse-file();
    // M-31: video. "Upload video" (desktop picker) and "Photo or video" (Android shell), and recording the screen (desktop). 1.4: no in-app camera recording on Android.
    callback browse-video();
    callback pick-media(string);
    callback screen-record-toggle();
    in-out property <bool> can-screen-record: false;
    in-out property <string> screen-rec-text: "";
    callback open-file(string);
    callback open-link(string);
    callback typing();
    callback composer-edited(string);
    callback pick-mention(string);
    callback format(string);
    callback emoji-picked(string);
    callback pin(string);
    callback copy-link(string);
    callback forward-to(string, string);
    callback open-people();
    callback start-dm(string);
    callback toggle-fav(string);
    callback mute(string, string);
    callback notify-level(string, string);
    callback mark-unread(string);
    callback set-section(string, string);
    // E-05: spell check of the message boxes ("main" and "thread").
    in-out property <[SpellMark]> spell-marks;
    in-out property <[SpellMark]> thread-spell-marks;
    in-out property <[string]> spell-menu;
    in-out property <string> spell-word;
    in-out property <string> probe-text;
    in-out property <length> probe-width: 300px;
    in-out property <int> probe-off: 0;
    in-out property <bool> spell-on: true;
    in-out property <string> spell-lang-label: "English (Australia)";
    in-out property <[string]> spell-langs;
    callback spell-lang-pick(int);
    callback spell-check(string, string, length);
    callback spell-context(string, length, length, length, length);
    callback spell-pick(int);
    callback spell-add();
    callback spell-ignore();
    callback probed(int, length, length);
    public function probe(off: int) {
        root.probe-off = off;
        probe-ti.set-selection-offsets(off, off);
    }
    callback reorder-drop(string, string, int);
    callback move-row(string, int);
    callback reset-order();
    callback new-section(string);
    callback set-presence(string);
    callback save-profile(string);
    callback set-avatar(string);
    callback choose-avatar();
    callback revoke-session(string);
    callback revoke-others();
    callback nav-back();
    callback nav-forward();
    callback switcher-edited(string);
    callback open-switcher();
    callback result-clicked(int, string, string);
    callback row-clicked(string, string, string);
    callback zoom-step(int);
    callback open-settings();
    callback tab-changed(int);
    callback form-action(string, string);
    callback form-text(int, string);
    callback form-toggle(int, string);
    callback form-submit(string);
    callback home-action(string, string);
    callback schedule(string);
    callback open-drafts();
    callback cancel-scheduled(string);
    callback add-bookmark(string, string);
    callback save-search(string);
    callback play-audio(string);
    callback record-toggle();
    callback paste-image();

    // ---- 1.2: shell and navigation ----
    // Desktop rail tab / phone bottom tab: home, dms, activity, later, you.
    in-out property <string> main-tab: "home";
    // 1.4 phone: the selected bottom tab (dms, channels, search, menu) and the lists of the DMs and Channels tabs (pinned first).
    in-out property <string> phone-tab: "dms";
    in-out property <[SideRow]> phone-dms;
    in-out property <[SideRow]> phone-chans;
    in-out property <int> chan-unread: 0;
    callback pin-toggle(string);
    callback pin-drop(string, string, int);
    callback move-pinned(string, int);
    callback phone-nav(string);
    in-out property <[SideRow]> side-rows;
    in-out property <[SideRow]> dm-rows;
    in-out property <string> server-name: "SuperChat";
    in-out property <string> server-initials: "S";
    in-out property <int> activity-unread: 0;
    in-out property <int> dm-unread: 0;
    in-out property <int> presence-i: 1;
    in-out property <length> thread-w: 380px;
    in-out property <length> menu-x: -1px;
    in-out property <bool> menu-up: false;
    in-out property <length> menu-y: -1px;
    out property <length> rail-w: self.wide ? 68px * max(1.0, Theme.scale * 0.9) : 0px;
    out property <length> top-h: self.wide ? max(44px, 36px * Theme.scale) : 0px;

    // ---- 1.2: messages ----
    in-out property <string> edit-text;
    in-out property <[EmojiItem]> emoji-sugg;
    in-out property <bool> thread-also: false;
    in-out property <string> thread-conv-title;

    // ---- 1.2: details, members, people picker ----
    in-out property <[PersonItem]> pp-list;
    in-out property <string> pp-mode; // new-message, add-people
    in-out property <string> pp-text;
    in-out property <int> pp-count: 0;
    in-out property <bool> pp-open: false;
    in-out property <bool> can-manage: false;
    in-out property <string> current-topic;
    in-out property <string> current-kind;
    in-out property <string> current-created;
    in-out property <string> topic-edit;
    in-out property <string> name-edit;
    in-out property <string> quote-id;
    in-out property <string> quote-text;
    callback quote-reply(string);
    callback rename-conv(string);
    callback archive-toggle();
    in-out property <bool> current-muted: false;
    in-out property <string> current-notify: "All messages";
    in-out property <int> member-count: 0;
    in-out property <[PersonItem]> head-people;
    in-out property <string> remove-person;
    in-out property <string> remove-person-name;

    // ---- 1.2: Later, labels, Activity, search ----
    in-out property <[SavedRow]> saved-rows;
    in-out property <[LabelItem]> labels;
    in-out property <string> label-filter;
    in-out property <string> label-msg;
    in-out property <bool> label-open: false;
    in-out property <string> label-new-name;
    in-out property <int> label-new-color: 0;
    in-out property <[ActivityRow]> activity-rows;
    in-out property <int> activity-filter: 0;
    in-out property <int> search-tab: 0;
    in-out property <[PersonItem]> filter-people;
    in-out property <[RowItem]> filter-chans;

    // ---- 1.2: App Lock management ----
    in-out property <[RowItem]> locked-convs;
    in-out property <[RowItem]> lockable-convs;

    callback side-clicked(string, string);
    callback side-toggle(string);
    callback side-plus(string);
    callback set-main-tab(string);
    callback activity-clicked(string, string, string, string);
    callback activity-filter-changed(int);
    callback mark-activity-read();
    callback later-clicked(string, string);
    callback save-msg(string);
    callback label-picker(string);
    callback label-toggle(string, string);
    callback label-create(string, int);
    callback label-rename(string, string);
    callback label-recolor(string);
    callback label-delete(string);
    callback label-filter-changed(string);
    callback unsave(string);
    callback pp-open-for(string);
    callback select-conv-step(int);
    callback pp-filter(string);
    callback pp-toggle(string);
    callback pp-confirm();
    callback remove-member(string);
    callback save-topic(string);
    callback copy-text(string);
    callback emoji-pick-sugg(string);
    callback search-filter(string, string);
    callback lock-add(string);
    callback lock-remove-conv(string);
    callback up-edit();
    callback open-admin-panel();
    callback open-later();
    callback open-conv-in-context(string, string);
    callback thread-send-also(string, bool);
    callback mark-read(string);
    callback mention-open();
    callback open-details-data();
    callback prepare-menu(string);

    public function scroll-bottom() {
        root.list-y = min(0px, root.list-vh - root.list-h);
    }
    public function scroll-to-fraction(f: float) {
        root.list-y = min(0px, -(root.list-h - root.list-vh) * f);
    }
    // Opens the context menu of a conversation of the list, at the pointer on desktop.
    public function open-conv-menu(id: string, title: string, fav: bool) {
        root.menu-conv = id;
        root.menu-title = title;
        root.menu-fav = fav;
        root.menu-kind = "conv";
        root.prepare-menu(id);
    }
    // Details of the current conversation: a modal with tabs on desktop, a page list on the phone.
    public function open-details(page: string) {
        root.menu-kind = "";
        root.info-page = page;
        root.info-open = true;
        root.open-details-data();
        if page == "files" { root.tab-changed(1); }
        if page == "home" { root.tab-changed(3); }
    }
    // Conversation tab of the desktop main pane: 0 Messages, 1 Files, 2 Pins, 3 Home, 4 Bookmarks.
    public function set-tab(t: int) {
        root.tab = t;
        root.info-open = false;
        root.tab-changed(t);
    }
    public function send-composer() {
        root.send(root.composer);
        root.composer = "";
    }
    public function start-edit(id: string) {
        root.edit-text = root.begin-edit(id);
        root.editing-id = id;
    }
    public function new-message() {
        root.pp-mode = "new-message";
        root.pp-text = "";
        root.pp-open-for("new-message");
        root.pp-open = true;
    }
    public function open-directory(kind: string) {
        root.pp-mode = kind;
        root.pp-text = "";
        root.pp-open-for(kind);
        root.pp-open = true;
    }
    public function add-people() {
        root.pp-mode = "add-people";
        root.pp-text = "";
        root.pp-open-for("add-people");
        root.pp-open = true;
    }
    public function open-files() {
        root.open-search();
        root.search-tab = 1;
        root.search("");
    }

    // Desktop: a rail tab. Phone: a bottom tab, or a page that belongs to one (Activity, You, Later); the phone's own tab stack
    // (apps/desktop/src/nav.rs) decides what is shown and calls `set-main-tab`.
    public function go-home-tab(t: string) {
        root.screen = "";
        root.settings-page = "";
        root.info-open = false;
        if root.wide {
            root.main-tab = (t == "channels" || t == "search" || t == "menu" || t == "you") ? "home" : t;
            root.set-main-tab(root.main-tab);
        } else {
            root.show-chat = false;
            root.phone-nav(t);
        }
    }
    // The same window can be a phone or a desktop (it was resized): keep the page that belongs to the layout.
    public function fix-layout() {
        if root.wide && (root.main-tab == "channels" || root.main-tab == "search" || root.main-tab == "menu" || root.main-tab == "you") { root.main-tab = "home"; }
        if !root.wide && root.signed-in { root.phone-nav(root.main-tab == "home" ? root.phone-tab : root.main-tab); }
    }
    // Search is a bottom tab on the phone, a page above everything on the desktop.
    property <bool> phone-search: !root.wide && root.main-tab == "search" && !root.show-chat && root.screen == "";

    init => { Theme.wide = root.wide; root.fix-layout(); }
    changed signed-in => { root.fix-layout(); }
    changed wide => { Theme.wide = root.wide; root.fix-layout(); }
    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : (root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown);
    }
    changed list-y => {
        if root.list-y > -30px && root.has-more-older && root.tab == 0 { root.load-older(); }
    }
    changed menu-kind => {
        if root.menu-kind == "" { root.menu-x = -1px; root.menu-y = -1px; root.menu-up = false; }
    }

    FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && e.text == "k" { root.open-switcher(); return accept; }
            if e.modifiers.control && e.text == "f" { root.open-search(); return accept; }
            if e.modifiers.control && e.modifiers.shift && e.text == "A" { root.go-home-tab("activity"); return accept; }
            if e.modifiers.control && e.text == "," { root.open-settings(); return accept; }
            if e.modifiers.control && (e.text == "+" || e.text == "=") { root.zoom-step(10); return accept; }
            if e.modifiers.control && e.text == "-" { root.zoom-step(-10); return accept; }
            if e.modifiers.control && e.text == "0" { root.zoom-step(0); return accept; }
            if e.modifiers.alt && e.text == Key.UpArrow { root.select-conv-step(-1); return accept; }
            if e.modifiers.alt && e.text == Key.DownArrow { root.select-conv-step(1); return accept; }
            if e.modifiers.alt && e.text == Key.LeftArrow { if !root.back-pressed() { root.nav-back(); } return accept; }
            if e.modifiers.alt && e.text == Key.RightArrow { root.nav-forward(); return accept; }
            if e.text == Key.Escape { root.back-pressed(); return accept; }
            reject
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            Rectangle {
                vertical-stretch: 1;

                // ======================= login =======================
                if !root.signed-in: ScrollView {
                    VerticalLayout {
                        alignment: center;
                        padding: 24px;
                        Rectangle {
                            max-width: 420px;
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 64px; height: 64px; border-radius: 20px; background: Theme.accent;
                                        Icon { name: "thread"; size: 34px; tint: Theme.on-accent; weight: 2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                    }
                                }
                                Text { text: "SuperChat"; font-size: Theme.fs-large * 1.2; font-weight: 700; horizontal-alignment: center; color: Theme.text; }
                                Text { text: "Sign in to your team's server"; color: Theme.muted; font-size: Theme.fs; horizontal-alignment: center; }
                                server-edit := LineEdit { text <=> root.f-server; placeholder-text: "Server address (https://chat.example.com)"; font-size: Theme.fs; edited(t) => { root.server-edited(t); } }
                                HorizontalLayout {
                                    spacing: 8px;
                                    GhostButton { text: "Username & password"; on: !root.use-link; horizontal-stretch: 1; clicked => { root.use-link = false; root.login-error = ""; } }
                                    GhostButton { text: "Login link"; on: root.use-link; horizontal-stretch: 1; clicked => { root.use-link = true; root.login-error = ""; } }
                                }
                                if !root.use-link: LineEdit { text <=> root.f-user; placeholder-text: "Username"; font-size: Theme.fs; }
                                if !root.use-link: LineEdit { text <=> root.f-pass; placeholder-text: "Password"; input-type: password; font-size: Theme.fs; accepted => { root.login(root.f-server, root.f-user, root.f-pass, ""); } }
                                if root.use-link: VerticalLayout {
                                    spacing: 10px;
                                    Text { text: "Paste the one-time login link your administrator sent you (it looks like https://chat.example.com/l/...), or scan its QR code. Tapping the link on this phone opens the app by itself."; color: Theme.muted; font-size: Theme.fs-small; wrap: word-wrap; }
                                    link-edit := LineEdit { text <=> root.f-link; placeholder-text: "Login link"; font-size: Theme.fs; edited(t) => { root.server-edited(t); } accepted => { root.login(root.f-server, "", "", root.f-link); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        GhostButton {
                                            text: "Paste";
                                            horizontal-stretch: 1;
                                            clicked => { if root.is-android { root.paste-clip(); } else { link-edit.focus(); link-edit.paste(); root.server-edited(root.f-link); } }
                                        }
                                        if root.can-scan: GhostButton {
                                            text: "Scan QR code";
                                            horizontal-stretch: 1;
                                            clicked => { root.scan-qr(); }
                                        }
                                    }
                                    if root.can-scan: GhostButton {
                                        text: "Choose image with QR";
                                        clicked => { root.scan-image(); }
                                    }
                                }
                                if root.login-error != "": Text { text: root.login-error; color: Theme.danger; wrap: word-wrap; font-size: Theme.fs; }
                                PrimaryButton {
                                    text: root.busy ? "Signing in..." : "Sign in";
                                    enabled: !root.busy;
                                    clicked => {
                                        if root.use-link { root.login(root.f-server, "", "", root.f-link); } else { root.login(root.f-server, root.f-user, root.f-pass, ""); }
                                    }
                                }
                                Text { text: root.version; font-size: Theme.fs-small; color: Theme.muted; horizontal-alignment: center; }
                            }
                        }
                    }
                }

                // ======================= main =======================
                if root.signed-in: VerticalLayout {
                    if root.wide: TopBar {
                        server-name: root.server-name;
                        can-back: root.can-back;
                        can-forward: root.can-forward;
                        back => { root.nav-back(); }
                        forward => { root.nav-forward(); }
                        search => { root.open-search(); }
                        help => { root.menu-kind = "help"; }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        if root.wide: Rail {
                            tab: root.main-tab;
                            server-initials: root.server-initials;
                            activity-unread: root.activity-unread;
                            dm-unread: root.dm-unread;
                            me-initials: root.me-initials;
                            me-id: root.me-id;
                            me-color: root.me-color;
                            presence: root.presence-i;
                            update-available: root.upd-banner;
                            update-clicked => { root.open-about(); }
                            picked(t) => { root.go-home-tab(t); }
                            more-open: root.menu-kind == "more";
                            server-clicked => { root.menu-up = false; root.menu-x = root.rail-w + 4px; root.menu-y = root.top-h + 6px; root.menu-kind = "server"; }
                            more-clicked(x, y) => { root.menu-up = false; root.menu-x = x + 4px; root.menu-y = y - 8px; root.menu-kind = "more"; }
                            profile-clicked(x, y) => { root.menu-up = true; root.menu-x = x + 4px; root.menu-y = y; root.menu-kind = "profile"; }
                        }

                        // ---- list column: sidebar, DMs, Activity, Later, You ----
                        if root.wide || !root.show-chat: Rectangle {
                            width: root.wide ? 300px * max(1.0, Theme.scale * 0.92) : root.width;
                            background: root.wide ? Theme.side-bg : Theme.sidebar;
                            VerticalLayout {
                                // Header of the column.
                                // ---- desktop: the sidebar header ----
                                if root.wide && root.main-tab == "home": Rectangle {
                                    height: max(52px, 44px * Theme.scale);
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 6px;
                                        spacing: 10px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text { text: root.server-name; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                                Icon { name: "chevron-down"; size: 18px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            TouchArea { clicked => { root.menu-up = false; root.menu-x = root.rail-w + 8px; root.menu-y = root.top-h + 48px * Theme.scale; root.menu-kind = "server"; } }
                                        }
                                        ToolButton { icon: "edit"; label: "New message"; size: 34px * Theme.scale; y: (parent.height - self.height) / 2; clicked => { root.new-message(); } }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                }
                                if root.wide && root.main-tab == "dms": Rectangle {
                                    height: max(52px, 44px * Theme.scale);
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 6px; spacing: 6px;
                                        Text { text: "Direct messages"; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        ToolButton { icon: "edit"; label: "New message"; size: 40px; y: (parent.height - self.height) / 2; clicked => { root.new-message(); } }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                }
                                // ---- phone: the top bar's title is the screen name (1.4.1) ----
                                if !root.wide && (root.main-tab == "dms" || root.main-tab == "channels"): PhoneTopBar {
                                    title: root.main-tab == "dms" ? "Direct Messages" : "Channels";
                                    more => { root.menu-kind = "overflow"; }
                                }
                                if !root.wide && (root.main-tab == "dms" || root.main-tab == "channels") && root.upd-banner: UpdateBanner {
                                    text: root.upd-banner-text;
                                    open => { root.open-about(); }
                                    dismiss => { root.upd-remind(); }
                                }
                                if root.main-tab == "activity": VerticalLayout {
                                    Rectangle {
                                        height: max(root.wide ? 52px : 60px, 44px * Theme.scale);
                                        HorizontalLayout {
                                            padding-left: root.wide ? 16px : 4px; padding-right: 6px; spacing: 6px;
                                            if !root.wide: IconButton { icon: "back"; label: "Back"; clicked => { root.back-pressed(); } y: (parent.height - self.height) / 2; }
                                            Text { text: "Activity"; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                                            if root.activity-unread > 0: TextButton { text: "Mark all read"; clicked => { root.mark-activity-read(); } y: (parent.height - self.height) / 2; }
                                        }
                                    }
                                    Flickable {
                                        height: 46px;
                                        content-width: achips.preferred-width;
                                        achips := HorizontalLayout {
                                            padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: start;
                                            for t[i] in ["All", "Mentions", "Threads", "Reactions"]: Pill { y: (parent.height - self.height) / 2; text: t; on: root.activity-filter == i; clicked => { root.activity-filter = i; root.activity-filter-changed(i); } }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                }
                                if root.main-tab == "later": VerticalLayout {
                                    Rectangle {
                                        height: max(root.wide ? 60px : 66px, 50px * Theme.scale);
                                        HorizontalLayout {
                                            padding-left: root.wide ? 16px : 4px; padding-right: 6px; spacing: 6px;
                                            if !root.wide: IconButton { icon: "back"; label: "Back"; clicked => { root.back-pressed(); } y: (parent.height - self.height) / 2; }
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                Text { text: "Later"; font-size: Theme.fs-title * (root.wide ? 1.0 : 0.95); font-weight: 700; color: Theme.text; overflow: elide; }
                                                Text { text: "Messages you saved, only visible to you"; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                            }
                                            TextButton { text: "Labels"; clicked => { root.label-msg = ""; root.label-open = true; } y: (parent.height - self.height) / 2; }
                                        }
                                    }
                                    Flickable {
                                        height: max(46px, 42px * Theme.scale);
                                        content-width: lchips.preferred-width;
                                        lchips := HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start;
                                            Pill { y: (parent.height - self.height) / 2; text: "All"; on: root.label-filter == ""; clicked => { root.label-filter = ""; root.label-filter-changed(""); } }
                                            for l in root.labels: LabelChip { height: 34px * Theme.scale; y: (parent.height - self.height) / 2; text: l.name; tint: l.tint; on: root.label-filter == l.id; clicked => { root.label-filter = l.id; root.label-filter-changed(l.id); } }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                }
                                if !root.wide && root.main-tab == "menu": PhoneTopBar {
                                    title: "Menu";
                                    show-more: false;
                                }
                                if !root.wide && root.main-tab == "you": AppBar { title: "You"; back => { root.back-pressed(); } }
                                if root.status != "" && root.status != "Connected" && root.status != "\u{0}done": Rectangle {
                                    height: stt.preferred-height + 10px;
                                    background: Theme.surface;
                                    stt := Text { x: 16px; width: parent.width - 32px; text: root.status; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; vertical-alignment: center; }
                                }

                                // Desktop Home: the sidebar.
                                if root.wide && root.main-tab == "home" && root.side-rows.length == 0: EmptyState { vertical-stretch: 1; icon: "chat"; title: "No conversations yet"; hint: "Start a conversation with someone on your server."; action: "New message"; act => { root.new-message(); } }
                                if root.wide && root.main-tab == "home" && root.side-rows.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for r[i] in root.side-rows: SideItem {
                                        r: r;
                                        wide: root.wide;
                                        selected: r.kind == 1 && r.id == root.current-conv && (root.wide || root.show-chat);
                                        clicked => { root.side-clicked(r.id, r.kind == 2 ? "link" : "conv"); if r.kind == 1 { root.show-chat = true; } }
                                        toggle => { root.side-toggle(r.id); }
                                        plus => { root.side-plus(r.plus); }
                                        menu(x, y) => { root.menu-x = x; root.menu-y = y; if r.kind == 0 { root.menu-conv = r.id; root.menu-title = r.title; root.menu-kind = "secmenu"; } else { root.open-conv-menu(r.id, r.title, r.favourite); } }
                                        dropped => {
                                            if Drag.target != "" && Drag.zone != 0 { root.reorder-drop(Drag.src, Drag.target, Drag.zone); }
                                            Drag.reset();
                                        }
                                    }
                                }
                                // Desktop DMs.
                                if root.wide && root.main-tab == "dms" && root.dm-rows.length == 0: EmptyState { vertical-stretch: 1; icon: "chat"; title: "No direct messages yet"; hint: "Message a teammate privately."; action: "New message"; act => { root.new-message(); } }
                                if root.wide && root.main-tab == "dms" && root.dm-rows.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for r[i] in root.dm-rows: DmRow {
                                        r: r;
                                        selected: r.id == root.current-conv && (root.wide || root.show-chat);
                                        clicked => { root.side-clicked(r.id, "conv"); root.show-chat = true; }
                                        menu(x, y) => { root.menu-x = x; root.menu-y = y; root.open-conv-menu(r.id, r.title, r.favourite); }
                                    }
                                }
                                // Phone DMs and Channels: pinned conversations first, then the rest in the chosen order.
                                if !root.wide && root.main-tab == "dms" && root.phone-dms.length == 0: EmptyState { vertical-stretch: 1; icon: "chat"; title: "No direct messages yet"; hint: root.unread-only || root.hide-muted ? "Nothing matches the filter. Turn it off in the menu at the top right." : "Message a teammate privately."; action: "New message"; act => { root.new-message(); } }
                                if !root.wide && root.main-tab == "dms" && root.phone-dms.length > 0: PhoneList {
                                    vertical-stretch: 1;
                                    rows: root.phone-dms;
                                    selected: root.show-chat ? root.current-conv : "";
                                    fab => { root.new-message(); }
                                    clicked(id) => { root.side-clicked(id, "conv"); root.show-chat = true; }
                                    menu(id, title, fav, x, y) => { root.menu-x = x; root.menu-y = y; root.open-conv-menu(id, title, fav); }
                                    dropped => {
                                        if Drag.target != "" && Drag.zone != 0 { root.pin-drop(Drag.src, Drag.target, Drag.zone); }
                                        Drag.reset();
                                    }
                                }
                                if !root.wide && root.main-tab == "channels" && root.phone-chans.length == 0 && !root.is-admin: EmptyState { vertical-stretch: 1; icon: "hash"; title: "No channels yet"; hint: root.unread-only || root.hide-muted ? "Nothing matches the filter. Turn it off in the menu at the top right." : "An admin adds you to channels."; }
                                if !root.wide && root.main-tab == "channels" && (root.phone-chans.length > 0 || root.is-admin): PhoneList {
                                    vertical-stretch: 1;
                                    rows: root.phone-chans;
                                    can-create: root.is-admin;
                                    selected: root.show-chat ? root.current-conv : "";
                                    fab => { root.new-message(); }
                                    clicked(id) => { root.side-clicked(id, "conv"); root.show-chat = true; }
                                    menu(id, title, fav, x, y) => { root.menu-x = x; root.menu-y = y; root.open-conv-menu(id, title, fav); }
                                    create => { root.new-channel-name = ""; root.new-channel-open = true; }
                                    dropped => {
                                        if Drag.target != "" && Drag.zone != 0 { root.pin-drop(Drag.src, Drag.target, Drag.zone); }
                                        Drag.reset();
                                    }
                                }
                                // Activity.
                                if root.main-tab == "activity" && root.activity-rows.length == 0: EmptyState {
                                    vertical-stretch: 1;
                                    icon: "bell";
                                    title: root.activity-filter == 0 ? "You're all caught up" : "Nothing here";
                                    hint: "Mentions of you, reactions to your messages and replies in threads you follow show up here.";
                                }
                                if root.main-tab == "activity" && root.activity-rows.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for a[i] in root.activity-rows: ActivityItem { a: a; clicked => { root.activity-clicked(a.conv, a.msg, a.root, a.id); if !root.wide { root.show-chat = true; } } }
                                }
                                // Later.
                                if root.main-tab == "later" && root.saved-rows.length == 0: EmptyState {
                                    vertical-stretch: 1;
                                    icon: "bookmark";
                                    title: root.label-filter == "" ? "Nothing saved for later" : "Nothing with this label";
                                    hint: root.wide ? "Save messages to come back to them later. Hover a message and click the bookmark icon. Add labels to organise them." : "Save messages to come back to them later. Long-press a message → Save for later. Add labels to organise them.";
                                }
                                if root.main-tab == "later" && root.saved-rows.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for s[i] in root.saved-rows: SavedCard {
                                        s: s;
                                        clicked => { root.later-clicked(s.conv, s.id); if !root.wide { root.show-chat = true; } }
                                        label => { root.label-picker(s.id); }
                                        remove => { root.unsave(s.id); }
                                    }
                                }
                                // Phone Menu: you, Activity, Settings.
                                if !root.wide && root.main-tab == "menu": ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-bottom: 32px;
                                        spacing: 14px;
                                        alignment: start;
                                        Card {
                                            Rectangle {
                                                height: max(84px, 68px * Theme.scale);
                                                background: mp.pressed ? Theme.bubble-other : transparent;
                                                HorizontalLayout {
                                                    padding-left: 16px; padding-right: 12px; spacing: 14px;
                                                    Avatar { uid: root.me-id; initials: root.me-initials; tint: root.me-color; size: 56px * min(Theme.scale, 1.3); presence: root.presence-i; y: (parent.height - self.height) / 2; }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        spacing: 2px;
                                                        Text { text: root.me-name; font-size: Theme.fs-large * 0.85; font-weight: 700; color: Theme.text; overflow: elide; }
                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            Rectangle { width: 9px; height: 9px; y: (parent.height - self.height) / 2; border-radius: 4.5px; background: root.presence-pref == "dnd" ? Theme.danger : (root.presence-pref == "away" ? Theme.warn : Theme.ok); }
                                                            Text { text: root.presence-pref == "dnd" ? "Do not disturb" : (root.presence-pref == "away" ? "Away" : "Active"); font-size: Theme.fs-small * 1.05; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                                        }
                                                    }
                                                    Icon { name: "chevron-right"; size: 20px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                                                }
                                                mp := TouchArea { clicked => { root.go-home-tab("you"); } }
                                            }
                                        }
                                        Card {
                                            SettingRow { icon: "bell"; badge: #e8590c; title: "Activity"; summary: root.activity-unread > 0 ? root.activity-unread + " new" : ""; clicked => { root.go-home-tab("activity"); } }
                                            SettingRow { icon: "settings"; badge: #64748b; title: "Settings"; clicked => { root.open-settings(); } divider: false; }
                                        }
                                        Text { text: root.version; font-size: Theme.fs-small; color: Theme.muted; horizontal-alignment: center; }
                                    }
                                }
                                // Phone You page (opened from the Menu): status, pause notifications, saved items, files, App Lock, devices, sign out.
                                if !root.wide && root.main-tab == "you": ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-bottom: 32px;
                                        spacing: 14px;
                                        alignment: start;
                                        Card {
                                            VerticalLayout {
                                                padding: 18px;
                                                spacing: 4px;
                                                HorizontalLayout { alignment: center; Avatar { uid: root.me-id; initials: root.me-initials; tint: root.me-color; size: 72px * min(Theme.scale, 1.2); presence: root.presence-i; } }
                                                Text { text: root.me-name; font-size: Theme.fs-large; font-weight: 700; color: Theme.text; horizontal-alignment: center; overflow: elide; }
                                                if root.me-username != "": Text { text: "@" + root.me-username; font-size: Theme.fs; color: Theme.muted; horizontal-alignment: center; }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    padding-top: 6px;
                                                    Rectangle {
                                                        height: 36px * Theme.scale;
                                                        width: ystl.preferred-width + 50px;
                                                        border-radius: self.height / 2;
                                                        background: Theme.surface-high;
                                                        Rectangle { x: 14px; y: (parent.height - self.height) / 2; width: 10px; height: 10px; border-radius: 5px; background: root.presence-pref == "dnd" ? Theme.danger : (root.presence-pref == "away" ? Theme.warn : Theme.ok); }
                                                        ystl := Text { x: 32px; text: root.presence-pref == "dnd" ? "Do not disturb" : (root.presence-pref == "away" ? "Away" : "Active"); font-size: Theme.fs-small * 1.1; color: Theme.text; vertical-alignment: center; }
                                                        TouchArea { clicked => { root.menu-kind = "pick-status"; } }
                                                    }
                                                }
                                            }
                                        }
                                        Card {
                                            SettingRow { icon: "bell-off"; badge: #dc2626; title: "Pause notifications"; has-switch: true; on: root.presence-pref == "dnd"; toggled => { root.set-presence(self.on ? "dnd" : "auto"); } }
                                            SettingRow { icon: "person"; badge: #64748b; title: "Profile"; clicked => { root.open-settings(); root.settings-page = "account"; } }
                                            SettingRow { icon: "bookmark"; badge: #f59e0b; title: "Saved items (Later)"; summary: root.saved-rows.length > 0 ? "" + root.saved-rows.length : ""; clicked => { root.go-home-tab("later"); } }
                                            SettingRow { icon: "file"; badge: #0d9488; title: "Files"; summary: ""; clicked => { root.open-files(); } divider: false; }
                                        }
                                        Card {
                                            SettingRow { icon: "lock"; badge: #16a34a; title: "App Lock"; summary: root.lock-set ? "On" : "Off"; clicked => { root.open-settings(); root.settings-page = "lock"; } divider: root.is-admin || root.sign-out-allowed; }
                                            if root.is-admin: SettingRow { icon: "shield"; badge: #8b5cf6; title: "Admin panel"; summary: "In browser"; clicked => { root.open-admin-panel(); } divider: root.sign-out-allowed; }
                                            if root.sign-out-allowed: SettingRow { icon: "devices"; badge: #3b82f6; title: "Devices"; clicked => { root.open-settings(); root.settings-page = "devices"; } divider: true; }
                                            if root.sign-out-allowed: SettingRow { icon: "logout"; badge: Theme.danger; title: "Sign out"; danger: true; chevron: false; clicked => { root.confirm = "signout"; } divider: false; }
                                        }
                                        Text { text: root.version; font-size: Theme.fs-small; color: Theme.muted; horizontal-alignment: center; }
                                    }
                                }
                                // Phone Search: the page itself is drawn above (see "search" below); this keeps the bar at the bottom.
                                if !root.wide && root.main-tab == "search": Rectangle { vertical-stretch: 1; }
                                if !root.wide && root.virtual-keyboard-size.height == 0px: BottomNav {
                                    tab: root.phone-tab;
                                    menu-unread: root.activity-unread;
                                    dm-unread: root.dm-unread;
                                    chan-unread: root.chan-unread;
                                    picked(t) => { root.go-home-tab(t); }
                                }
                            }
                        }
                        if root.wide: Rectangle { width: 1px; background: Theme.line; }

                        // ---- conversation ----
                        if (root.wide || root.show-chat) && !(root.thread-id != "" && !root.wide): VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 280px;
                            // header
                            Rectangle {
                                height: max(root.wide ? 52px : 60px, 44px * Theme.scale);
                                HorizontalLayout {
                                    padding-left: root.wide ? 16px : 4px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    if !root.wide: IconButton { icon: "back"; label: "Back to the conversation list"; clicked => { root.back-pressed(); } y: (parent.height - self.height) / 2; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            if root.current-conv != "" && root.current-kind == "channel": Icon { name: root.is-conv-locked(root.current-conv) ? "lock" : "hash"; size: 20px * Theme.scale; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                                            if root.current-conv != "" && root.current-kind == "group": Icon { name: "users"; size: 20px * Theme.scale; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                                            if root.current-conv != "" && (root.current-kind == "dm" || root.current-kind == "self"): Avatar { uid: root.current-user-id; initials: root.current-initials; tint: root.current-color; size: 30px * Theme.scale; y: (parent.height - self.height) / 2; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: root.current-title == "" ? "Choose a conversation" : root.current-title; font-size: Theme.fs * 1.12; font-weight: 700; color: Theme.text; overflow: elide; }
                                                if root.typing-text != "" || (!root.wide && root.current-sub != ""): Text { text: root.typing-text != "" ? root.typing-text : root.current-sub; font-size: Theme.fs-small; color: root.typing-text != "" ? Theme.accent-text : Theme.muted; overflow: elide; }
                                            }
                                            if root.wide && root.current-conv != "": Icon { name: "chevron-down"; size: 16px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        if root.current-conv != "": TouchArea { clicked => { root.open-details(root.wide ? "about" : ""); } }
                                    }
                                    if root.wide && root.current-conv != "" && root.current-kind != "self": Rectangle {
                                        width: hp.preferred-width + 16px;
                                        height: 34px * Theme.scale;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.r-sm;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: hpa.has-hover ? Theme.row-hover : transparent;
                                        hp := HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            for p[i] in root.head-people: Avatar { uid: p.id; initials: p.initials; tint: p.color; size: 22px * Theme.scale; y: (parent.height - self.height) / 2; }
                                            Text { text: root.member-count; font-size: Theme.fs-small * 1.1; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                        }
                                        hpa := TouchArea { clicked => { root.open-details("members"); } }
                                    }
                                    if !root.wide && root.current-conv != "": IconButton { icon: "info"; label: "Conversation details"; clicked => { root.open-details(""); } y: (parent.height - self.height) / 2; }
                                    if root.wide && root.current-conv != "": ToolButton { icon: "info"; label: "Conversation details"; size: 34px * Theme.scale; y: (parent.height - self.height) / 2; clicked => { root.open-details("about"); } }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                            if root.wide && root.current-conv != "": HorizontalLayout {
                                height: max(40px, 34px * Theme.scale);
                                TabBar {
                                    horizontal-stretch: 1;
                                    tabs: root.is-bot-dm ? ["Messages", "Files", "Pins", "Bookmarks", "Home"] : ["Messages", "Files", "Pins", "Bookmarks"];
                                    current: root.tab == 0 ? 0 : (root.tab == 1 ? 1 : (root.tab == 2 ? 2 : (root.tab == 4 ? 3 : 4)));
                                    picked(i) => { root.set-tab(i == 0 ? 0 : (i == 1 ? 1 : (i == 2 ? 2 : (i == 3 ? 4 : 3)))); }
                                }
                            }
                            if root.jump-open: HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                LineEdit { text <=> root.jump-text; placeholder-text: "dd/mm/yyyy"; font-size: Theme.fs; accepted => { root.jump-date(root.jump-text); root.jump-open = false; } }
                                PrimaryButton { text: "Go"; clicked => { root.jump-date(root.jump-text); root.jump-open = false; } }
                            }

                            if root.current-conv == "": EmptyState { vertical-stretch: 1; icon: "chat"; title: "Pick a conversation"; hint: "Choose a channel or direct message from the sidebar, or start a new message."; action: "New message"; act => { root.new-message(); } }
                            // Files / Pins / Bookmarks / Home tabs (desktop).
                            if root.wide && root.current-conv != "" && root.tab != 0: DetailsView {
                                avatar-key: root.current-avatar-key; avatar-initials: root.current-initials; avatar-tint: root.current-color;
                                avatar-tap => { root.menu-kind = "avatar-photo"; }
                                vertical-stretch: 1;
                                page: root.tab == 1 ? "files" : (root.tab == 2 ? "pins" : (root.tab == 4 ? "bookmarks" : "home"));
                                files: root.files; pins: root.pins; bookmarks: root.bookmarks; home: root.home;
                                can-curate: root.can-curate;
                                open-file(f) => { root.open-file(f); }
                                open-pin(id, conv) => { root.row-clicked("pin", id, conv); root.tab = 0; }
                                open-link(u) => { root.open-link(u); }
                                add-bookmark => { root.bm-title = ""; root.bm-url = ""; root.bookmark-open = true; }
                                home-action(k, id) => { root.home-action(k, id); }
                            }
                            // Desktop: a slim bar under the tabs while the first unread message is out of view.
                            if root.wide && root.tab == 0 && root.current-conv != "" && root.unread-away: Rectangle {
                                height: max(28px, 24px * Theme.scale);
                                background: Theme.accent;
                                Text { text: (root.unread-above ? "\u{2191} " : "\u{2193} ") + root.unread-new + (root.unread-new == 1 ? " new message" : " new messages") + " - Jump to first unread"; color: Theme.on-accent; font-size: Theme.fs-small; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.jump-unread(); } }
                            }
                            if root.current-conv != "" && (root.tab == 0 || !root.wide): Rectangle {
                                vertical-stretch: 1;
                                if root.messages.length == 0: EmptyState { width: parent.width; height: parent.height; icon: "chat"; title: "This is the start of " + root.current-title; hint: "Say hello. Messages you send appear here for everyone in the conversation."; }
                                ListView {
                                    content-y <=> root.list-y;
                                    changed visible-height => { root.list-vh = self.visible-height; }
                                    changed content-height => { root.list-h = self.content-height; }
                                    for m[i] in root.messages: MessageRow {
                                        wide: root.wide;
                                        quick: root.quick-emoji;
                                        playing-id: root.playing-id;
                                        audio-id: root.audio-id; play-frac: root.play-frac; play-time: root.play-time; play-speed: root.play-speed;
                                        seek-audio(f, x) => { root.seek-audio(f, x); }
                                        cycle-speed => { root.cycle-speed(); }
                                        m: m;
                                        editing-id: root.editing-id;
                                        edit-text <=> root.edit-text;
                                        selected: root.menu-kind == "msg" && m.id == root.menu-msg;
                                        actions(x, y) => { root.sel-msg = m; root.sel-in-thread = false; root.menu-msg = m.id; root.menu-x = x; root.menu-y = y; root.menu-kind = "msg"; }
                                        react(e) => { root.react(m.id, e); }
                                        more-reactions(x, y) => { root.menu-x = x; root.menu-y = y; root.picker-target = m.id; root.menu-kind = "emoji"; }
                                        retry => { root.retry(m.id); }
                                        discard => { root.discard-send(m.id); }
                                        open-thread => { root.open-thread(m.id); }
                                        forward => { root.menu-msg = m.id; root.menu-kind = "forward"; }
                                        save => { root.save-msg(m.id); }
                                        play-audio(f) => { root.play-audio(f); }
                                        open-file(f) => { root.open-file(f); }
                                        open-link(l) => { root.open-link(l); }
                                        form-action(b) => { root.form-action(m.id, b); }
                                        edit-save(t) => { root.save-edit(m.id, t); root.editing-id = ""; }
                                        edit-cancel => { root.editing-id = ""; }
                                    }
                                }
                                // Phone: a compact floating pill centred under the top bar; hidden while the first unread is on screen.
                                if !root.wide && root.unread-away: Rectangle {
                                    x: (parent.width - self.width) / 2; y: 8px; width: fu.preferred-width + 32px; height: max(32px, 28px * Theme.scale); border-radius: self.height / 2; background: Theme.accent;
                                    fu := Text { x: 16px; y: (parent.height - self.height) / 2; text: (root.unread-above ? "\u{2191} " : "\u{2193} ") + root.unread-new + (root.unread-new == 1 ? " new message" : " new messages"); color: Theme.on-accent; font-size: Theme.fs-small; font-weight: 700; }
                                    TouchArea { clicked => { root.jump-unread(); } }
                                }
                            }
                            if root.attach-open && (root.tab == 0 || !root.wide): HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                LineEdit { placeholder-text: "Full path of the file (or drop / paste it here)"; font-size: Theme.fs; text <=> root.attach-path; accepted => { root.attach(root.attach-path); root.attach-path = ""; root.attach-open = false; } }
                                GhostButton { text: "Browse"; clicked => { root.browse-file(); } }
                                GhostButton { text: "Paste image"; clicked => { root.paste-image(); } }
                                PrimaryButton { text: "Send file"; clicked => { root.attach(root.attach-path); root.attach-path = ""; root.attach-open = false; } }
                            }
                            if root.mentions.length > 0 && (root.tab == 0 || !root.wide): Rectangle {
                                height: min(root.mentions.length, 4) * 44px * Theme.scale;
                                background: Theme.surface;
                                VerticalLayout {
                                    for p in root.mentions: Rectangle {
                                        height: 44px * Theme.scale;
                                        background: mt.has-hover ? Theme.bubble-other : transparent;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            spacing: 10px;
                                            Avatar { uid: p.id; initials: p.initials; tint: p.color; size: 28px * Theme.scale; y: (parent.height - self.height) / 2; }
                                            Text { text: p.name + "  " + p.sub; font-size: Theme.fs; vertical-alignment: center; color: Theme.text; }
                                        }
                                        mt := TouchArea { clicked => { root.pick-mention(p.id); } }
                                    }
                                }
                            }
                            if root.emoji-sugg.length > 0 && (root.tab == 0 || !root.wide): Rectangle {
                                height: 48px * Theme.scale;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 12px; spacing: 4px; alignment: start;
                                    for e in root.emoji-sugg: Rectangle {
                                        width: 44px * Theme.scale;
                                        background: es.has-hover ? Theme.bubble-other : transparent;
                                        border-radius: Theme.r-sm;
                                        if e.has-img: Image { source: e.img; width: 26px * Theme.scale; height: 26px * Theme.scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        if !e.has-img: Text { text: e.ch; font-size: 22px * Theme.scale; horizontal-alignment: center; vertical-alignment: center; }
                                        es := TouchArea { clicked => { root.emoji-pick-sugg(e.ch); } }
                                    }
                                }
                            }
                            if root.current-conv != "" && (root.tab == 0 || !root.wide): VerticalLayout {
                                padding-left: root.wide ? 16px : 6px;
                                padding-right: root.wide ? 16px : 6px;
                                padding-bottom: root.wide ? 12px : 4px;
                                padding-top: 4px;
                                if !root.can-write: Text { text: "You cannot write in this conversation."; color: Theme.muted; font-size: Theme.fs-small; horizontal-alignment: center; height: 40px; vertical-alignment: center; }
                                if root.can-write && root.quote-id != "": Rectangle {
                                    height: qrt.preferred-height + 14px;
                                    background: Theme.surface;
                                    border-radius: Theme.r-sm;
                                    Rectangle { x: 0; width: 3px; background: Theme.accent; }
                                    qrt := Text { x: 14px; y: 7px; width: parent.width - 56px; text: root.quote-text; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                    ToolButton { x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2; icon: "close"; label: "Cancel quote reply"; size: 30px * Theme.scale; clicked => { root.quote-id = ""; root.quote-text = ""; } }
                                }
                                if root.can-write: composer := Composer {
                                    wide: root.wide;
                                    text <=> root.composer;
                                    placeholder: root.current-kind == "channel" ? "Message #" + root.current-title : "Message " + root.current-title;
                                    recording: root.recording;
                                    can-record: root.can-record;
                                    formatting: root.formatting-open;
                                    send => { root.send-composer(); }
                                    edited(t) => { root.typing(); root.composer-edited(t); }
                                    format(f) => { root.format(f); }
                                    attach(x, y) => { root.menu-up = true; root.menu-x = x; root.menu-y = y - 6px; root.menu-kind = "attach"; }
                                    emoji(x, y) => { root.menu-up = true; root.menu-x = x; root.menu-y = y - 6px; root.picker-target = ""; root.menu-kind = "emoji"; }
                                    mention => { root.composer = root.composer + "@"; root.composer-edited(root.composer); self.focus-input(); }
                                    schedule => { root.schedule-error = ""; root.schedule-when = ""; root.schedule-open = true; }
                                    toggle-format => { root.formatting-open = !root.formatting-open; }
                                    cancel-edit => { root.composer = ""; }
                                    record-toggle => { root.record-toggle(); }
                                    up-edit => { root.up-edit(); }
                                    marks: root.spell-marks;
                                    spell-check(t, w) => { root.spell-check("main", t, w); }
                                    spell-context(x, y, ax, ay) => { root.spell-context("main", x, y, ax, ay); }
                                }
                            }
                        }

                        // ---- thread panel (a side panel on desktop, a full screen on the phone) ----
                        if root.thread-id != "": Rectangle {
                            width: root.wide ? root.thread-w : root.width;
                            background: Theme.bg;
                            if root.wide: Rectangle { x: 0px; width: 1px; background: Theme.line; }
                            VerticalLayout {
                                Rectangle {
                                    height: max(root.wide ? 52px : 56px, 42px * Theme.scale);
                                    HorizontalLayout {
                                        padding-left: root.wide ? 16px : 4px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        if !root.wide: IconButton { icon: "back"; label: "Back"; clicked => { root.back-pressed(); } y: (parent.height - self.height) / 2; }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: "Thread"; font-size: Theme.fs * 1.12; font-weight: 700; color: Theme.text; }
                                            Text { text: root.thread-conv-title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                        }
                                        if root.wide: ToolButton { icon: "close"; label: "Close thread"; size: 34px * Theme.scale; y: (parent.height - self.height) / 2; clicked => { root.close-thread(); } }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: start;
                                        MessageRow {
                                            wide: root.wide;
                                            quick: root.quick-emoji;
                                            playing-id: root.playing-id;
                                            audio-id: root.audio-id; play-frac: root.play-frac; play-time: root.play-time; play-speed: root.play-speed;
                                            seek-audio(f, x) => { root.seek-audio(f, x); }
                                            cycle-speed => { root.cycle-speed(); }
                                            m: root.thread-root;
                                            in-thread: true;
                                            play-audio(f) => { root.play-audio(f); }
                                            open-file(f) => { root.open-file(f); }
                                            open-link(l) => { root.open-link(l); }
                                            react(e) => { root.react(root.thread-root.id, e); }
                                            actions(x, y) => { root.sel-msg = root.thread-root; root.sel-in-thread = true; root.menu-msg = root.thread-root.id; root.menu-x = x; root.menu-y = y; root.menu-kind = "msg"; }
                                            more-reactions(x, y) => { root.menu-x = x; root.menu-y = y; root.picker-target = root.thread-root.id; root.menu-kind = "emoji"; }
                                            save => { root.save-msg(root.thread-root.id); }
                                            forward => { root.menu-msg = root.thread-root.id; root.menu-kind = "forward"; }
                                        }
                                        if root.thread-messages.length > 0: HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px; spacing: 10px; height: 28px;
                                            Text { text: root.thread-messages.length == 1 ? "1 reply" : root.thread-messages.length + " replies"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; vertical-alignment: center; }
                                            Rectangle { height: 1px; y: 14px; background: Theme.line; horizontal-stretch: 1; }
                                        }
                                        if root.thread-messages.length == 0: Text { text: "No replies yet. Be the first to reply."; font-size: Theme.fs; color: Theme.muted; padding: 16px; horizontal-alignment: center; }
                                        for m[i] in root.thread-messages: MessageRow {
                                            wide: root.wide;
                                            quick: root.quick-emoji;
                                            playing-id: root.playing-id;
                                            audio-id: root.audio-id; play-frac: root.play-frac; play-time: root.play-time; play-speed: root.play-speed;
                                            seek-audio(f, x) => { root.seek-audio(f, x); }
                                            cycle-speed => { root.cycle-speed(); }
                                            m: m;
                                            in-thread: true;
                                            editing-id: root.editing-id;
                                            edit-text <=> root.edit-text;
                                            selected: root.menu-kind == "msg" && m.id == root.menu-msg;
                                            actions(x, y) => { root.sel-msg = m; root.sel-in-thread = true; root.menu-msg = m.id; root.menu-x = x; root.menu-y = y; root.menu-kind = "msg"; }
                                            react(e) => { root.react(m.id, e); }
                                            more-reactions(x, y) => { root.menu-x = x; root.menu-y = y; root.picker-target = m.id; root.menu-kind = "emoji"; }
                                            retry => { root.retry(m.id); }
                                        discard => { root.discard-send(m.id); }
                                            save => { root.save-msg(m.id); }
                                            forward => { root.menu-msg = m.id; root.menu-kind = "forward"; }
                                            play-audio(f) => { root.play-audio(f); }
                                            open-file(f) => { root.open-file(f); }
                                            open-link(l) => { root.open-link(l); }
                                            edit-save(t) => { root.save-edit(m.id, t); root.editing-id = ""; }
                                            edit-cancel => { root.editing-id = ""; }
                                        }
                                    }
                                }
                                if root.can-write: VerticalLayout {
                                    padding-left: root.wide ? 12px : 6px;
                                    padding-right: root.wide ? 12px : 6px;
                                    padding-bottom: root.wide ? 12px : 4px;
                                    Composer {
                                        wide: root.wide;
                                        text <=> root.thread-composer;
                                        placeholder: "Reply...";
                                        allow-schedule: false;
                                        also-label: root.current-kind == "channel" ? "Also send to #" + root.thread-conv-title : "Also send to " + root.thread-conv-title;
                                        also-on <=> root.thread-also;
                                        formatting: root.formatting-open;
                                        send => { root.thread-send(root.thread-composer); root.thread-composer = ""; }
                                        edited(t) => { root.typing(); }
                                        format(f) => { root.format(f); }
                                        attach(x, y) => { root.menu-up = true; root.menu-x = x; root.menu-y = y - 6px; root.menu-kind = "attach"; }
                                        emoji(x, y) => { root.menu-up = true; root.menu-x = x; root.menu-y = y - 6px; root.picker-target = ""; root.menu-kind = "emoji"; }
                                        mention => { root.thread-composer = root.thread-composer + "@"; }
                                        toggle-format => { root.formatting-open = !root.formatting-open; }
                                        marks: root.thread-spell-marks;
                                        spell-check(t, w) => { root.spell-check("thread", t, w); }
                                        spell-context(x, y, ax, ay) => { root.spell-context("thread", x, y, ax, ay); }
                                    }
                                }
                            }
                            // Drag the left edge to resize the panel.
                            if root.wide: Rectangle {
                                x: 0px; width: 8px;
                                TouchArea {
                                    mouse-cursor: MouseCursor.col-resize;
                                    moved => { root.thread-w = max(320px, min(640px, root.thread-w - (self.mouse-x - self.pressed-x))); }
                                }
                            }
                        }
                    }
                }

                // ======================= full-screen pages (below the top bar and beside the rail on desktop) =======================
                pages := Rectangle {
                    x: root.rail-w;
                    y: root.top-h;
                    width: parent.width - root.rail-w;
                    height: parent.height - root.top-h;

                // ---- search ----
                if root.signed-in && (root.screen == "search" || root.phone-search): Rectangle {
                    // Phone: the Search tab, above the list column but not above the bottom bar (it is hidden while the keyboard is up).
                    height: root.phone-search && root.virtual-keyboard-size.height == 0px ? parent.height - max(64px, 54px * Theme.scale) : parent.height;
                    background: Theme.bg; y: 0px; x: 0px;
                    TouchArea { }
                    VerticalLayout {
                        if root.phone-search: PhoneTopBar {
                            title: "Search";
                            show-more: false;
                        }
                        HorizontalLayout {
                            height: max(56px, 42px * Theme.scale);
                            padding-left: root.phone-search ? 12px : 4px; padding-right: 12px; spacing: 4px;
                            if !root.phone-search: IconButton { icon: "back"; label: "Back"; clicked => { root.back-pressed(); } y: (parent.height - self.height) / 2; }
                            sfield := LineEdit {
                                init => { if root.phone-search && root.search-text == "" { self.focus(); } }
                                placeholder-text: "Search " + root.server-name;
                                font-size: Theme.fs;
                                text <=> root.search-text;
                                accepted(t) => { root.search(t); }
                                edited(t) => { if !root.ai-on { root.search(t); } }
                                y: (parent.height - self.height) / 2;
                            }
                            if root.search-text != "": IconButton { icon: "close"; label: "Clear"; clicked => { root.search-text = ""; root.search(""); } y: (parent.height - self.height) / 2; }
                            if root.ai-on: PrimaryButton { text: "Ask"; clicked => { root.search(root.search-text); } y: (parent.height - self.height) / 2; }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            height: 46px;
                            padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start;
                            for f in [{t: "From", k: "f-from"}, {t: "In", k: "f-in"}, {t: "Date", k: "f-date"}, {t: "Has", k: "f-has"}]: Pill {
                                y: (parent.height - self.height) / 2;
                                text: f.t + " v";
                                clicked => { root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + self.height + 4px; root.menu-kind = f.k; }
                            }
                        }
                        if root.search-text != "" || root.search-tab != 0: TabBar {
                            tabs: ["Messages", "Files", "People", "Channels"];
                            current: root.search-tab;
                            picked(i) => { root.search-tab = i; root.search(root.search-text); }
                        }
                        if root.ai-enabled: VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 4px;
                            SettingRow { icon: "star"; badge: #7b61ff; title: "Ask AI (natural-language search)"; has-switch: true; on: root.ai-on; divider: false; toggled => { root.ai-on = self.on; root.ai-answer = ""; } }
                            Text { text: "When on, your question and the names of your people and channels are sent to the AI provider your admin set up. Message text is sent only for recaps and answers."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            if root.ai-busy: Text { text: "Asking the AI..."; font-size: Theme.fs-small; color: Theme.accent-text; }
                            if root.ai-note != "": Text { text: root.ai-note; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            if root.ai-answer != "": Rectangle { background: Theme.surface; border-radius: Theme.r-md; height: aat.preferred-height + 16px; aat := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.ai-answer; wrap: word-wrap; font-size: Theme.fs; color: Theme.text; } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                if root.search-text == "" && root.search-tab == 0 && root.saved.length > 0: SectionHeader { text: "Saved searches"; }
                                if root.search-text == "" && root.search-tab == 0: VerticalLayout {
                                    for r in root.saved: SheetRow { icon: "star"; text: r.title; clicked => { root.search-text = r.title; root.search(r.title); } }
                                }
                                if root.search-text == "" && root.search-tab == 0 && root.recents.length > 0: SectionHeader { text: "Recent searches"; }
                                if root.search-text == "" && root.search-tab == 0: VerticalLayout {
                                    for r in root.recents: SheetRow { icon: "clock"; text: r.title; clicked => { root.search-text = r.title; root.search(r.title); } }
                                }
                                if root.search-text != "": Rectangle {
                                    height: 40px;
                                    HorizontalLayout { padding-left: 16px; padding-right: 16px; alignment: end; Link { text: "Save this search"; clicked => { root.save-search(root.search-text); } } }
                                }
                                if (root.search-text != "" || root.search-tab != 0) && root.results.length == 0: EmptyState { height: 220px; icon: "search"; title: "No results"; hint: "Try different words, or switch the tab above (Messages, Files, People, Channels)."; }
                                for r[i] in root.results: Rectangle {
                                    height: (r.header != "" ? Theme.fs-small * 2.4 : 0px) + max(68px, 54px * Theme.scale);
                                    VerticalLayout {
                                        if r.header != "": SectionHeader { text: r.header; }
                                        Rectangle {
                                            vertical-stretch: 1;
                                            background: rt.pressed ? Theme.bubble-other : transparent;
                                            HorizontalLayout {
                                                padding-left: 16px; padding-right: 16px; spacing: 14px;
                                                if r.kind >= 2: Avatar { uid: r.kind == 2 ? r.id : ""; initials: r.initials; tint: r.color; size: 40px * Theme.scale; y: (parent.height - self.height) / 2; }
                                                if r.kind == 1: FileGlyph { ext: r.ext; size: 40px * min(Theme.scale, 1.3); y: (parent.height - self.height) / 2; }
                                                if r.kind == 0: Rectangle { width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 10px; background: Theme.surface;
                                                    Icon { name: "thread"; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text { text: r.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                                    HorizontalLayout {
                                                        spacing: 0px;
                                                        Text { text: r.pre; font-size: Theme.fs; color: Theme.text; overflow: elide; horizontal-stretch: r.hit == "" ? 1 : 0; }
                                                        if r.hit != "": Rectangle { background: Theme.mention-bg; width: ht.preferred-width; ht := Text { text: r.hit; font-size: Theme.fs; font-weight: 700; color: Theme.text; } }
                                                        if r.hit != "": Text { text: r.post; font-size: Theme.fs; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                                                    }
                                                }
                                            }
                                            rt := TouchArea { clicked => { root.result-clicked(r.kind, r.id, r.conv); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- threads ----
                if root.signed-in && root.screen == "threads": Rectangle {
                    background: Theme.bg;
                    TouchArea { }
                    VerticalLayout {
                        AppBar { title: "Threads"; back => { root.back-pressed(); } }
                        if root.threads.length == 0: Rectangle { vertical-stretch: 1; Text { text: "Threads you start, reply in or follow appear here."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; x: 24px; width: parent.width - 48px; } }
                        if root.threads.length > 0: ListView {
                            vertical-stretch: 1;
                            for t[i] in root.threads: Rectangle {
                                height: max(80px, 64px * Theme.scale);
                                background: tt.pressed ? Theme.bubble-other : transparent;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Rectangle { width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 20px; background: Theme.surface;
                                        Icon { name: "thread"; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: t.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                        Text { text: t.text; font-size: Theme.fs; overflow: elide; font-weight: t.badge > 0 ? 700 : 400; color: Theme.text; }
                                        Text { text: t.sub; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                    }
                                    if t.badge > 0: Rectangle {
                                        width: 24px * Theme.scale; height: 24px * Theme.scale; y: (parent.height - self.height) / 2; border-radius: 12px * Theme.scale; background: Theme.accent;
                                        Text { text: t.badge; color: Theme.on-accent; font-size: Theme.fs-small; font-weight: 700; }
                                    }
                                }
                                tt := TouchArea { clicked => { root.row-clicked("thread", t.id, t.conv); } }
                            }
                        }
                    }
                }

                // ---- drafts & sent ----
                if root.signed-in && root.screen == "scheduled": Rectangle {
                    background: Theme.bg;
                    TouchArea { }
                    VerticalLayout {
                        AppBar { title: "Drafts & sent"; back => { root.back-pressed(); } }
                        if root.drafts-rows.length == 0: Rectangle { vertical-stretch: 1; Text { text: "Nothing scheduled and no drafts. Use Schedule send in the attach menu to send later."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; x: 24px; width: parent.width - 48px; } }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for r[i] in root.drafts-rows: VerticalLayout {
                                    if r.header != "": SectionHeader { text: r.header; }
                                    Rectangle {
                                        height: max(76px, 62px * Theme.scale);
                                        background: dr.pressed ? Theme.bubble-other : transparent;
                                        HorizontalLayout {
                                            padding-left: 16px; padding-right: 8px; spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: r.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                                Text { text: r.text; font-size: Theme.fs; color: Theme.text; overflow: elide; }
                                                Text { text: r.sub; font-size: Theme.fs-small; color: r.flag ? Theme.danger : Theme.muted; overflow: elide; }
                                            }
                                            if r.kind == 0: IconButton { icon: "trash"; label: "Cancel this scheduled message"; tint: Theme.danger; clicked => { root.cancel-scheduled(r.id); } y: (parent.height - self.height) / 2; }
                                        }
                                        dr := TouchArea { clicked => { if r.kind != 0 { root.row-clicked("conv", r.conv, r.conv); } } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- quick switcher (desktop, Ctrl+K) ----
                if root.signed-in && root.screen == "switcher": Rectangle {
                    background: Theme.bg.with-alpha(0.97);
                    TouchArea { clicked => { root.screen = ""; } }
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "Jump to a conversation"; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; }
                        LineEdit {
                            placeholder-text: "Type a name";
                            font-size: Theme.fs;
                            text <=> root.switcher-text;
                            edited(t) => { root.switcher-edited(t); }
                            accepted(t) => { if root.switcher.length > 0 { root.row-clicked("conv", root.switcher[0].id, root.switcher[0].id); } }
                        }
                        for r[i] in root.switcher: Rectangle {
                            height: 48px * Theme.scale;
                            background: sw.has-hover || i == 0 ? Theme.bubble-other : transparent;
                            border-radius: Theme.r-sm;
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 10px;
                                Avatar { initials: r.initials; tint: r.color; size: 32px * Theme.scale; y: (parent.height - self.height) / 2; }
                                Text { text: r.title; font-size: Theme.fs; vertical-alignment: center; color: Theme.text; }
                            }
                            sw := TouchArea { clicked => { root.row-clicked("conv", r.id, r.id); } }
                        }
                    }
                }

                // ---- settings ----
                if root.signed-in && root.screen == "settings": Rectangle {
                    background: Theme.bg;
                    TouchArea { }
                    VerticalLayout {
                        AppBar {
                            title: root.settings-page == "" ? "Settings" : (root.settings-page == "account" ? "Profile" : (root.settings-page == "notif" ? "Notifications" : (root.settings-page == "appearance" ? "Appearance" : (root.settings-page == "privacy" ? "Privacy & Security" : (root.settings-page == "lock" ? "App Lock" : (root.settings-page == "devices" ? "Devices" : (root.settings-page == "chats" ? "Chats" : (root.settings-page == "desktop" ? "Desktop" : "About"))))))));
                            back => { root.back-pressed(); }
                        }
                        ScrollView {
                            content-y <=> root.settings-scroll-y;
                            vertical-stretch: 1;
                            HorizontalLayout {
                                padding-left: max(0px, (root.width - 620px) / 2);
                                padding-right: max(0px, (root.width - 620px) / 2);
                                Rectangle {
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-bottom: 32px;
                                        spacing: 16px;
                                        alignment: start;

                                        // ---------- main ----------
                                        if root.settings-page == "": Card {
                                            VerticalLayout {
                                                padding: 20px;
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    Rectangle { width: 48px; }
                                                    HorizontalLayout { horizontal-stretch: 1; alignment: center; Avatar { uid: root.me-id; initials: root.me-initials; tint: root.me-color; size: 84px * min(Theme.scale, 1.2); presence: root.presence-pref == "dnd" ? 3 : (root.presence-pref == "away" ? 2 : 1); } }
                                                    IconButton { icon: "edit"; label: "Edit profile"; clicked => { root.settings-page = "account"; } }
                                                }
                                                Text { text: root.me-name; font-size: Theme.fs-large; font-weight: 700; color: Theme.text; horizontal-alignment: center; overflow: elide; }
                                                if root.me-username != "": Text { text: "@" + root.me-username; font-size: Theme.fs; color: Theme.muted; horizontal-alignment: center; }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    padding-top: 6px;
                                                    Rectangle {
                                                        height: 36px * Theme.scale;
                                                        width: stl.preferred-width + 50px;
                                                        border-radius: self.height / 2;
                                                        background: Theme.surface-high;
                                                        Rectangle { x: 14px; y: (parent.height - self.height) / 2; width: 10px; height: 10px; border-radius: 5px; background: root.presence-pref == "dnd" ? Theme.danger : (root.presence-pref == "away" ? Theme.warn : Theme.ok); }
                                                        stl := Text { x: 32px; text: root.presence-pref == "dnd" ? "Do not disturb" : (root.presence-pref == "away" ? "Away" : "Online"); font-size: Theme.fs-small * 1.1; color: Theme.text; vertical-alignment: center; }
                                                        TouchArea { clicked => { root.menu-kind = "pick-status"; } }
                                                    }
                                                }
                                            }
                                        }
                                        if root.settings-page == "": Card {
                                            SettingRow { icon: "person"; badge: #3b82f6; title: "Profile"; summary: root.me-name; clicked => { root.settings-page = "account"; } }
                                            SettingRow { icon: "bell"; badge: #e8590c; title: "Notifications"; summary: root.notif ? "On" : "Off"; clicked => { root.settings-page = "notif"; } divider: false; }
                                        }
                                        if root.settings-page == "": Card {
                                            SettingRow { icon: "palette"; badge: #8b5cf6; title: "Appearance"; summary: root.theme-mode == 1 ? "Light" : (root.theme-mode == 2 ? "Dark" : "System"); clicked => { root.settings-page = "appearance"; } }
                                            SettingRow { icon: "thread"; badge: #0d9488; title: "Chats"; clicked => { root.settings-page = "chats"; } divider: !root.is-android; }
                                            if !root.is-android: SettingRow { icon: "devices"; badge: #64748b; title: "Desktop"; clicked => { root.settings-page = "desktop"; } divider: false; }
                                        }
                                        if root.settings-page == "": Card {
                                            SettingRow { icon: "shield"; badge: #16a34a; title: "Privacy & Security"; summary: root.lock-set ? "App Lock on" : ""; clicked => { root.settings-page = "privacy"; } divider: false; }
                                        }
                                        if root.settings-page == "": Card {
                                            SettingRow { icon: "info"; badge: #475569; title: "About"; summary: root.upd-banner ? "Update available" : root.version; clicked => { root.settings-page = "about"; } divider: root.sign-out-allowed; }
                                            if root.sign-out-allowed: SettingRow { icon: "logout"; badge: Theme.danger; title: "Sign out"; danger: true; chevron: false; clicked => { root.confirm = "signout"; } divider: false; }
                                        }

                                        // ---------- profile ----------
                                        if root.settings-page == "account": Card {
                                            VerticalLayout {
                                                padding: 16px; spacing: 10px;
                                                HorizontalLayout { alignment: center; Avatar { uid: root.me-id; initials: root.me-initials; tint: root.me-color; size: 84px * min(Theme.scale, 1.2); } }
                                                Text { text: "Display name"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
                                                LineEdit { text <=> root.edit-name; placeholder-text: "Display name"; font-size: Theme.fs; }
                                                HorizontalLayout { alignment: end; PrimaryButton { text: "Save"; clicked => { root.save-profile(root.edit-name); } } }
                                                Text { text: "Profile photo"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
                                                if !root.is-android: LineEdit { text <=> root.avatar-path; placeholder-text: "Path of a profile photo (png or jpg)"; font-size: Theme.fs; }
                                                HorizontalLayout {
                                                    alignment: end; spacing: 8px;
                                                    GhostButton { text: "Choose photo"; clicked => { root.choose-avatar(); } }
                                                    if !root.is-android: GhostButton { text: "Set photo"; clicked => { root.set-avatar(root.avatar-path); } }
                                                }
                                            }
                                        }
                                        if root.settings-page == "account": Card {
                                            SettingRow { icon: "check"; badge: #16a34a; title: "Status"; summary: root.presence-pref == "dnd" ? "Do not disturb" : (root.presence-pref == "away" ? "Away" : "Online"); divider: false; clicked => { root.menu-kind = "pick-status"; } }
                                        }

                                        // ---------- notifications ----------
                                        if root.settings-page == "notif": Card {
                                            SettingRow { icon: "bell"; badge: #e8590c; title: "Show notifications"; has-switch: true; on: root.notif; toggled => { root.notif = self.on; root.setting-changed("notif"); } }
                                            SettingRow { icon: "speaker"; badge: #7c3aed; title: "Notification sounds"; has-switch: true; on: root.notif-sound; toggled => { root.notif-sound = self.on; root.setting-changed("notif"); } }
                                            if root.notif-sound: SettingRow { icon: "bell-ring"; badge: #7c3aed; title: "Default sound"; summary: root.sound-default-label; clicked => { root.menu-conv = ""; root.menu-kind = "sound"; } }
                                            SettingRow { icon: "hash"; badge: #0d9488; title: "Show unread count"; has-switch: true; on: root.badge-counts; toggled => { root.badge-counts = self.on; root.setting-changed("notif"); } }
                                            SettingRow { icon: "eye-off"; badge: #64748b; title: "Show message preview"; has-switch: true; on: root.notif-preview; toggled => { root.notif-preview = self.on; root.setting-changed("notif"); } }
                                            SettingRow { icon: "bell-off"; badge: #dc2626; title: "Do not disturb"; has-switch: true; on: root.presence-pref == "dnd"; divider: root.is-android; toggled => { root.set-presence(self.on ? "dnd" : "auto"); } }
                                            if root.is-android: SettingRow { icon: "globe"; badge: #0d9488; title: "Push method"; summary: root.push-choice == "ntfy" ? "ntfy" : (root.push-choice == "fcm" ? "Google (FCM)" : "Off"); divider: false; clicked => { root.menu-kind = "pick-push"; } }
                                        }
                                        if root.settings-page == "notif" && root.is-android && root.push-choice == "ntfy": Card {
                                            VerticalLayout {
                                                padding: 16px; spacing: 8px;
                                                Text { text: "ntfy server"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
                                                LineEdit { text <=> root.ntfy-url; placeholder-text: "empty for the server's default"; font-size: Theme.fs; edited => { root.setting-changed("push"); } }
                                            }
                                        }
                                        if root.settings-page == "notif" && root.is-android: Text { text: "Pushes never contain message text: the app wakes, syncs and shows its own notification. Sounds and vibration follow Android's notification settings for SuperChat."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                        if root.settings-page == "notif": Text { text: "Per-conversation levels and sounds: open a chat, More options, Options, Notify me about or Notification sound."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }

                                        // ---------- appearance ----------
                                        if root.settings-page == "appearance": Card {
                                            SettingRow { icon: "palette"; badge: #8b5cf6; title: "Theme"; summary: root.theme-mode == 1 ? "Light" : (root.theme-mode == 2 ? "Dark" : "System"); clicked => { root.menu-kind = "pick-theme"; } }
                                            Rectangle {
                                                height: max(60px, 46px * Theme.scale) + 48px;
                                                VerticalLayout {
                                                    HorizontalLayout {
                                                        height: max(60px, 46px * Theme.scale);
                                                        padding-left: 16px; padding-right: 16px; spacing: 14px;
                                                        Rectangle { width: 36px; height: 36px; y: (parent.height - self.height) / 2; border-radius: 18px; background: Theme.accent;
                                                            Icon { name: "star"; size: 20px; tint: Theme.on-accent; weight: 2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
                                                        Text { text: "Accent colour"; font-size: Theme.fs; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 66px; spacing: 14px; height: 48px;
                                                        for c[i] in [#0dbd8b, #0467dd, #6a4cf5, #e8590c]: Rectangle {
                                                            width: 36px; height: 36px; y: 0px; border-radius: 18px; background: c;
                                                            border-width: Theme.accent-index == i ? 3px : 0px; border-color: Theme.text;

                                                            TouchArea { clicked => { Theme.accent-index = i; root.setting-changed("accent"); } }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                }
                                                Rectangle { x: 66px; y: parent.height - 1px; height: 1px; width: parent.width - 66px; background: Theme.line; }
                                            }
                                            SettingRow { icon: "text-size"; badge: #0467dd; title: "Text size"; summary: root.font-step == 1 ? "Large" : (root.font-step == 2 ? "Extra large" : "Regular"); clicked => { root.menu-kind = "pick-text"; } }
                                            SettingRow { icon: "sort"; badge: #64748b; title: "Compact density"; has-switch: true; on: Theme.compact; toggled => { Theme.compact = self.on; root.setting-changed("compact"); } }
                                            SettingRow { icon: "clock"; badge: #0d9488; title: "24-hour clock"; has-switch: true; on: root.hour24; toggled => { root.hour24 = self.on; root.setting-changed("hour24"); } }
                                            SettingRow { icon: "eye-off"; badge: #475569; title: "Reduce motion"; has-switch: true; on: Theme.reduce-motion; divider: false; toggled => { Theme.reduce-motion = self.on; root.setting-changed("motion"); } }
                                        }
                                        if root.settings-page == "appearance" && !root.is-android: Card {
                                            VerticalLayout {
                                                padding: 16px; spacing: 8px;
                                                Text { text: "Zoom (Ctrl and + / - / 0 also work)"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
                                                HorizontalLayout {
                                                    spacing: 8px; alignment: start;
                                                    GhostButton { text: "-"; clicked => { root.zoom-step(-10); } }
                                                    Text { text: root.zoom + "%"; font-size: Theme.fs; vertical-alignment: center; color: Theme.text; min-width: 56px; horizontal-alignment: center; }
                                                    GhostButton { text: "+"; clicked => { root.zoom-step(10); } }
                                                    GhostButton { text: "Reset"; clicked => { root.zoom-step(0); } }
                                                }
                                            }
                                        }

                                        // ---------- privacy & security ----------
                                        if root.settings-page == "privacy": Card {
                                            SettingRow { icon: root.lock-set ? "lock" : "unlock"; badge: #16a34a; title: "App Lock"; summary: root.lock-set ? "On" : "Off"; clicked => { root.settings-page = "lock"; } divider: root.privacy-enabled || root.sign-out-allowed; }
                                            if root.privacy-enabled: SettingRow { icon: "eye-off"; badge: #475569; title: "Hide my last active time"; has-switch: true; on: root.hide-last-active; divider: root.sign-out-allowed; toggled => { root.hide-last-active = self.on; root.setting-changed("privacy"); } }
                                            if root.sign-out-allowed: SettingRow { icon: "devices"; badge: #3b82f6; title: "Devices & sign-out"; clicked => { root.settings-page = "devices"; } divider: false; }
                                        }

                                        // ---------- App Lock ----------
                                        if root.settings-page == "lock": Card {
                                            SettingRow { icon: root.lock-set ? "lock" : "unlock"; badge: #16a34a; title: "App Lock"; has-switch: true; fixed-switch: true; on: root.lock-set; divider: root.lock-set; clicked => { root.lock-start(root.lock-set ? "remove" : "setup"); } }
                                            if root.lock-set: SettingRow { icon: "key"; badge: #3b82f6; title: "Change PIN"; divider: true; clicked => { root.lock-start("change"); } }
                                            if root.lock-set: SettingRow { icon: "clock"; badge: #0d9488; title: "Auto-lock"; summary: root.lock-timeout-label; divider: false; clicked => { root.menu-kind = "pick-lock-timeout"; } }
                                        }
                                        if root.settings-page == "lock": Text { x: 4px; text: "Locked chats are hidden from every list and search until you unlock with your PIN. The PIN stays on this device."; font-size: Theme.fs-small * 1.05; color: Theme.muted; wrap: word-wrap; }
                                        if root.settings-page == "lock" && root.lock-set: Card {
                                            VerticalLayout {
                                                padding: 16px; spacing: 6px;
                                                Text { text: "Locked chats"; font-size: Theme.fs; font-weight: 700; color: Theme.text; }
                                                if root.lock-engaged: Text { text: "Unlock to see the list."; font-size: Theme.fs-small * 1.05; color: Theme.muted; wrap: word-wrap; }
                                                if !root.lock-engaged && root.locked-convs.length == 0: Text { text: "None yet. Press and hold a chat in a list and choose Lock chat."; font-size: Theme.fs-small * 1.05; color: Theme.muted; wrap: word-wrap; }
                                                for c in root.locked-convs: Rectangle {
                                                    height: max(48px, 40px * Theme.scale);
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        Icon { name: "lock"; size: 18px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                                                        Text { text: c.title; font-size: Theme.fs; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                        ToolButton { icon: "close"; label: "Remove the lock from " + c.title; size: 44px; y: (parent.height - self.height) / 2; clicked => { root.lock-remove-conv(c.id); } }
                                                    }
                                                }
                                                if !root.lock-engaged: HorizontalLayout { alignment: start; GhostButton { text: "Lock a chat"; clicked => { root.menu-kind = "lock-pick"; } } }
                                            }
                                        }

                                        // ---------- devices ----------
                                        if root.settings-page == "devices": Card {
                                            for s[i] in root.sessions: Rectangle {
                                                height: max(64px, 52px * Theme.scale);
                                                HorizontalLayout {
                                                    padding-left: 16px; padding-right: 8px; spacing: 12px;
                                                    Icon { name: "devices"; y: (parent.height - self.height) / 2; }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1; alignment: center;
                                                        Text { text: s.title; font-size: Theme.fs; color: Theme.text; overflow: elide; }
                                                        Text { text: s.flag ? "This device  |  " + s.sub : s.sub; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                                    }
                                                    if !s.flag: TextButton { text: "Sign out"; danger: true; clicked => { root.revoke-session(s.id); } y: (parent.height - self.height) / 2; }
                                                }
                                                Rectangle { x: 16px; y: parent.height - 1px; height: 1px; width: parent.width - 16px; background: Theme.line; }
                                            }
                                            SettingRow { icon: "logout"; badge: Theme.danger; title: "Sign out all other devices"; danger: true; chevron: false; divider: false; clicked => { root.confirm = "revoke-others"; } }
                                        }
                                        if root.settings-page == "devices": Card {
                                            SettingRow { icon: "logout"; badge: Theme.danger; title: "Sign out of this device"; danger: true; chevron: false; clicked => { root.confirm = "signout"; } }
                                            SettingRow { icon: "logout"; badge: Theme.danger; title: "Sign out of all devices"; danger: true; chevron: false; divider: false; clicked => { root.confirm = "signout-all"; } }
                                        }

                                        // ---------- chats ----------
                                        if root.settings-page == "chats": Card {
                                            SettingRow { icon: "check"; badge: #dc2626; title: "Check spelling"; has-switch: true; on: root.spell-on; toggled => { root.spell-on = self.on; root.setting-changed("spell"); } }
                                            if root.spell-on && !root.is-android: SettingRow { icon: "globe"; badge: #0d9488; title: "Spelling language"; summary: root.spell-lang-label; divider: false; clicked => { root.menu-kind = "pick-spell"; } }
                                        }
                                        if root.settings-page == "chats": Card {
                                            SettingRow { icon: "clock"; badge: #0d9488; title: "Drafts & scheduled"; summary: root.scheduled-count > 0 ? root.scheduled-count + " scheduled" : ""; clicked => { root.open-drafts(); } }
                                            SettingRow { icon: "search"; badge: #3b82f6; title: "Saved searches"; summary: root.saved.length > 0 ? "" + root.saved.length : ""; clicked => { root.open-search(); } divider: false; }
                                        }
                                        if root.settings-page == "chats": Card {
                                            VerticalLayout {
                                                padding: 16px; spacing: 8px;
                                                Text { text: "Sections"; font-size: Theme.fs; font-weight: 700; color: Theme.text; }
                                                Text { text: "Group conversations in the list. Long-press a conversation, then Move to section."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                                for s in root.sections: Text { text: s.title; font-size: Theme.fs; color: Theme.text; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    LineEdit { text <=> root.new-section-name; placeholder-text: "New section name"; font-size: Theme.fs; }
                                                    GhostButton { text: "Add"; clicked => { root.new-section(root.new-section-name); root.new-section-name = ""; } }
                                                }
                                            }
                                        }

                                        // ---------- desktop ----------
                                        if root.settings-page == "desktop": Card {
                                            SettingRow { icon: "settings"; badge: #64748b; title: "Start when I sign in"; has-switch: true; on: root.launch-login; toggled => { root.launch-login = self.on; root.setting-changed("launch"); } }
                                            SettingRow { icon: "settings"; badge: #64748b; title: "Start minimised to the tray"; has-switch: true; on: root.start-min; toggled => { root.start-min = self.on; root.setting-changed("launch"); } }
                                            SettingRow { icon: "settings"; badge: #64748b; title: "Keep running in the tray when closed"; has-switch: true; on: root.close-tray; divider: false; toggled => { root.close-tray = self.on; root.setting-changed("tray"); } }
                                        }

                                        // ---------- about ----------
                                        if root.settings-page == "about": Card {
                                            VerticalLayout {
                                                padding: 20px;
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Image { source: @image-url("assets/icon.png"); width: 72px * min(Theme.scale, 1.3); height: self.width; }
                                                }
                                                Text { text: "SuperChat"; font-size: Theme.fs-large; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                                                Text { text: root.version-long; font-size: Theme.fs; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                                                if root.server-text != "": Text { text: "Server: " + root.server-text; font-size: Theme.fs-small * 1.05; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                                            }
                                        }
                                        if root.settings-page == "about": UpdateCard {
                                            phase: root.upd-phase;
                                            title: root.upd-title;
                                            detail: root.upd-detail;
                                            notes: root.upd-notes;
                                            progress: root.upd-progress;
                                            progress-text: root.upd-progress-text;
                                            primary: root.upd-primary;
                                            command: root.upd-command;
                                            auto: root.upd-auto;
                                            can-skip: root.upd-can-skip;
                                            check => { root.upd-check(); }
                                            primary-clicked => { root.upd-primary-clicked(); }
                                            cancel => { root.upd-cancel(); }
                                            skip => { root.upd-skip(); }
                                            remind => { root.upd-remind(); }
                                            copy-command => { root.upd-copy-command(); }
                                            auto-toggled(on) => { root.upd-auto = on; root.upd-auto-toggled(on); }
                                        }
                                        if root.settings-page == "about": Text { text: "Built with Slint (slint.dev). Typeface: Inter (SIL OFL 1.1). Colour emoji: Noto Color Emoji (SIL OFL 1.1). Spelling: en_AU Hunspell dictionary. SuperChat is open source software; LICENSE and THIRD-PARTY-NOTICES.txt ship with the desktop installers (Linux: /usr/share/doc/superchat) and the source repository."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- App Lock: the PIN screen (own keypad, six dots). Says nothing about what is hidden. ----
                if root.signed-in && root.lock-entry-open: Rectangle {
                    background: Theme.bg;
                    TouchArea { }
                    PinPad {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        title: root.lock-title;
                        hint: root.lock-hint;
                        error: root.lock-error;
                        digits: root.lock-pin.character-count;
                        shake <=> root.lock-shake;
                        key(k) => { root.lock-key(k); }
                        cancel => { root.lock-cancel(); }
                    }
                }

                    // ---- conversation details: a full page on the phone (the list, then one page per row) ----
                    if root.info-open && root.current-conv != "" && !root.wide: Rectangle {
                        background: Theme.bg;
                        TouchArea { }
                        VerticalLayout {
                            AppBar {
                                title: root.info-page == "" ? "Details" : (root.info-page == "about" ? "About" : (root.info-page == "members" ? "Members" : (root.info-page == "files" ? "Files" : (root.info-page == "pins" ? "Pins" : (root.info-page == "bookmarks" ? "Bookmarks" : (root.info-page == "settings" ? "Manage" : "Home"))))));
                                subtitle: root.current-title;
                                back => { root.back-pressed(); }
                            }
                            if root.info-page == "": ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 16px;
                                    padding-bottom: 32px;
                                    spacing: 14px;
                                    alignment: start;
                                    Card {
                                        VerticalLayout {
                                            padding: 18px; spacing: 4px;
                                            HorizontalLayout { alignment: center; Rectangle { width: 72px * min(Theme.scale, 1.2); height: self.width; Avatar { uid: root.current-avatar-key; initials: root.current-initials; tint: root.current-color; size: parent.width; } TouchArea { clicked => { root.menu-kind = "avatar-photo"; } } } }
                                            HorizontalLayout { alignment: center; TextButton { text: root.current-kind == "self" ? "Change profile photo" : "Photo"; clicked => { root.menu-kind = "avatar-photo"; } } }
                                            Text { text: (root.current-kind == "channel" ? "# " : "") + root.current-title; font-size: Theme.fs-large; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                                            Text { text: root.current-sub; font-size: Theme.fs; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                                        }
                                    }
                                    Card {
                                        SettingRow { icon: "info"; badge: #64748b; title: "About"; clicked => { root.open-details("about"); } }
                                        SettingRow { icon: "users"; badge: #3b82f6; title: "Members"; summary: root.member-count + ""; clicked => { root.open-details("members"); } }
                                        if root.can-manage: SettingRow { icon: "user-plus"; badge: #0dbd8b; title: "Add people"; clicked => { root.add-people(); } }
                                        SettingRow { icon: "file"; badge: #0d9488; title: "Files"; clicked => { root.open-details("files"); } }
                                        SettingRow { icon: "pin"; badge: #e8590c; title: "Pins"; clicked => { root.open-details("pins"); } }
                                        SettingRow { icon: "bookmark"; badge: #8b5cf6; title: "Bookmarks"; clicked => { root.open-details("bookmarks"); } divider: root.is-bot-dm || (root.can-manage && root.current-kind != "dm" && root.current-kind != "self"); }
                                        if root.can-manage && root.current-kind != "dm" && root.current-kind != "self": SettingRow { icon: "settings"; badge: #64748b; title: "Manage"; summary: "Rename, archive, delete"; clicked => { root.open-details("settings"); } divider: false; }
                                        if root.is-bot-dm: SettingRow { icon: "home"; badge: #f59e0b; title: "Home"; clicked => { root.open-details("home"); } divider: false; }
                                    }
                                    Card {
                                        SettingRow { icon: "bell"; badge: #e8590c; title: "Notifications"; summary: root.current-notify; clicked => { root.menu-conv = root.current-conv; root.menu-kind = "notify"; } }
                                        SettingRow { icon: "bell-off"; badge: #dc2626; title: "Mute"; summary: root.current-muted ? "Muted" : "Off"; clicked => { root.menu-conv = root.current-conv; root.menu-kind = "mute"; } }
                                        SettingRow { icon: root.wide ? "star" : "pin"; badge: #f59e0b; title: root.wide ? "Favourite" : "Pin to top"; has-switch: true; on: root.current-fav; toggled => { root.toggle-fav(root.current-conv); } }
                                        SettingRow { icon: "lock"; badge: #16a34a; title: root.lock-set ? (root.is-conv-locked(root.current-conv) ? "Unlock chat (keep visible)" : "Lock chat") : "Set up App Lock…"; chevron: !root.lock-set; clicked => { root.toggle-conv-lock(root.current-conv); } divider: false; }
                                    }
                                    Text { text: "Locked conversations are hidden until you unlock with your PIN."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                }
                            }
                            if root.info-page != "": DetailsView {
                                avatar-key: root.current-avatar-key; avatar-initials: root.current-initials; avatar-tint: root.current-color;
                                avatar-tap => { root.menu-kind = "avatar-photo"; }
                                vertical-stretch: 1;
                                phone: true;
                                page: root.info-page;
                                title: root.current-title; kind: root.current-kind; topic: root.current-topic; created: root.current-created;
                                member-count: root.member-count; members: root.members; files: root.files; pins: root.pins; bookmarks: root.bookmarks; home: root.home;
                                can-manage: root.can-manage; can-curate: root.can-curate; is-admin: root.is-admin;
                                is-channel: root.current-kind == "channel" || root.current-kind == "group";
                                topic-edit <=> root.topic-edit;
                                name-edit <=> root.name-edit;
                                archived: !root.can-write;
                                rename(n) => { root.rename-conv(n); }
                                archive-toggle => { root.archive-toggle(); }
                                open-admin => { root.open-admin-panel(); }
                                delete-conv => { root.delete-typed = ""; root.delete-open = true; }
                                add-people => { root.add-people(); }
                                remove-member(id, name) => { root.remove-person = id; root.remove-person-name = name; root.confirm = "remove-member"; }
                                save-topic(t) => { root.save-topic(t); }
                                open-file(f) => { root.open-file(f); }
                                open-pin(id, conv) => { root.info-open = false; root.row-clicked("pin", id, conv); }
                                open-link(u) => { root.open-link(u); }
                                add-bookmark => { root.bm-title = ""; root.bm-url = ""; root.bookmark-open = true; }
                                home-action(k, id) => { root.home-action(k, id); }
                                open-members-of(x) => { root.open-details("members"); }
                            }
                        }
                    }


                }
                    // ---- people picker (New message, Add people) ----
                    if root.pp-open: ModalCard {
                        title: root.pp-mode == "add-people" ? "Add people to " + root.current-title : (root.pp-mode == "directory" ? "People directory" : (root.pp-mode == "channels" ? "Channel browser" : "New message"));
                        wide: root.wide;
                        ok-text: root.pp-mode == "add-people" ? (root.pp-count > 0 ? "Add " + root.pp-count : "Add") : "";
                        ok-enabled: root.pp-count > 0;
                        ok => { root.pp-confirm(); }
                        dismiss => { root.pp-open = false; }
                        if root.pp-mode == "new-message" && root.is-admin: SheetRow { icon: "hash"; text: "New channel"; clicked => { root.pp-open = false; root.new-channel-name = ""; root.new-channel-open = true; } }
                        PeoplePicker {
                            people: root.pp-list;
                            query <=> root.pp-text;
                            single: root.pp-mode != "add-people";
                            hint: root.pp-mode == "add-people" ? "Search people to add" : (root.pp-mode == "channels" ? "Search your channels" : "Search people");
                            empty-text: root.pp-mode == "add-people" ? "Everyone is already here." : (root.pp-mode == "channels" ? "You are not in any channels yet. An admin adds people to channels." : "No people found.");
                            filter(t) => { root.pp-filter(t); }
                            toggle(id) => { root.pp-toggle(id); }
                        }
                    }

                    // ---- labels: choose labels for a saved message, or manage them all ----
                    if root.label-open: ModalCard {
                        title: root.label-msg == "" ? "Labels" : "Add label";
                        wide: root.wide;
                        dismiss => { root.label-open = false; }
                        Text { text: root.label-msg == "" ? "Labels are private to you. Rename, recolour or delete them here." : "Pick the labels for this saved message."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                        if root.labels.length == 0: Text { text: "No labels yet. Create one below."; font-size: Theme.fs; color: Theme.muted; }
                        for l[i] in root.labels: Rectangle {
                            height: max(48px, 40px * Theme.scale);
                            border-radius: Theme.r-sm;
                            background: lp.has-hover && root.label-msg != "" ? Theme.row-hover : transparent;
                            HorizontalLayout {
                                spacing: 10px;
                                padding-left: 8px;
                                padding-right: 8px;
                                Rectangle { width: 18px; height: 18px; y: (parent.height - self.height) / 2; border-radius: 9px; background: l.tint; }
                                if root.label-msg != "": Text { text: l.name; font-size: Theme.fs; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                if root.label-msg == "": LineEdit { text: l.name; font-size: Theme.fs; accepted(t) => { root.label-rename(l.id, t); } horizontal-stretch: 1; y: (parent.height - self.height) / 2; }
                                if root.label-msg != "": Rectangle { width: 24px; height: 24px; y: (parent.height - self.height) / 2; border-radius: 6px; border-width: l.on ? 0px : 2px; border-color: Theme.icon-soft; background: l.on ? Theme.accent : transparent;
                                    if l.on: Icon { name: "check"; size: 16px; tint: Theme.on-accent; weight: 2.5px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
                                if root.label-msg == "": ToolButton { icon: "palette"; label: "Change colour"; size: 40px; y: (parent.height - self.height) / 2; clicked => { root.label-recolor(l.id); } }
                                if root.label-msg == "": ToolButton { icon: "trash"; label: "Delete label " + l.name; tint: Theme.danger; size: 40px; y: (parent.height - self.height) / 2; clicked => { root.label-delete(l.id); } }
                            }
                            lp := TouchArea { enabled: root.label-msg != ""; clicked => { root.label-toggle(root.label-msg, l.id); } }
                        }
                        Text { text: "New label"; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 6px;
                            for c[i] in [#0dbd8b, #0467dd, #7b61ff, #e8590c, #d6336c, #868e96]: Rectangle {
                                width: 30px; height: 30px; border-radius: 15px; background: c; y: (parent.height - self.height) / 2;
                                border-width: root.label-new-color == i ? 3px : 0px; border-color: Theme.text;

                                TouchArea { clicked => { root.label-new-color = i; } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { text <=> root.label-new-name; placeholder-text: "Label name (up to 30 characters)"; font-size: Theme.fs; accepted(t) => { root.label-create(t, root.label-new-color); } }
                            PrimaryButton { text: "Create"; enabled: root.label-new-name != ""; clicked => { root.label-create(root.label-new-name, root.label-new-color); } }
                        }
                    }

                    // ---- keyboard shortcuts / help ----
                    if root.menu-kind == "help": ModalCard {
                        title: "Help and shortcuts";
                        wide: root.wide;
                        dismiss => { root.menu-kind = ""; }
                        for s in [{k: "Ctrl+K", d: "Jump to a conversation"}, {k: "Ctrl+F", d: "Search"}, {k: "Alt+Up / Alt+Down", d: "Previous or next conversation"}, {k: "Alt+Left / Alt+Right", d: "Back and forward"}, {k: "Esc", d: "Close the top panel, or return to Messages"}, {k: "Enter", d: "Send; Shift+Enter adds a new line"}, {k: "Up (empty box)", d: "Edit your last message"}, {k: "Ctrl+Shift+A", d: "Open Activity"}, {k: "Ctrl+,", d: "Preferences"}, {k: "Ctrl and + / - / 0", d: "Zoom"}]: HorizontalLayout {
                            spacing: 12px;
                            Text { text: s.k; font-size: Theme.fs; font-weight: 700; color: Theme.text; min-width: 150px; }
                            Text { text: s.d; font-size: Theme.fs; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.version-long; font-size: Theme.fs; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            GhostButton { text: "About SuperChat"; clicked => { root.menu-kind = ""; root.open-about(); } }
                        }
                    }
                    if root.menu-kind == "invite": ModalCard {
                        title: "Invite people";
                        wide: root.wide;
                        dismiss => { root.menu-kind = ""; }
                        Text { text: "SuperChat has no open sign-up. An admin creates each account in the admin panel and shares the one-time login link or QR code with the person."; font-size: Theme.fs; color: Theme.text; wrap: word-wrap; }
                        if root.is-admin: PrimaryButton { text: "Open the admin panel"; clicked => { root.menu-kind = ""; root.open-admin-panel(); } }
                        if !root.is-admin: Text { text: "Ask your admin to add the person."; font-size: Theme.fs; color: Theme.muted; }
                    }

                    // ---- conversation details modal (desktop): About, Members, Settings, Files, Pins ----
                    if root.info-open && root.current-conv != "" && root.wide: Rectangle {
                        background: Theme.scrim.with-alpha(0.5);
                        TouchArea { clicked => { root.info-open = false; } }
                        Rectangle {
                            width: min(700px * max(1.0, Theme.scale * 0.9), parent.width - 48px);
                            height: min(580px * max(1.0, Theme.scale * 0.9), parent.height - 48px);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: Theme.sheet-bg;
                            border-radius: Theme.r-lg;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: #00000066;
                            TouchArea { }
                            VerticalLayout {
                                HorizontalLayout {
                                    height: max(60px, 48px * Theme.scale);
                                    padding-left: 20px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    if root.current-kind == "channel": Icon { name: root.is-conv-locked(root.current-conv) ? "lock" : "hash"; size: 22px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                                    Text { text: root.current-title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    ToolButton { icon: "close"; label: "Close details"; size: 36px * Theme.scale; y: (parent.height - self.height) / 2; clicked => { root.info-open = false; } }
                                }
                                TabBar {
                                    tabs: root.is-bot-dm ? ["About", "Members " + root.member-count, "Settings", "Files", "Pins", "Home"] : ["About", "Members " + root.member-count, "Settings", "Files", "Pins"];
                                    current: root.info-page == "members" ? 1 : (root.info-page == "settings" ? 2 : (root.info-page == "files" ? 3 : (root.info-page == "pins" ? 4 : (root.info-page == "home" ? 5 : 0))));
                                    picked(i) => { root.open-details(i == 0 ? "about" : (i == 1 ? "members" : (i == 2 ? "settings" : (i == 3 ? "files" : (i == 4 ? "pins" : "home"))))); }
                                }
                                DetailsView {
                                    vertical-stretch: 1;
                                    page: root.info-page == "" ? "about" : root.info-page;
                                    title: root.current-title; kind: root.current-kind; topic: root.current-topic; created: root.current-created;
                                    member-count: root.member-count; members: root.members; files: root.files; pins: root.pins; bookmarks: root.bookmarks; home: root.home;
                                    can-manage: root.can-manage; can-curate: root.can-curate; is-admin: root.is-admin;
                                    is-channel: root.current-kind == "channel" || root.current-kind == "group";
                                    muted: root.current-muted; notify-text: root.current-notify; lock-set: root.lock-set; locked: root.is-conv-locked(root.current-conv); favourite: root.current-fav;
                                    avatar-key: root.current-avatar-key; avatar-initials: root.current-initials; avatar-tint: root.current-color;
                                    topic-edit <=> root.topic-edit;
                                name-edit <=> root.name-edit;
                                archived: !root.can-write;
                                rename(n) => { root.rename-conv(n); }
                                archive-toggle => { root.archive-toggle(); }
                                open-admin => { root.open-admin-panel(); }
                                delete-conv => { root.delete-typed = ""; root.delete-open = true; }
                                    add-people => { root.add-people(); }
                                    remove-member(id, name) => { root.remove-person = id; root.remove-person-name = name; root.confirm = "remove-member"; }
                                    save-topic(t) => { root.save-topic(t); }
                                    open-file(f) => { root.open-file(f); }
                                    open-pin(id, conv) => { root.info-open = false; root.row-clicked("pin", id, conv); }
                                    open-link(u) => { root.open-link(u); }
                                    add-bookmark => { root.bm-title = ""; root.bm-url = ""; root.bookmark-open = true; }
                                    mute => { root.menu-conv = root.current-conv; root.menu-kind = "mute"; }
                                    notify => { root.menu-conv = root.current-conv; root.menu-kind = "notify"; }
                                    lock-toggle => { root.toggle-conv-lock(root.current-conv); }
                                    favourite-toggle => { root.toggle-fav(root.current-conv); }
                                    section => { root.menu-conv = root.current-conv; root.menu-kind = "section"; }
                                    mark-unread => { root.mark-unread(root.current-conv); root.info-open = false; }
                                    home-action(k, id) => { root.home-action(k, id); }
                                    open-members-of(x) => { root.open-details("members"); }
                                    avatar-tap => { root.menu-kind = "avatar-photo"; }
                                }
                            }
                        }
                    }

                // ======================= menus and sheets (popovers on desktop, bottom sheets on phones) =======================
                // ---- server menu (the server name in the sidebar) ----
                if root.menu-kind == "server": BottomSheet {
                    title: root.server-name; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 300px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "settings"; text: "Preferences"; clicked => { root.menu-kind = ""; root.open-settings(); } }
                    if root.is-admin: SheetRow { icon: "hash"; text: "Create channel"; clicked => { root.menu-kind = ""; root.new-channel-name = ""; root.new-channel-open = true; } }
                    SheetRow { icon: "user-plus"; text: "Invite people"; clicked => { root.menu-kind = "invite"; } }
                    if root.is-admin: SheetRow { icon: "shield"; text: "Admin panel"; clicked => { root.menu-kind = ""; root.open-admin-panel(); } }
                    SheetRow { icon: "thread"; text: "Threads"; clicked => { root.menu-kind = ""; root.open-threads(); } }
                    SheetRow { icon: "file"; text: "Files"; clicked => { root.menu-kind = ""; root.open-files(); } }
                    SheetRow { icon: "clock"; text: root.scheduled-count > 0 ? "Drafts & sent (" + root.scheduled-count + " scheduled)" : "Drafts & sent"; clicked => { root.menu-kind = ""; root.open-drafts(); } }
                    SheetRow { icon: "sort"; text: "Sort conversations"; detail: root.sort-alpha ? "A-Z" : "Activity"; chevron: true; clicked => { root.menu-kind = "sort"; } }
                    SheetRow { icon: "mail"; text: "Unread only"; checked: root.unread-only; clicked => { root.unread-only = !root.unread-only; root.setting-changed("sort"); root.menu-kind = ""; } }
                    SheetRow { icon: "bell-off"; text: "Hide muted"; checked: root.hide-muted; clicked => { root.hide-muted = !root.hide-muted; root.setting-changed("sort"); root.menu-kind = ""; } }
                    SheetRow { icon: "sort"; text: "Reset the sidebar order"; clicked => { root.reset-order(); root.menu-kind = ""; } }
                    if root.lock-set: SheetRow { icon: root.lock-engaged ? "lock" : "unlock"; text: root.lock-engaged ? "Unlock" : "Lock"; clicked => { root.menu-kind = ""; root.lock-tapped(); } }
                }
                // ---- phone: the 3-dot menu of the DMs and Channels tabs ----
                if root.menu-kind == "overflow": BottomSheet {
                    title: ""; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "thread"; text: "Threads"; clicked => { root.menu-kind = ""; root.open-threads(); } }
                    SheetRow { icon: "clock"; text: "Drafts & sent"; detail: root.scheduled-count > 0 ? root.scheduled-count + " scheduled" : ""; clicked => { root.menu-kind = ""; root.open-drafts(); } }
                    SheetRow { icon: "bookmark"; text: "Later"; detail: root.saved-rows.length > 0 ? "" + root.saved-rows.length : ""; clicked => { root.menu-kind = ""; root.go-home-tab("later"); } }
                    if root.lock-set: SheetRow { icon: root.lock-engaged ? "lock" : "unlock"; text: root.lock-engaged ? "Unlock" : "Lock"; clicked => { root.menu-kind = ""; root.lock-tapped(); } }
                    MenuLabel { text: "Sort"; }
                    ChoiceRow { radio: true; text: "Recent"; on: !root.sort-alpha; clicked => { root.sort-alpha = false; root.setting-changed("sort"); } }
                    ChoiceRow { radio: true; text: "Name (A–Z)"; on: root.sort-alpha; clicked => { root.sort-alpha = true; root.setting-changed("sort"); } }
                    MenuLabel { text: "Filter"; }
                    ChoiceRow { text: "Unread only"; on: root.unread-only; clicked => { root.unread-only = !root.unread-only; root.setting-changed("sort"); } }
                    ChoiceRow { text: "Hide muted"; on: root.hide-muted; clicked => { root.hide-muted = !root.hide-muted; root.setting-changed("sort"); } }
                }
                if root.menu-kind == "sort": BottomSheet {
                    title: "Sort conversations by"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; icon: "clock"; text: "Latest activity"; checked: !root.sort-alpha; clicked => { root.sort-alpha = false; root.setting-changed("sort"); root.menu-kind = ""; } }
                    SheetRow { radio: true; icon: "sort"; text: "Name (A-Z)"; checked: root.sort-alpha; clicked => { root.sort-alpha = true; root.setting-changed("sort"); root.menu-kind = ""; } }
                }

                // ---- profile menu (your avatar at the bottom of the rail) ----
                if root.menu-kind == "profile": BottomSheet {
                    title: root.me-name; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; anchor-up: root.menu-up; menu-width: 300px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; icon: "check"; text: "Active"; checked: root.presence-pref == "auto"; clicked => { root.set-presence("auto"); root.menu-kind = ""; } }
                    SheetRow { radio: true; icon: "clock"; text: "Set yourself as away"; checked: root.presence-pref == "away"; clicked => { root.set-presence("away"); root.menu-kind = ""; } }
                    SheetRow { icon: "bell-off"; text: "Pause notifications"; detail: root.presence-pref == "dnd" ? "On" : ""; checked: root.presence-pref == "dnd"; clicked => { root.set-presence(root.presence-pref == "dnd" ? "auto" : "dnd"); root.menu-kind = ""; } }
                    SheetRow { icon: "person"; text: "Profile"; clicked => { root.menu-kind = ""; root.open-settings(); root.settings-page = "account"; } }
                    SheetRow { icon: "settings"; text: "Preferences"; clicked => { root.menu-kind = ""; root.open-settings(); } }
                    SheetRow { icon: "lock"; text: "App Lock"; clicked => { root.menu-kind = ""; root.open-settings(); root.settings-page = "lock"; } }
                    if root.sign-out-allowed: SheetRow { icon: "logout"; text: "Sign out"; danger: true; clicked => { root.menu-kind = ""; root.confirm = "signout"; } }
                }

                // ---- More (rail): a popover next to the rail ----
                if root.menu-kind == "more": BottomSheet {
                    title: "More"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; anchor-up: root.menu-up; menu-width: 300px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "file"; text: "Files"; clicked => { root.menu-kind = ""; root.open-files(); } }
                    SheetRow { icon: "thread"; text: "Threads"; clicked => { root.menu-kind = ""; root.open-threads(); } }
                    SheetRow { icon: "clock"; text: "Drafts & sent"; detail: root.scheduled-count > 0 ? root.scheduled-count + " scheduled" : ""; clicked => { root.menu-kind = ""; root.open-drafts(); } }
                    SheetRow { icon: "bookmark"; text: "Saved items (Later)"; detail: root.saved-rows.length > 0 ? "" + root.saved-rows.length : ""; clicked => { root.menu-kind = ""; root.go-home-tab("later"); } }
                    if root.lock-set: SheetRow { icon: root.lock-engaged ? "lock" : "unlock"; text: root.lock-engaged ? "Unlock" : "Lock"; clicked => { root.menu-kind = ""; root.lock-tapped(); } }
                    MenuDivider { }
                    SheetRow { icon: "users"; text: "People directory"; clicked => { root.menu-kind = ""; root.open-directory("directory"); } }
                    SheetRow { icon: "hash"; text: "Channel browser"; clicked => { root.menu-kind = ""; root.open-directory("channels"); } }
                    MenuDivider { }
                    SheetRow { icon: "settings"; text: "Preferences"; clicked => { root.menu-kind = ""; root.open-settings(); } }
                    if root.is-admin: SheetRow { icon: "shield"; text: "Admin panel"; clicked => { root.menu-kind = ""; root.open-admin-panel(); } }
                    SheetRow { icon: "help"; text: "Help and keyboard shortcuts"; clicked => { root.menu-kind = "help"; } }
                    SheetRow { icon: "info"; text: "About SuperChat"; detail: root.upd-banner ? "Update available" : root.version; clicked => { root.menu-kind = ""; root.open-about(); } }
                }

                // ---- conversation context menu (right click / long press / hover button) ----
                if root.menu-kind == "conv": BottomSheet {
                    title: root.menu-title; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 300px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "mark-read"; text: "Mark as read"; clicked => { root.mark-read(root.menu-conv); root.menu-kind = ""; } }
                    SheetRow { icon: "mail"; text: "Mark as unread"; clicked => { root.mark-unread(root.menu-conv); root.menu-kind = ""; } }
                    if root.wide: SheetRow { icon: "star"; text: root.menu-fav ? "Remove from favourites" : "Star (add to favourites)"; clicked => { root.toggle-fav(root.menu-conv); root.menu-kind = ""; } }
                    if !root.wide: SheetRow { icon: "pin"; text: root.menu-fav ? "Unpin" : "Pin to top"; clicked => { root.pin-toggle(root.menu-conv); root.menu-kind = ""; } }
                    if !root.wide && root.menu-fav: SheetRow { icon: "arrow-up"; text: "Move up"; clicked => { root.move-pinned(root.menu-conv, -1); root.menu-kind = ""; } }
                    if !root.wide && root.menu-fav: SheetRow { icon: "arrow-down"; text: "Move down"; clicked => { root.move-pinned(root.menu-conv, 1); root.menu-kind = ""; } }
                    SheetRow { icon: "bell-off"; text: "Mute"; chevron: true; clicked => { root.menu-kind = "mute"; } }
                    SheetRow { icon: "bell"; text: "Notify me about"; chevron: true; clicked => { root.menu-kind = "notify"; } }
                    SheetRow { icon: "speaker"; text: "Notification sound"; chevron: true; clicked => { root.menu-kind = "sound"; } }
                    if root.wide: SheetRow { icon: "hash"; text: "Move to section"; chevron: true; clicked => { root.menu-kind = "section"; } }
                    if root.wide: SheetRow { icon: "arrow-up"; text: "Move up in the list"; clicked => { root.move-row(root.menu-conv, -1); root.menu-kind = ""; } }
                    if root.wide: SheetRow { icon: "arrow-down"; text: "Move down in the list"; clicked => { root.move-row(root.menu-conv, 1); root.menu-kind = ""; } }
                    SheetRow { icon: "lock"; text: root.lock-set ? (root.is-conv-locked(root.menu-conv) ? "Unlock chat (keep visible)" : "Lock chat") : "Set up App Lock…"; clicked => { root.menu-kind = ""; root.toggle-conv-lock(root.menu-conv); } }
                    SheetRow { icon: "info"; text: "View details"; clicked => { root.menu-kind = ""; root.select-conv(root.menu-conv); root.show-chat = true; root.open-details(root.wide ? "about" : ""); } }
                }
                if root.menu-kind == "mute": BottomSheet {
                    title: "Mute notifications"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "clock"; text: "For 1 hour"; clicked => { root.mute(root.menu-conv, "1h"); root.menu-kind = ""; } }
                    SheetRow { icon: "clock"; text: "For 8 hours"; clicked => { root.mute(root.menu-conv, "8h"); root.menu-kind = ""; } }
                    SheetRow { icon: "calendar"; text: "Until tomorrow"; clicked => { root.mute(root.menu-conv, "tomorrow"); root.menu-kind = ""; } }
                    SheetRow { icon: "bell-off"; text: "Forever"; clicked => { root.mute(root.menu-conv, "forever"); root.menu-kind = ""; } }
                    SheetRow { icon: "bell"; text: "Unmute"; clicked => { root.mute(root.menu-conv, "off"); root.menu-kind = ""; } }
                }
                if root.menu-kind == "spell": BottomSheet {
                    title: "Spelling: " + root.spell-word; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 260px;
                    dismiss => { root.menu-kind = ""; }
                    for s[i] in root.spell-menu: SheetRow { icon: "edit"; text: s; clicked => { root.spell-pick(i); root.menu-kind = ""; } }
                    if root.spell-menu.length == 0: SheetRow { icon: "info"; text: "No suggestions"; }
                    SheetRow { icon: "plus"; text: "Add to dictionary"; clicked => { root.spell-add(); root.menu-kind = ""; } }
                    SheetRow { icon: "eye-off"; text: "Ignore for now"; clicked => { root.spell-ignore(); root.menu-kind = ""; } }
                }
                if root.menu-kind == "secmenu": BottomSheet {
                    title: root.menu-title; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 260px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "arrow-up"; text: "Move section up"; clicked => { root.move-row(root.menu-conv, -1); root.menu-kind = ""; } }
                    SheetRow { icon: "arrow-down"; text: "Move section down"; clicked => { root.move-row(root.menu-conv, 1); root.menu-kind = ""; } }
                    SheetRow { icon: "sort"; text: "Reset the sidebar order"; clicked => { root.reset-order(); root.menu-kind = ""; } }
                }
                if root.menu-kind == "notify": BottomSheet {
                    title: "Notify me about"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; checked: root.menu-conv == root.current-conv && root.current-notify == "All messages"; icon: "bell"; text: "All messages"; clicked => { root.notify-level(root.menu-conv, "all"); root.menu-kind = ""; } }
                    SheetRow { radio: true; checked: root.menu-conv == root.current-conv && root.current-notify == "Mentions only"; icon: "person"; text: "Mentions only"; clicked => { root.notify-level(root.menu-conv, "mentions"); root.menu-kind = ""; } }
                    SheetRow { radio: true; checked: root.menu-conv == root.current-conv && root.current-notify == "Nothing"; icon: "bell-off"; text: "Nothing"; clicked => { root.notify-level(root.menu-conv, "nothing"); root.menu-kind = ""; } }
                    SheetRow { icon: "speaker"; text: "Notification sound"; chevron: true; clicked => { root.menu-kind = "sound"; } }
                }
                if root.menu-kind == "sound": BottomSheet {
                    title: root.menu-conv == "" ? "Default sound" : "Notification sound"; wide: root.wide; menu: root.menu-conv != ""; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 260px;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; icon: "speaker"; text: root.menu-conv == "" ? "System default" : "Use the default"; checked: root.sound-of(root.menu-conv) == "default"; clicked => { root.set-sound(root.menu-conv, "default"); } }
                    SheetRow { radio: true; icon: "bell"; text: "Chime"; checked: root.sound-of(root.menu-conv) == "chime"; clicked => { root.set-sound(root.menu-conv, "chime"); } }
                    SheetRow { radio: true; icon: "bell"; text: "Pop"; checked: root.sound-of(root.menu-conv) == "pop"; clicked => { root.set-sound(root.menu-conv, "pop"); } }
                    SheetRow { radio: true; icon: "bell"; text: "Knock"; checked: root.sound-of(root.menu-conv) == "knock"; clicked => { root.set-sound(root.menu-conv, "knock"); } }
                    SheetRow { radio: true; icon: "bell"; text: "Bell"; checked: root.sound-of(root.menu-conv) == "bell"; clicked => { root.set-sound(root.menu-conv, "bell"); } }
                    SheetRow { radio: true; icon: "bell-off"; text: "Silent"; checked: root.sound-of(root.menu-conv) == "none"; clicked => { root.set-sound(root.menu-conv, "none"); } }
                }
                if root.menu-kind == "section": BottomSheet {
                    title: "Move to section"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "hash"; text: "No section"; clicked => { root.set-section(root.menu-conv, ""); root.menu-kind = ""; } }
                    for s in root.sections: SheetRow { icon: "hash"; text: s.title; clicked => { root.set-section(root.menu-conv, s.id); root.menu-kind = ""; } }
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding: 8px; padding-left: 20px; spacing: 8px;
                        LineEdit { text <=> root.new-section-name; placeholder-text: "New section name"; font-size: Theme.fs; accepted(t) => { root.new-section(t); root.set-section(root.menu-conv, ""); root.new-section-name = ""; root.menu-kind = ""; } }
                        GhostButton { text: "Create"; clicked => { root.new-section(root.new-section-name); root.new-section-name = ""; root.menu-kind = ""; } }
                    }
                }

                // ---- forward / share ----
                if root.menu-kind == "forward" || root.menu-kind == "share": BottomSheet {
                    title: root.menu-kind == "forward" ? "Forward to" : "Share to"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    if root.menu-kind == "share" && root.share-text != "": Text { x: 20px; width: parent.width - 40px; text: root.share-text; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; overflow: elide; }
                    if root.menu-kind == "share": Rectangle {
                        height: max(52px, 42px * Theme.scale);
                        LineEdit { x: 16px; width: parent.width - 32px; text <=> root.share-caption; placeholder-text: "Add a message (optional)"; font-size: Theme.fs; }
                    }
                    for c in root.share-list: Rectangle {
                        height: 56px * Theme.scale;
                        background: fw.pressed ? Theme.bubble-other : (fw.has-hover ? Theme.row-hover : transparent);
                        HorizontalLayout {
                            padding-left: 20px; spacing: 14px;
                            Avatar { initials: c.initials; tint: c.color; size: 36px * Theme.scale; y: (parent.height - self.height) / 2; }
                            Text { text: c.name; font-size: Theme.fs; vertical-alignment: center; overflow: elide; color: Theme.text; }
                        }
                        fw := TouchArea { clicked => { root.forward-to(root.menu-msg, c.id); root.menu-kind = ""; } }
                    }
                }

                // ---- message actions: quick reactions on top ----
                if root.menu-kind == "msg": BottomSheet {
                    wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; menu-width: 350px;
                    dismiss => { root.menu-kind = ""; }
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 4px; alignment: center;
                            for e in root.quick-emoji: Rectangle {
                                width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 20px;
                                background: qa.pressed ? Theme.bubble-other : Theme.surface;

                                if e.has-img: Image { source: e.img; width: 24px; height: 24px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                if !e.has-img: Text { text: e.ch; font-size: 20px; }
                                qa := TouchArea { clicked => { root.react(root.menu-msg, e.ch); root.menu-kind = ""; } }
                            }
                            Rectangle {
                                width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 20px; background: Theme.surface;

                                Icon { name: "emoji"; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                TouchArea { clicked => { root.picker-target = root.menu-msg; root.menu-kind = "emoji"; } }
                            }
                        }
                    }
                    if !root.sel-in-thread: SheetRow { icon: "thread"; text: "Reply in thread"; clicked => { root.menu-kind = ""; root.open-thread(root.menu-msg); } }
                    if !root.sel-in-thread: SheetRow { icon: "reply"; text: "Quote reply"; clicked => { root.menu-kind = ""; root.quote-reply(root.menu-msg); } }
                    SheetRow { icon: "forward"; text: "Forward"; clicked => { root.menu-kind = "forward"; } }
                    SheetRow { icon: "bookmark"; text: root.sel-msg.saved ? "Remove from saved items" : "Save for later"; clicked => { root.save-msg(root.menu-msg); root.menu-kind = ""; } }
                    SheetRow { icon: "tag"; text: "Add label..."; clicked => { root.menu-kind = ""; root.label-picker(root.menu-msg); } }
                    SheetRow { icon: "copy"; text: "Copy text"; clicked => { root.copy-text(root.menu-msg); root.menu-kind = ""; } }
                    SheetRow { icon: "link"; text: "Copy link"; clicked => { root.copy-link(root.menu-msg); root.menu-kind = ""; } }
                    if root.sel-msg.can-pin && !root.sel-in-thread: SheetRow { icon: "pin"; text: root.sel-msg.pinned ? "Unpin" : "Pin to conversation"; clicked => { root.pin(root.menu-msg); root.menu-kind = ""; } }
                    SheetRow { icon: "mail"; text: "Mark unread"; clicked => { root.mark-unread(root.current-conv); root.menu-kind = ""; } }
                    if root.sel-msg.can-edit: SheetRow { icon: "edit"; text: "Edit message"; clicked => { root.menu-kind = ""; root.start-edit(root.menu-msg); } }
                    if root.sel-msg.mine: SheetRow { icon: "trash"; text: "Delete message"; danger: true; clicked => { root.menu-kind = ""; root.confirm = "delete-msg"; } }
                }

                // ---- attach ----
                if root.menu-kind == "attach": BottomSheet {
                    title: "Attach"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y; anchor-up: root.menu-up;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "file"; text: "File"; clicked => { root.menu-kind = ""; if root.is-android { root.pick-media("files"); } else { root.attach-open = true; root.browse-file(); } } }
                    if root.is-android: SheetRow { icon: "image"; text: "Photo or video"; clicked => { root.menu-kind = ""; root.pick-media("gallery"); } }
                    if !root.is-android: SheetRow { icon: "video"; text: "Upload video"; clicked => { root.menu-kind = ""; root.attach-open = true; root.browse-video(); } }
                    if !root.is-android && root.can-screen-record: SheetRow { icon: "video"; text: root.screen-rec-text != "" ? "Stop screen recording" : "Record screen"; clicked => { root.menu-kind = ""; root.screen-record-toggle(); } }
                    if !root.is-android: SheetRow { icon: "image"; text: "Paste image or file from clipboard"; clicked => { root.menu-kind = ""; root.paste-image(); } }
                    if root.is-android: SheetRow { icon: "image"; text: "Paste image from clipboard"; clicked => { root.menu-kind = ""; root.paste-image(); } }
                    if root.can-record: SheetRow { icon: "mic"; text: root.recording ? "Stop recording" : "Voice message"; clicked => { root.menu-kind = ""; root.record-toggle(); } }
                    SheetRow { icon: "clock"; text: "Schedule send"; clicked => { root.menu-kind = ""; root.schedule-error = ""; root.schedule-when = ""; root.schedule-open = true; } }
                }

                // ---- emoji ----
                if root.menu-kind == "emoji": BottomSheet {
                    title: root.picker-target == "" ? "Insert emoji" : "React"; wide: root.wide; menu: root.picker-target == ""; anchor-x: root.menu-x; anchor-y: root.menu-y; anchor-up: root.menu-up; menu-width: 360px;
                    dismiss => { root.menu-kind = ""; }
                    grid := Rectangle {
                        property <length> cell: 46px * Theme.scale;
                        property <int> cols: max(5, floor((self.width - 8px) / self.cell));
                        height: min(root.height * 0.45, 300px);
                        ScrollView {
                            content-height: (floor(root.emoji-list.length / grid.cols) + 1) * grid.cell;
                            for e[i] in root.emoji-list: Rectangle {
                                x: 4px + mod(i, grid.cols) * grid.cell;
                                y: floor(i / grid.cols) * grid.cell;
                                width: grid.cell;
                                height: grid.cell;
                                background: ea.pressed ? Theme.bubble-other : (ea.has-hover ? Theme.row-hover : transparent);
                                if e.has-img: Image { source: e.img; width: 28px * Theme.scale; height: 28px * Theme.scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                if !e.has-img: Text { text: e.ch; font-size: 24px * Theme.scale; }
                                ea := TouchArea { clicked => { root.emoji-picked(e.ch); root.menu-kind = ""; } }
                            }
                        }
                    }
                }

                // ---- settings pickers ----
                if root.menu-kind == "pick-theme": BottomSheet {
                    title: "Theme"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; text: "System default"; checked: root.theme-mode == 0; clicked => { root.theme-mode = 0; root.setting-changed("theme"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "Light"; checked: root.theme-mode == 1; clicked => { root.theme-mode = 1; root.setting-changed("theme"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "Dark"; checked: root.theme-mode == 2; clicked => { root.theme-mode = 2; root.setting-changed("theme"); root.menu-kind = ""; } }
                }
                if root.menu-kind == "pick-text": BottomSheet {
                    title: "Text size"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; text: "Regular"; checked: root.font-step == 0; clicked => { root.font-step = 0; root.setting-changed("font"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "Large"; checked: root.font-step == 1; clicked => { root.font-step = 1; root.setting-changed("font"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "Extra large"; checked: root.font-step == 2; clicked => { root.font-step = 2; root.setting-changed("font"); root.menu-kind = ""; } }
                }
                if root.menu-kind == "pick-spell": BottomSheet {
                    title: "Spelling language"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    for l[i] in root.spell-langs: SheetRow { radio: true; text: l; checked: l == root.spell-lang-label; clicked => { root.spell-lang-pick(i); root.menu-kind = ""; } }
                }
                if root.menu-kind == "pick-push": BottomSheet {
                    title: "Push method"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; text: "Off"; checked: root.push-choice == "none"; clicked => { root.push-choice = "none"; root.setting-changed("push"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "ntfy"; checked: root.push-choice == "ntfy"; clicked => { root.push-choice = "ntfy"; root.setting-changed("push"); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "Google (FCM)"; checked: root.push-choice == "fcm"; clicked => { root.push-choice = "fcm"; root.setting-changed("push"); root.menu-kind = ""; } }
                }
                if root.menu-kind == "pick-status": BottomSheet {
                    title: "Status"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; icon: "check"; text: "Active"; checked: root.presence-pref == "auto"; clicked => { root.set-presence("auto"); root.menu-kind = ""; } }
                    SheetRow { radio: true; icon: "clock"; text: "Away"; checked: root.presence-pref == "away"; clicked => { root.set-presence("away"); root.menu-kind = ""; } }
                    SheetRow { icon: "bell-off"; text: "Do not disturb (pause notifications)"; checked: root.presence-pref == "dnd"; clicked => { root.set-presence("dnd"); root.menu-kind = ""; } }
                }
                // ---- App Lock: add a conversation to the locked list ----
                // ---- picture of a person, group or channel (1.4.1) ----
                if root.menu-kind == "avatar-photo": BottomSheet {
                    title: "Photo"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    if root.current-kind == "self": SheetRow { icon: "camera"; text: "Change my profile photo"; clicked => { root.menu-kind = ""; root.choose-avatar(); } }
                    if root.current-has-pic: SheetRow { icon: "image"; text: "View photo"; clicked => { root.menu-kind = ""; root.avatar-action("view"); } }
                    if root.current-kind != "self": SheetRow { icon: "camera"; text: "Set custom photo for me"; clicked => { root.menu-kind = ""; root.avatar-action("set-private"); } }
                    if root.current-has-override: SheetRow { icon: "close"; text: "Remove custom photo"; clicked => { root.menu-kind = ""; root.avatar-action("clear-private"); } }
                    if root.can-set-pic: SheetRow { icon: "users"; text: "Set channel photo for everyone"; clicked => { root.menu-kind = ""; root.avatar-action("set-public"); } }
                    if root.can-set-pic && root.current-has-public: SheetRow { icon: "trash"; text: "Remove channel photo for everyone"; danger: true; clicked => { root.menu-kind = ""; root.avatar-action("clear-public"); } }
                    Text { x: 20px; width: parent.width - 40px; text: "A custom photo is private: only you see it, on all your devices."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                }
                if root.menu-kind == "pick-lock-timeout": BottomSheet {
                    title: "Auto-lock"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { radio: true; text: "Immediately"; checked: root.lock-timeout == 0; clicked => { root.lock-timeout-pick(0); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "After 1 minute"; checked: root.lock-timeout == 1; clicked => { root.lock-timeout-pick(1); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "After 5 minutes"; checked: root.lock-timeout == 5; clicked => { root.lock-timeout-pick(5); root.menu-kind = ""; } }
                    SheetRow { radio: true; text: "After 15 minutes"; checked: root.lock-timeout == 15; clicked => { root.lock-timeout-pick(15); root.menu-kind = ""; } }
                }
                if root.menu-kind == "lock-pick": BottomSheet {
                    title: "Lock a conversation"; wide: root.wide;
                    dismiss => { root.menu-kind = ""; }
                    if root.lockable-convs.length == 0: Text { x: 20px; text: "Every conversation is already locked."; font-size: Theme.fs; color: Theme.muted; }
                    for c in root.lockable-convs: SheetRow { icon: "lock"; text: c.title; clicked => { root.lock-add(c.id); root.menu-kind = ""; } }
                }

                // ---- search filters ----
                if root.menu-kind == "f-from": BottomSheet {
                    title: "From"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    for p in root.filter-people: SheetRow { icon: "person"; text: p.name; detail: p.sub; clicked => { root.search-filter("from", p.id); root.menu-kind = ""; } }
                }
                if root.menu-kind == "f-in": BottomSheet {
                    title: "In"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    for c in root.filter-chans: SheetRow { icon: "hash"; text: c.title; clicked => { root.search-filter("in", c.id); root.menu-kind = ""; } }
                }
                if root.menu-kind == "f-date": BottomSheet {
                    title: "Date"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "calendar"; text: "Today"; clicked => { root.search-filter("date", "today"); root.menu-kind = ""; } }
                    SheetRow { icon: "calendar"; text: "Yesterday"; clicked => { root.search-filter("date", "yesterday"); root.menu-kind = ""; } }
                    SheetRow { icon: "calendar"; text: "Last 7 days"; clicked => { root.search-filter("date", "7d"); root.menu-kind = ""; } }
                    SheetRow { icon: "calendar"; text: "Last 30 days"; clicked => { root.search-filter("date", "30d"); root.menu-kind = ""; } }
                }
                if root.menu-kind == "f-has": BottomSheet {
                    title: "Has"; wide: root.wide; menu: true; anchor-x: root.menu-x; anchor-y: root.menu-y;
                    dismiss => { root.menu-kind = ""; }
                    SheetRow { icon: "file"; text: "A file"; clicked => { root.search-filter("has", "file"); root.menu-kind = ""; } }
                    SheetRow { icon: "link"; text: "A link"; clicked => { root.search-filter("has", "link"); root.menu-kind = ""; } }
                    SheetRow { icon: "emoji"; text: "A reaction"; clicked => { root.search-filter("has", "reaction"); root.menu-kind = ""; } }
                }
                // ======================= dialogs =======================
                // ---- confirmations ----
                if root.confirm != "": AlertDialog {
                    title: root.confirm == "remove-member" ? "Remove " + root.remove-person-name + "?" : root.confirm == "signout" ? "Sign out?" : (root.confirm == "signout-all" ? "Sign out of all devices?" : (root.confirm == "revoke-others" ? "Sign out other devices?" : (root.confirm == "delete-msg" ? "Delete this message?" : "Remove the PIN?")));
                    message: root.confirm == "remove-member" ? "They lose access to this conversation. You can add them again later." : root.confirm == "signout" ? "You will need to sign in again on this device." : (root.confirm == "signout-all" ? "Every device, including this one, is signed out and its local chats are removed." : (root.confirm == "revoke-others" ? "Every other device is signed out. This one stays signed in." : (root.confirm == "delete-msg" ? "This removes the message for everyone in the conversation." : "App Lock turns off and locked conversations become visible again.")));
                    ok-text: root.confirm == "remove-member" ? "Remove" : root.confirm == "delete-msg" ? "Delete" : (root.confirm == "remove-pin" ? "Remove" : "Sign out");
                    danger: true;
                    cancel => { root.confirm = ""; }
                    ok => {
                        if root.confirm == "signout" { root.screen = ""; root.sign-out(); }
                        if root.confirm == "signout-all" { root.screen = ""; root.sign-out-all(); }
                        if root.confirm == "revoke-others" { root.revoke-others(); }
                        if root.confirm == "delete-msg" { root.delete-msg(root.menu-msg); }
                        if root.confirm == "remove-member" { root.remove-member(root.remove-person); }
                        root.confirm = "";
                    }
                }

                // ---- certificate fingerprint (trust on first use) ----
                if root.tofu-open: ModalCard {
                    title: "Trust this server?"; wide: root.wide; ok-text: "Trust and sign in"; ok => { root.tofu-accept(); }
                    dismiss => { root.tofu-cancel(); }
                    Text { text: root.tofu-host + " uses a certificate that no public authority signed. If you trust this server, check that this fingerprint matches the one your administrator gave you."; wrap: word-wrap; font-size: Theme.fs; color: Theme.text; }
                    Rectangle {
                        background: Theme.surface;
                        border-radius: Theme.r-sm;
                        height: fpt.preferred-height + 16px;
                        fpt := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.tofu-fp; font-family: "monospace"; wrap: word-wrap; font-size: Theme.fs-small * 1.1; color: Theme.text; }
                    }
                }

                // ---- bot form ----
                if root.form-open: ModalCard {
                    title: root.form-title; wide: root.wide; ok-text: root.form-submit-label; ok => { root.form-submit(""); }
                    dismiss => { root.form-open = false; }
                    if root.form-desc != "": Text { text: root.form-desc; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                    for f[i] in root.form-fields: VerticalLayout {
                        spacing: 4px;
                        Text { text: f.label + (f.required ? " *" : ""); font-size: Theme.fs; font-weight: 700; wrap: word-wrap; color: Theme.text; }
                        if f.kind == 0: LineEdit { text: f.text; placeholder-text: f.placeholder; font-size: Theme.fs; edited(t) => { root.form-text(i, t); } }
                        if f.kind == 1: TextEdit { text: f.text; height: 90px * Theme.scale; font-size: Theme.fs; edited(t) => { root.form-text(i, t); } }
                        if f.kind == 2: SettingRow { icon: "settings"; badge: #64748b; title: f.placeholder != "" ? f.placeholder : "Yes"; has-switch: true; on: f.flag; divider: false; toggled => { root.form-toggle(i, ""); } }
                        if f.kind >= 3: VerticalLayout {
                            for o in f.options: Rectangle {
                                height: max(48px, 38px * Theme.scale);
                                background: oa.pressed ? Theme.bubble-other : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 22px; height: 22px; y: (parent.height - self.height) / 2; border-radius: f.kind == 3 ? 11px : 5px;
                                        border-width: 2px; border-color: o.on ? Theme.accent : Theme.icon-soft; background: o.on ? Theme.accent : transparent;
                                        if o.on: Icon { name: "check"; size: 16px; tint: Theme.on-accent; weight: 2.5px; x: (parent.width - self.width) / 2 - 2px; y: (parent.height - self.height) / 2 - 2px; }
                                    }
                                    Text { text: o.label; font-size: Theme.fs; vertical-alignment: center; horizontal-alignment: left; horizontal-stretch: 1; color: Theme.text; }
                                }
                                oa := TouchArea { clicked => { root.form-toggle(i, o.value); } }
                            }
                        }
                    }
                    if root.form-error != "": Text { text: root.form-error; color: Theme.danger; font-size: Theme.fs; wrap: word-wrap; }
                }

                // ---- schedule send ----
                if root.schedule-open: ModalCard {
                    title: "Schedule send"; wide: root.wide; ok-text: "Schedule"; ok => { root.schedule(root.schedule-when); }
                    dismiss => { root.schedule-open = false; }
                    Text { text: "The server sends the message at that time, even if this app is closed. See it under Drafts & sent."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                    SheetRow { icon: "clock"; text: "In 1 hour"; clicked => { root.schedule("1h"); } }
                    SheetRow { icon: "clock"; text: "In 3 hours"; clicked => { root.schedule("3h"); } }
                    SheetRow { icon: "calendar"; text: "Tomorrow 9:00 am"; clicked => { root.schedule("tomorrow"); } }
                    SheetRow { icon: "calendar"; text: "Monday 9:00 am"; clicked => { root.schedule("monday"); } }
                    LineEdit { text <=> root.schedule-when; placeholder-text: "Custom: dd/mm/yyyy hh:mm (24-hour)"; font-size: Theme.fs; accepted => { root.schedule(root.schedule-when); } }
                    if root.schedule-error != "": Text { text: root.schedule-error; color: Theme.danger; font-size: Theme.fs-small; wrap: word-wrap; }
                }

                // ---- add bookmark ----
                if root.bookmark-open: ModalCard {
                    title: "Add a bookmark"; wide: root.wide; ok-text: "Add"; ok => { root.add-bookmark(root.bm-title, root.bm-url); }
                    dismiss => { root.bookmark-open = false; }
                    LineEdit { text <=> root.bm-title; placeholder-text: "Title"; font-size: Theme.fs; }
                    LineEdit { text <=> root.bm-url; placeholder-text: "https://..."; font-size: Theme.fs; accepted => { root.add-bookmark(root.bm-title, root.bm-url); } }
                }

                // ---- delete channel (C-06): the name must be typed to confirm ----
                if root.delete-open: ModalCard {
                    title: root.current-kind == "channel" ? "Delete channel" : "Delete group chat"; wide: root.wide;
                    ok-text: "Delete forever"; ok-enabled: root.delete-typed == root.current-title;
                    ok => { root.delete-open = false; root.delete-channel(root.current-conv); }
                    dismiss => { root.delete-open = false; }
                    Text { text: "This permanently deletes " + root.current-title + ": every message, reaction, pin and uploaded file is removed for everyone, and it cannot be undone. Consider archiving it instead (it stays readable)."; font-size: Theme.fs; color: Theme.text; wrap: word-wrap; }
                    Text { text: "Type the name to confirm: " + root.current-title; font-size: Theme.fs-small; font-weight: 700; color: Theme.muted; wrap: word-wrap; }
                    LineEdit { text <=> root.delete-typed; placeholder-text: root.current-title; font-size: Theme.fs; }
                }

                // ---- new channel (admins) ----
                if root.new-channel-open: ModalCard {
                    title: "New channel"; wide: root.wide; ok-text: "Create"; ok => { root.create-channel(root.new-channel-name); }
                    dismiss => { root.new-channel-open = false; }
                    LineEdit { text <=> root.new-channel-name; placeholder-text: "Channel name"; font-size: Theme.fs; accepted => { root.create-channel(root.new-channel-name); } }
                }

                // M-31: while the screen is being recorded a red pill with the time and a Stop button sits at the top.
                if root.screen-rec-text != "": Rectangle {
                    x: root.wide ? root.rail-w + 12px : (root.width - self.width) / 2;
                    y: root.height - 52px;
                    width: 260px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.danger;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 6px; spacing: 10px;
                        Text { text: root.screen-rec-text; color: Theme.on-danger; font-size: Theme.fs; vertical-alignment: center; }
                        Rectangle {
                            width: 70px;
                            TouchArea { clicked => { root.screen-record-toggle(); } }
                            Rectangle { x: 0px; y: 5px; width: parent.width; height: parent.height - 10px; border-radius: 13px; background: #ffffff33; Text { text: "Stop"; color: Theme.on-danger; font-size: Theme.fs-small; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                    }
                }
                // E-05: a hidden copy of the message box text that is only used to measure where a word is drawn.
                probe-ti := TextInput {
                    x: 0px;
                    y: 0px;
                    width: root.probe-width;
                    height: 8px;
                    opacity: 0;
                    text: root.probe-text;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                    single-line: false;
                    read-only: true;
                    cursor-position-changed(p) => { root.probed(root.probe-off, p.x, p.y); }
                }
                if Drag.active: Rectangle {
                    x: min(max(Drag.x + 10px, 0px), parent.width - self.width - 4px);
                    y: Drag.y - self.height / 2;
                    width: gl.preferred-width + 24px;
                    height: 28px * Theme.scale;
                    background: Theme.surface;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.accent;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000040;
                    gl := Text { text: Drag.label; font-size: Theme.fs; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.toast != "": Rectangle {
                    y: parent.height - 96px;
                    height: tt2.preferred-height + 20px;
                    width: min(parent.width - 32px, tt2.preferred-width + (root.toast-undo ? 118px : 32px));
                    x: (parent.width - self.width) / 2;
                    background: Theme.text;
                    border-radius: Theme.r-md;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: root.toast-undo ? 6px : 16px; spacing: 8px;
                        tt2 := Text { text: root.toast; color: Theme.bg; font-size: Theme.fs; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        if root.toast-undo: Rectangle {
                            width: 72px;
                            Text { text: "Undo"; color: Theme.accent; font-size: Theme.fs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.toast-action(); } }
                        }
                    }
                }
            }
        }
    }
}

// The system tray icon (E-08): the app icon (with a red dot while there is anything unread), a tooltip with the count,
// and a menu with Open, Status, Pause notifications and Quit.
export component SuperChatTray inherits SystemTrayIcon {
    in property <int> unread: 0;
    in property <image> tray-icon: @image-url("assets/icon.png");
    in property <bool> paused: false;
    in property <string> status: "Active";
    callback open-app;
    callback quit-app;
    callback toggle-pause;
    callback set-status(string);
    icon: root.tray-icon;
    title: "SuperChat";
    clicked => { root.open-app(); }
    tooltip: (root.unread > 0 ? "SuperChat - " + root.unread + " unread" : "SuperChat") + (root.paused ? " (notifications paused)" : "");
    Menu {
        MenuItem { title: "Open SuperChat"; activated => { root.open-app(); } }
        MenuSeparator {}
        Menu {
            title: "Status: " + root.status;
            MenuItem { title: "Active (automatic)"; activated => { root.set-status("auto"); } }
            MenuItem { title: "Away"; activated => { root.set-status("away"); } }
            MenuItem { title: "Do not disturb"; activated => { root.set-status("dnd"); } }
        }
        MenuItem { title: root.paused ? "Resume notifications" : "Pause notifications"; activated => { root.toggle-pause(); } }
        MenuSeparator {}
        MenuItem { title: "Quit SuperChat"; activated => { root.quit-app(); } }
    }
}
