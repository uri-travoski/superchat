import { Palette } from "std-widgets.slint";
import { Theme, ConvItem, MsgItem, BlockItem, FileItem, ReactItem, RowItem, FormButtonItem } from "theme.slint";
import { Icon } from "icons.slint";
export { Icon }

export component Avatar {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 40px * Theme.scale;
    in property <int> presence: 0; // 0 none, 1 online, 2 away, 3 dnd
    width: size;
    height: size;
    Rectangle {
        border-radius: parent.width / 2;
        background: root.tint;
        Text {
            text: root.initials;
            color: white;
            font-size: root.size * 0.4;
            font-weight: 700;
        }
    }
    if root.presence > 0: Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: root.size * 0.3;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.bg;
        background: root.presence == 1 ? Theme.ok : (root.presence == 2 ? Theme.warn : Theme.danger);
    }
}

// A touch area that also reports a long press (450 ms without moving) and a right click.
export component PressArea inherits TouchArea {
    callback tapped;
    callback long-pressed;
    property <bool> fired: false;
    Timer {
        interval: 450ms;
        running: root.pressed && !root.fired && abs(root.mouse-x - root.pressed-x) < 12px && abs(root.mouse-y - root.pressed-y) < 12px;
        triggered => { root.fired = true; root.long-pressed(); }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.fired = false; }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right { root.long-pressed(); }
    }
    clicked => { if !root.fired { root.tapped(); } }
}

// Flat text button used for small actions.
export component Link {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> strong: false;
    in property <bool> enabled: true;
    callback clicked;
    min-height: 32px;
    min-width: lbl.preferred-width + 16px;
    accessible-role: button;
    accessible-label: root.text;
    lbl := Text {
        text: root.text;
        font-size: Theme.fs-small * 1.1;
        font-weight: root.strong ? 700 : 500;
        color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.accent-text);
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Pill {
    in property <string> text;
    in property <bool> on: false;
    callback clicked;
    height: 34px * Theme.scale;
    min-width: lbl.preferred-width + 24px;
    accessible-role: button;
    accessible-label: root.text;
    Rectangle {
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        background: root.on ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.bubble-other : transparent);
        lbl := Text {
            text: root.text;
            font-size: Theme.fs-small * 1.1;
            color: Theme.text;
        }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

export component PrimaryButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: max(44px, 34px * Theme.scale);
    min-width: lbl.preferred-width + 32px;
    accessible-role: button;
    accessible-label: root.text;
    Rectangle {
        border-radius: Theme.r-sm;
        background: root.enabled ? (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : Theme.surface-high;
        lbl := Text {
            text: root.text;
            color: root.enabled ? Theme.on-accent : Theme.muted;
            font-size: Theme.fs;
            font-weight: 600;
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component GhostButton {
    in property <string> text;
    in property <bool> on: false;
    in property <bool> danger: false;
    callback clicked;
    height: max(44px, 34px * Theme.scale);
    min-width: lbl.preferred-width + 28px;
    accessible-role: button;
    accessible-label: root.text;
    Rectangle {
        border-radius: Theme.r-sm;
        border-width: 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        background: root.on ? Theme.accent.with-alpha(0.15) : (ta.has-hover ? Theme.bubble-other : transparent);
        lbl := Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.fs;
        }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

// A borderless text button for dialog footers (Cancel / OK).
export component TextButton {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: max(48px, 38px * Theme.scale);
    min-width: max(64px, lbl.preferred-width + 24px);
    accessible-role: button;
    accessible-label: root.text;
    Rectangle {
        border-radius: Theme.r-sm;
        background: ta.has-hover ? Theme.bubble-other : transparent;
        lbl := Text {
            text: root.text;
            color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.accent-text);
            font-size: Theme.fs;
            font-weight: root.strong ? 700 : 500;
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component SectionHeader {
    in property <string> text;
    height: Theme.fs-small * 2.4;
    Text {
        x: 16px;
        text: root.text;
        font-size: Theme.fs-small;
        font-weight: 700;
        color: Theme.muted;
        vertical-alignment: bottom;
    }
}

// A 48dp round icon button.
export component IconButton {
    in property <string> icon;
    in property <string> label;
    in property <brush> tint: Theme.icon;
    in property <bool> enabled: true;
    in property <length> glyph: 24px;
    callback clicked;
    width: 48px;
    height: 48px;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.6) : transparent);
        Icon { name: root.icon; size: root.glyph; tint: root.enabled ? root.tint : Theme.muted.with-alpha(0.5); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Round floating action button.
export component Fab {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    width: 56px;
    height: 56px;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        border-radius: 28px;
        background: ta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000066;
        Icon { name: root.icon; size: 26px; tint: Theme.on-accent; weight: 2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

// Top app bar of a full-screen page: back arrow (or none), title, right-hand actions as children.
export component AppBar {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-back: true;
    in property <string> back-icon: "back";
    callback back;
    height: max(56px, 42px * Theme.scale);
    HorizontalLayout {
        padding-left: root.show-back ? 4px : 16px;
        padding-right: 4px;
        spacing: 4px;
        if root.show-back: IconButton { icon: root.back-icon; label: "Back"; clicked => { root.back(); } y: (parent.height - self.height) / 2; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; overflow: elide; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
        }
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// A row inside a sheet or menu: optional icon, label, optional detail, check mark.
export component SheetRow {
    in property <string> icon;
    in property <string> text;
    in property <string> detail;
    in property <bool> danger: false;
    in property <bool> checked: false;
    in property <bool> chevron: false;
    in property <bool> enabled: true;
    callback clicked;
    height: max(48px, 40px * Theme.scale);
    accessible-role: button;
    accessible-label: root.text;
    Rectangle {
        background: ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.5) : transparent);
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 16px;
            if root.icon != "": Icon { name: root.icon; tint: root.danger ? Theme.danger : Theme.icon; y: (parent.height - self.height) / 2; }
            Text { text: root.text; font-size: Theme.fs; color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.text); vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.detail != "": Text { text: root.detail; font-size: Theme.fs-small; color: Theme.muted; vertical-alignment: center; }
            if root.checked: Icon { name: "check"; tint: Theme.accent-text; y: (parent.height - self.height) / 2; }
            if root.chevron: Icon { name: "chevron-right"; tint: Theme.icon-soft; size: 20px; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

// A pill-shaped on/off control (no std-widgets Switch: it does not follow the accent or the soft dark theme).
export component Toggle {
    in-out property <bool> checked: false;
    callback toggled;
    width: 46px;
    height: 28px;
    accessible-role: switch;
    accessible-checked: root.checked;
    Rectangle {
        border-radius: 14px;
        background: root.checked ? Theme.accent : Theme.surface-high;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.icon-soft;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            y: 4px;
            x: root.checked ? parent.width - self.width - 5px : 5px;
            background: root.checked ? Theme.on-accent : Theme.icon-soft;
            animate x { duration: Theme.reduce-motion ? 0ms : 120ms; }
        }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

// Settings: a rounded card that holds rows.
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r-lg;
    clip: true;
    VerticalLayout {
        alignment: start;
        @children
    }
}

// Settings row: coloured round icon, title, optional summary, chevron or switch.
export component SettingRow {
    in property <string> icon;
    in property <color> badge: Theme.accent;
    in property <string> title;
    in property <string> summary;
    in property <bool> chevron: true;
    in property <bool> has-switch: false;
    in property <bool> danger: false;
    in-out property <bool> on: false;
    in property <bool> divider: true;
    callback clicked;
    callback toggled;
    height: max(60px, 46px * Theme.scale);
    accessible-role: button;
    accessible-label: root.title + (root.summary != "" ? ", " + root.summary : "");
    Rectangle {
        background: ta.pressed ? Theme.bubble-other : transparent;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 14px;
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: root.badge;
                Icon { name: root.icon; size: 20px; tint: white; weight: 2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { text: root.title; font-size: Theme.fs; color: root.danger ? Theme.danger : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.summary != "" && !root.has-switch: Text { text: root.summary; font-size: Theme.fs-small * 1.05; color: Theme.muted; vertical-alignment: center; overflow: elide; max-width: 190px * Theme.scale; }
            if root.has-switch: Toggle { checked: root.on; y: (parent.height - self.height) / 2; toggled => { root.on = self.checked; root.toggled(); } }
            if root.chevron && !root.has-switch: Icon { name: "chevron-right"; size: 20px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { clicked => { if root.has-switch { root.on = !root.on; root.toggled(); } else { root.clicked(); } } }
    }
    if root.divider: Rectangle { x: 66px; y: parent.height - 1px; height: 1px; width: parent.width - 66px; background: Theme.line; }
}

// A modal bottom sheet: scrim, rounded top corners, drag handle, tap outside or swipe down to close.
// On wide windows it is a centred card (or, with `menu`, a popover at the top right).
export component BottomSheet inherits Rectangle {
    in property <string> title;
    in property <bool> wide: false;
    in property <bool> menu: false;
    in property <length> inset-bottom: 0px;
    callback dismiss;
    property <bool> shown: false;
    property <length> drag: 0px;
    property <length> max-h: root.height * 0.94;
    init => { root.shown = true; }
    background: Theme.scrim.with-alpha(root.shown ? 0.5 : 0.0);
    animate background { duration: Theme.reduce-motion ? 0ms : 180ms; }
    TouchArea { clicked => { root.dismiss(); } }
    card := Rectangle {
        width: root.wide ? (root.menu ? 280px : 400px) : root.width;
        height: min(root.max-h, (root.wide ? 8px : 28px) + ttl.preferred-height + body.content-height + root.inset-bottom + 8px);
        x: root.wide ? (root.menu ? root.width - self.width - 12px : (root.width - self.width) / 2) : 0px;
        y: root.wide ? (root.menu ? 8px : max(12px, (root.height - self.height) / 2)) : (root.shown ? root.height - self.height + root.drag : root.height);
        background: Theme.sheet-bg;
        border-top-left-radius: Theme.r-sheet;
        border-top-right-radius: Theme.r-sheet;
        border-bottom-left-radius: root.wide ? Theme.r-md : 0px;
        border-bottom-right-radius: root.wide ? Theme.r-md : 0px;
        drop-shadow-blur: root.wide ? 18px : 0px;
        drop-shadow-color: #00000066;
        animate y { duration: Theme.reduce-motion || root.drag > 0px ? 0ms : 200ms; easing: ease-out; }
        TouchArea { }
        // Drag handle + title: swipe down here to dismiss.
        VerticalLayout {
            Rectangle {
                height: root.wide ? 8px : 28px;
                if !root.wide: Rectangle { width: 36px; height: 4px; border-radius: 2px; background: Theme.icon-soft.with-alpha(0.6); y: 10px; x: (parent.width - self.width) / 2; }
                TouchArea {
                    moved => { if !root.wide { root.drag = max(0px, self.mouse-y - self.pressed-y); } }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up { if root.drag > 70px { root.dismiss(); } root.drag = 0px; }
                    }
                }
            }
            ttl := Rectangle {
                height: root.title != "" ? max(36px, 28px * Theme.scale) : 0px;
                if root.title != "": Text { x: 20px; text: root.title; font-size: Theme.fs-small * 1.05; font-weight: 700; color: Theme.muted; vertical-alignment: center; overflow: elide; width: parent.width - 40px; }
            }
            body := Flickable {
                height: min(self.content-height, root.max-h - (root.wide ? 8px : 28px) - ttl.height - root.inset-bottom - 8px);
                content-height: inner.preferred-height;
                inner := VerticalLayout {
                    alignment: start;
                    @children
                }
            }
            Rectangle { height: root.inset-bottom + 8px; }
        }
    }
}

// A modal page-style card for forms: title, visible close X, scrolling body, sticky footer. A bottom sheet on phones.
export component ModalCard inherits Rectangle {
    in property <string> title;
    in property <string> ok-text;
    in property <bool> ok-enabled: true;
    callback ok;
    in property <bool> wide: false;
    in property <length> inset-bottom: 0px;
    callback dismiss;
    property <bool> shown: false;
    init => { root.shown = true; }
    background: Theme.scrim.with-alpha(0.55);
    TouchArea { clicked => { root.dismiss(); } }
    card := Rectangle {
        width: root.wide ? min(460px, root.width - 32px) : root.width;
        height: min(root.height - (root.wide ? 32px : 24px), 24px + ttl.height + body.content-height + ftr.preferred-height + root.inset-bottom + 8px);
        x: (root.width - self.width) / 2;
        y: root.wide ? (root.height - self.height) / 2 : root.height - self.height;
        background: Theme.sheet-bg;
        border-top-left-radius: root.wide ? Theme.r-lg : Theme.r-sheet;
        border-top-right-radius: root.wide ? Theme.r-lg : Theme.r-sheet;
        border-bottom-left-radius: root.wide ? Theme.r-lg : 0px;
        border-bottom-right-radius: root.wide ? Theme.r-lg : 0px;
        TouchArea { }
        VerticalLayout {
            ttl := HorizontalLayout {
                height: max(56px, 42px * Theme.scale);
                padding-left: 20px;
                padding-right: 4px;
                Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                IconButton { icon: "close"; label: "Close"; clicked => { root.dismiss(); } y: (parent.height - self.height) / 2; }
            }
            body := Flickable {
                height: min(self.content-height, root.height - 140px - root.inset-bottom);
                content-height: inner.preferred-height;
                inner := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    alignment: start;
                    @children
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            ftr := HorizontalLayout {
                padding: 10px;
                padding-left: 20px;
                padding-right: 16px;
                spacing: 8px;
                alignment: end;
                TextButton { text: "Cancel"; clicked => { root.dismiss(); } }
                if root.ok-text != "": PrimaryButton { text: root.ok-text; enabled: root.ok-enabled; clicked => { root.ok(); } }
            }
            Rectangle { height: root.inset-bottom; }
        }
    }
}

// A confirmation: title, message, two text buttons (Cancel / OK).
export component AlertDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> ok-text: "OK";
    in property <bool> danger: false;
    callback cancel;
    callback ok;
    background: Theme.scrim.with-alpha(0.55);
    TouchArea { clicked => { root.cancel(); } }
    Rectangle {
        width: min(root.width - 48px, 340px);
        height: col.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        background: Theme.sheet-bg;
        border-radius: Theme.r-lg;
        TouchArea { }
        col := VerticalLayout {
            padding: 24px;
            padding-bottom: 12px;
            spacing: 12px;
            Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            Text { text: root.message; font-size: Theme.fs; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "Cancel"; clicked => { root.cancel(); } }
                TextButton { text: root.ok-text; strong: true; danger: root.danger; clicked => { root.ok(); } }
            }
        }
    }
}

export component ConvRow {
    in property <ConvItem> item;
    in property <bool> selected;
    callback clicked;
    callback long-pressed;
    height: Theme.compact ? max(56px, 44px * Theme.scale) : max(72px, 58px * Theme.scale);
    accessible-role: button;
    accessible-label: root.item.title + (root.item.unread > 0 ? ", " + root.item.unread + " unread" : "") + (root.item.muted ? ", muted" : "");
    VerticalLayout {
        if root.item.header != "": SectionHeader { text: root.item.header; }
        Rectangle {
            vertical-stretch: 1;
            background: root.selected ? Theme.accent.with-alpha(0.16) : (ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.5) : transparent));
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                Avatar {
                    initials: root.item.initials;
                    tint: root.item.color;
                    size: (Theme.compact ? 36px : 48px) * Theme.scale;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.item.title;
                            font-size: Theme.fs * 1.05;
                            font-weight: root.item.unread > 0 ? 700 : 600;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.item.favourite: Icon { name: "star"; size: 14px; tint: Theme.warn; y: (parent.height - self.height) / 2; }
                        Text {
                            text: root.item.stamp;
                            font-size: Theme.fs-small;
                            color: root.item.unread > 0 && !root.item.muted ? Theme.accent-text : Theme.muted;
                        }
                    }
                    if !Theme.compact: HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.item.preview;
                            font-size: Theme.fs * 0.93;
                            color: Theme.muted;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.item.muted: Icon { name: "bell-off"; size: 16px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                        if root.item.unread > 0: Rectangle {
                            width: max(22px, badge.preferred-width + 14px);
                            height: 22px * Theme.scale;
                            border-radius: 11px * Theme.scale;
                            background: root.item.muted ? Theme.icon-soft : (root.item.mentions > 0 ? Theme.danger : Theme.accent);
                            badge := Text {
                                text: root.item.unread;
                                color: root.item.muted ? Theme.bg : (root.item.mentions > 0 ? Theme.on-danger : Theme.on-accent);
                                font-size: Theme.fs-small;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }
            ta := PressArea {
                tapped => { root.clicked(); }
                long-pressed => { root.long-pressed(); }
            }
        }
    }
}

export component MessageRow {
    in property <MsgItem> m;
    in property <bool> selected;
    in property <bool> in-thread: false;
    in property <bool> tap-opens: false;
    callback actions;
    callback react(string);
    callback retry;
    callback open-thread;
    callback open-file(string);
    callback open-link(string);
    callback form-action(string);
    in property <string> playing-id;
    callback play-audio(string);
    VerticalLayout {
        spacing: 3px;
        if m.day != "": HorizontalLayout {
            alignment: center;
            padding-top: 8px;
            Rectangle {
                border-radius: 12px;
                background: Theme.bubble-other;
                width: dl.preferred-width + 20px;
                height: dl.preferred-height + 8px;
                dl := Text { text: m.day; font-size: Theme.fs-small; color: Theme.muted; font-weight: 700; }
            }
        }
        if m.divider: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            Rectangle { height: 1px; background: Theme.danger; y: 8px; horizontal-stretch: 1; }
            Text { text: "New messages"; color: Theme.danger; font-size: Theme.fs-small; font-weight: 700; }
            Rectangle { height: 1px; background: Theme.danger; y: 8px; horizontal-stretch: 1; }
        }
        Rectangle {
            background: root.selected ? Theme.bubble-other : transparent;
            HorizontalLayout {
                spacing: 10px;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: Theme.compact ? 1px : 4px;
                padding-bottom: Theme.compact ? 1px : 4px;
                Avatar {
                    initials: m.initials;
                    tint: m.color;
                    size: (Theme.compact ? 26px : 34px) * Theme.scale;
                    y: 2px;
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: m.sender;
                            font-size: Theme.fs;
                            font-weight: 700;
                        }
                        if m.is-app: Rectangle {
                            width: apptag.preferred-width + 10px;
                            height: apptag.preferred-height + 2px;
                            y: 2px;
                            border-radius: 3px;
                            background: Theme.accent.with-alpha(0.22);
                            accessible-role: text;
                            accessible-label: "App";
                            apptag := Text { text: "APP"; font-size: Theme.fs-small * 0.8; font-weight: 800; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text {
                            text: m.time + (m.edited ? " (edited)" : "") + (m.state == 1 ? "  sending..." : "") + (m.state == 2 ? "  not sent" : "") + (m.state == 3 ? "  \u{2713}" : "") + (m.pinned ? "  pinned" : "");
                            font-size: Theme.fs-small;
                            color: m.state == 2 ? Theme.danger : Theme.muted;
                            vertical-alignment: bottom;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if m.state == 2: Link { text: "Retry"; clicked => { root.retry(); } }
                    }
                    if m.forwarded != "": Text { text: "\u{21AA} " + m.forwarded; font-size: Theme.fs-small; color: Theme.muted; font-italic: true; }
                    if m.quote != "": Rectangle {
                        height: qt.preferred-height + 6px;
                        Rectangle { x: 0; width: 3px; background: Theme.accent; }
                        qt := Text {
                            x: 10px;
                            width: parent.width - 10px;
                            text: m.quote;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                    if m.deleted: Text {
                        text: "Message deleted";
                        font-size: Theme.fs;
                        font-italic: true;
                        color: Theme.muted;
                    }
                    if !m.deleted: VerticalLayout {
                        spacing: 4px;
                        for b in m.blocks: VerticalLayout {
                            if b.kind == 1: Rectangle {
                                background: Theme.bubble-other;
                                border-radius: 6px;
                                height: ct.preferred-height + 16px;
                                ct := Text {
                                    x: 8px;
                                    y: 8px;
                                    width: parent.width - 16px;
                                    text: b.text;
                                    font-family: "monospace";
                                    font-size: Theme.fs * 0.92;
                                    wrap: word-wrap;
                                }
                            }
                            if b.kind == 2: Rectangle {
                                height: qs.preferred-height + 4px;
                                Rectangle { x: 0; width: 3px; background: Theme.line; }
                                qs := StyledText {
                                    x: 10px;
                                    width: parent.width - 10px;
                                    text: b.styled;
                                    default-color: Theme.muted;
                                    default-font-size: Theme.fs;
                                    link-color: Theme.accent;
                                    link-clicked(l) => { root.open-link(l); }
                                }
                            }
                            if b.kind == 0: StyledText {
                                text: b.styled;
                                default-color: Theme.text;
                                default-font-size: Theme.fs;
                                link-color: Theme.accent;
                                selectable: true;
                                link-clicked(l) => { root.open-link(l); }
                            }
                        }
                        for f in m.files: VerticalLayout {
                            spacing: 3px;
                            if f.has-img: HorizontalLayout {
                                alignment: start;
                                Image {
                                    source: f.img;
                                    width: 240px * Theme.scale;
                                    height: self.width * f.img.height / max(1, f.img.width);
                                    image-fit: contain;
                                    accessible-role: image;
                                    accessible-label: f.name;
                                    TouchArea { clicked => { root.open-file(f.id); } }
                                }
                            }
                            Rectangle {
                                height: max(36px, 30px * Theme.scale);
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: fta.has-hover ? Theme.bubble-other : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Icon { name: f.kind == 1 ? "image" : (f.kind == 3 ? "mic" : "file"); size: 20px; y: (parent.height - self.height) / 2; }
                                    Text {
                                        text: f.removed ? "File removed" : f.name + "  (" + f.size + ")";
                                        font-size: Theme.fs-small;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if !f.removed: Text {
                                        text: f.kind == 3 ? (root.playing-id == f.id ? "Stop" : "Play") : (f.kind == 2 ? "Play" : "Open");
                                        color: Theme.accent;
                                        font-size: Theme.fs-small;
                                        vertical-alignment: center;
                                    }
                                }
                                fta := TouchArea { enabled: !f.removed; clicked => { if f.kind == 3 { root.play-audio(f.id); } else { root.open-file(f.id); } } }
                            }
                        }
                        if m.has-form: Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.bubble-other;
                            height: fc.preferred-height + 2px;
                            accessible-role: groupbox;
                            accessible-label: m.form-title;
                            fc := VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                if m.form-title != "": Text { text: m.form-title; font-size: Theme.fs; font-weight: 700; wrap: word-wrap; }
                                if m.form-desc != "": Text { text: m.form-desc; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                if m.responded: Text { text: "\u{2713} You responded"; font-size: Theme.fs-small; color: Theme.accent-text; font-weight: 700; }
                                if !m.responded: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    if m.form-fields: PrimaryButton { text: "Fill in"; clicked => { root.form-action(""); } }
                                    for b in m.form-buttons: HorizontalLayout {
                                        if b.style == "primary" && !m.form-fields: PrimaryButton { text: b.label + (b.modal ? "..." : ""); clicked => { root.form-action(b.id); } }
                                        if b.style != "primary" || m.form-fields: GhostButton { text: b.label + (b.modal ? "..." : ""); danger: b.style == "danger"; clicked => { root.form-action(b.id); } }
                                    }
                                }
                            }
                        }
                        if m.reactions.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for r in m.reactions: Rectangle {
                                height: 26px * Theme.scale;
                                width: rch.preferred-width;
                                border-radius: self.height / 2;
                                border-width: 1px;
                                border-color: r.mine ? Theme.accent : Theme.line;
                                background: r.mine ? Theme.accent.with-alpha(0.18) : transparent;
                                accessible-role: button;
                                accessible-label: r.emoji + " " + r.count;
                                rch := HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    if r.has-img: Image { source: r.img; width: 16px * Theme.scale; height: 16px * Theme.scale; y: (parent.height - self.height) / 2; }
                                    if !r.has-img: Text { text: r.emoji; font-size: Theme.fs-small * 1.1; vertical-alignment: center; }
                                    Text { text: r.count; font-size: Theme.fs-small * 1.1; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.react(r.emoji); } }
                            }
                        }
                        if m.replies > 0 && !root.in-thread: Link {
                            text: m.replies == 1 ? "1 reply" : m.replies + " replies";
                            strong: true;
                            clicked => { root.open-thread(); }
                        }
                    }
                }
            }
            PressArea {
                z: -1;
                tapped => { if root.tap-opens { root.actions(); } }
                long-pressed => { root.actions(); }
            }
        }
    }
}

