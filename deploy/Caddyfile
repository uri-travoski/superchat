# Used by the `caddy` profile. Set ATOMIC_HOST in .env:
#   - a domain name (e.g. chat.example.com): Caddy gets a public certificate automatically.
#   - a bare IP address (e.g. 203.0.113.7): Caddy issues a certificate from its own CA ("tls internal").
#     Clients pin the certificate on first connect (trust on first use), so no CA install is needed.
{$ATOMIC_HOST} {
	{$CADDY_TLS:}
	encode zstd gzip
	reverse_proxy superchat:8080 {
		# WebSocket upgrades are passed through automatically.
		flush_interval -1
	}
	request_body {
		max_size 2GB
	}
}
