import { LineEdit, ListView, ScrollView, Palette, Switch, TextEdit } from "std-widgets.slint";
import { Theme, ConvItem, MsgItem, PersonItem, RowItem, BookmarkItem, BlockItem, FileItem, ReactItem, EmojiItem, FormFieldItem, FormOptionItem, FormButtonItem } from "theme.slint";
import { Avatar, Link, Pill, PrimaryButton, GhostButton, SectionHeader, ConvRow, MessageRow } from "components.slint";
export { Theme, ConvItem, MsgItem, PersonItem, RowItem, BookmarkItem, BlockItem, FileItem, ReactItem, EmojiItem, FormFieldItem, FormOptionItem, FormButtonItem }

component Header {
    in property <string> title;
    in property <bool> show-back: true;
    callback back;
    height: max(52px, 38px * Theme.scale);
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        if root.show-back: GhostButton { text: "\u{2190}"; clicked => { root.back(); } }
        Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        @children
    }
}

component SettingRow {
    in property <string> label;
    in property <string> hint;
    VerticalLayout {
        spacing: 4px;
        padding-top: 8px;
        Text { text: root.label; font-size: Theme.fs; font-weight: 700; }
        if root.hint != "": Text { text: root.hint; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
        @children
    }
}

component Overlay inherits Rectangle {
    in property <color> shade: #00000066;
    callback dismiss;
    background: root.shade;
    TouchArea { clicked => { root.dismiss(); } }
}

export component AppWindow inherits Window {
    title: "Atomic Chat";
    icon: @image-url("assets/icon.png");
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 320px;
    min-height: 480px;
    background: Palette.background;
    default-font-size: Theme.fs;

    // ---- session ----
    in-out property <bool> signed-in: false;
    in-out property <string> login-error;
    in-out property <bool> busy: false;
    in-out property <string> f-server;
    in-out property <string> f-user;
    in-out property <string> f-pass;
    in-out property <string> f-link;
    in-out property <bool> use-link: false;
    in-out property <bool> tofu-open: false;
    in-out property <string> tofu-fp;
    in-out property <string> tofu-host;
    in-out property <string> status;
    in-out property <bool> is-android: false;
    in-out property <string> version;

    // ---- data ----
    in-out property <[ConvItem]> conversations;
    in-out property <[MsgItem]> messages;
    in-out property <[MsgItem]> thread-messages;
    in-out property <MsgItem> thread-root;
    in-out property <[RowItem]> pins;
    in-out property <[RowItem]> files;
    in-out property <[RowItem]> threads;
    in-out property <[RowItem]> results;
    in-out property <[RowItem]> recents;
    in-out property <[RowItem]> switcher;
    in-out property <[RowItem]> sessions;
    in-out property <[RowItem]> sections;
    in-out property <[PersonItem]> people;
    in-out property <[PersonItem]> mentions;
    in-out property <[BookmarkItem]> bookmarks;
    in-out property <[EmojiItem]> emoji-list;
    in-out property <[RowItem]> home;
    in-out property <[RowItem]> drafts-rows;
    in-out property <[RowItem]> saved;
    in-out property <[FormFieldItem]> form-fields;
    in-out property <bool> form-open: false;
    in-out property <string> form-title;
    in-out property <string> form-desc;
    in-out property <string> form-error;
    in-out property <string> form-submit-label: "Submit";
    in-out property <bool> schedule-open: false;
    in-out property <string> schedule-when;
    in-out property <string> schedule-error;
    in-out property <bool> bookmark-open: false;
    in-out property <string> bm-title;
    in-out property <string> bm-url;
    in-out property <bool> is-bot-dm: false;
    in-out property <string> playing-id;
    in-out property <bool> recording: false;
    in-out property <bool> can-record: false;
    in-out property <bool> close-tray: true;
    in-out property <string> share-text;
    in-out property <int> unread-tray: 0;
    in-out property <bool> can-curate: false;
    in-out property <int> scheduled-count: 0;
    in-out property <bool> ai-enabled: false;
    in-out property <bool> ai-on: false;
    in-out property <bool> ai-busy: false;
    in-out property <string> ai-answer;
    in-out property <string> ai-note;

    // ---- state ----
    in-out property <string> current-conv;
    in-out property <string> current-title;
    in-out property <string> current-sub;
    in-out property <bool> current-fav;
    in-out property <bool> can-write: true;
    in-out property <int> tab: 0;
    in-out property <string> screen;
    in-out property <bool> show-chat: false;
    in-out property <string> thread-id;
    in-out property <string> typing-text;
    in-out property <string> editing-id;
    in-out property <string> composer;
    in-out property <string> thread-composer;
    in-out property <string> selected-msg;
    in-out property <bool> picker-open: false;
    in-out property <string> picker-target;
    in-out property <string> menu-conv;
    in-out property <string> menu-title;
    in-out property <string> menu-kind;
    in-out property <string> menu-msg;
    in-out property <string> jump-text;
    in-out property <bool> jump-open: false;
    in-out property <bool> attach-open: false;
    in-out property <string> attach-path;
    in-out property <string> search-text;
    in-out property <string> switcher-text;
    in-out property <int> total-unread: 0;
    in-out property <bool> first-unread: false;
    in-out property <bool> has-more-older: false;
    in-out property <bool> can-back: false;
    in-out property <bool> can-forward: false;
    in-out property <string> new-section-name;
    in-out property <string> toast;

    // ---- me / settings ----
    in-out property <string> me-name;
    in-out property <string> me-initials;
    in-out property <color> me-color: #888888;
    in-out property <string> presence-pref: "auto";
    in-out property <string> edit-name;
    in-out property <string> avatar-path;
    in-out property <int> theme-mode: 0;
    in-out property <int> font-step: 0;
    in-out property <int> zoom: 100;
    in-out property <bool> hour24: false;
    in-out property <bool> notif: true;
    in-out property <bool> notif-preview: true;
    in-out property <string> push-choice: "none";
    in-out property <string> ntfy-url;
    in-out property <bool> privacy-enabled: false;
    in-out property <bool> hide-last-active: false;
    in-out property <bool> launch-login: false;
    in-out property <bool> start-min: false;
    in-out property <bool> sort-alpha: false;
    in-out property <bool> unread-only: false;
    in-out property <bool> hide-muted: false;
    in-out property <length> list-y;
    in-out property <length> list-h;
    in-out property <length> list-vh;
    out property <bool> wide: self.width >= 720px;
    out property <bool> thread-side: self.width >= 1000px;

    callback login(string, string, string, string);
    callback tofu-accept();
    callback tofu-cancel();
    callback select-conv(string);
    callback send(string);
    callback thread-send(string);
    callback save-edit(string, string);
    callback begin-edit(string) -> string;
    callback delete-msg(string);
    callback react(string, string);
    callback retry(string);
    callback search(string);
    callback open-search();
    callback open-threads();
    callback open-thread(string);
    callback close-thread();
    callback load-older();
    callback jump-unread();
    callback jump-date(string);
    callback sign-out();
    callback setting-changed(string);
    callback attach(string);
    callback browse-file();
    callback open-file(string);
    callback open-link(string);
    callback typing();
    callback composer-edited(string);
    callback pick-mention(string);
    callback format(string);
    callback emoji-picked(string);
    callback pin(string);
    callback copy-link(string);
    callback forward-to(string, string);
    callback open-people();
    callback start-dm(string);
    callback toggle-fav(string);
    callback mute(string, string);
    callback notify-level(string, string);
    callback mark-unread(string);
    callback set-section(string, string);
    callback new-section(string);
    callback set-presence(string);
    callback save-profile(string);
    callback set-avatar(string);
    callback revoke-session(string);
    callback revoke-others();
    callback nav-back();
    callback nav-forward();
    callback switcher-edited(string);
    callback open-switcher();
    callback result-clicked(int, string, string);
    callback row-clicked(string, string, string);
    callback zoom-step(int);
    callback open-settings();
    callback tab-changed(int);
    callback form-action(string, string);
    callback form-text(int, string);
    callback form-toggle(int, string);
    callback form-submit(string);
    callback home-action(string, string);
    callback schedule(string);
    callback open-drafts();
    callback cancel-scheduled(string);
    callback add-bookmark(string, string);
    callback save-search(string);
    callback play-audio(string);
    callback record-toggle();
    callback paste-image();

    public function scroll-bottom() {
        root.list-y = min(0px, root.list-vh - root.list-h);
    }
    public function scroll-to-fraction(f: float) {
        root.list-y = min(0px, -(root.list-h - root.list-vh) * f);
    }

    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : (root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown);
    }
    changed list-y => {
        if root.list-y > -30px && root.has-more-older && root.tab == 0 { root.load-older(); }
    }

    FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && e.text == "k" { root.open-switcher(); return accept; }
            if e.modifiers.control && (e.text == "+" || e.text == "=") { root.zoom-step(10); return accept; }
            if e.modifiers.control && e.text == "-" { root.zoom-step(-10); return accept; }
            if e.modifiers.control && e.text == "0" { root.zoom-step(0); return accept; }
            if e.modifiers.alt && e.text == Key.LeftArrow { root.nav-back(); return accept; }
            if e.modifiers.alt && e.text == Key.RightArrow { root.nav-forward(); return accept; }
            if e.text == Key.Escape {
                if root.form-open { root.form-open = false; return accept; }
                if root.schedule-open { root.schedule-open = false; return accept; }
                if root.bookmark-open { root.bookmark-open = false; return accept; }
                if root.picker-open { root.picker-open = false; return accept; }
                if root.menu-kind != "" { root.menu-kind = ""; return accept; }
                if root.screen != "" { root.screen = ""; return accept; }
                if root.thread-id != "" { root.close-thread(); return accept; }
            }
            reject
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            Rectangle {
                vertical-stretch: 1;

                // ======================= login =======================
                if !root.signed-in: ScrollView {
                    VerticalLayout {
                        alignment: center;
                        padding: 24px;
                        Rectangle {
                            max-width: 420px;
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Atomic Chat"; font-size: Theme.fs-title * 1.3; font-weight: 800; horizontal-alignment: center; }
                                Text { text: "Sign in to your team's server"; color: Theme.muted; font-size: Theme.fs; horizontal-alignment: center; }
                                LineEdit { text <=> root.f-server; placeholder-text: "Server address (https://chat.example.com)"; font-size: Theme.fs; accessible-label: "Server address"; }
                                if !root.use-link: LineEdit { text <=> root.f-user; placeholder-text: "Username"; font-size: Theme.fs; accessible-label: "Username"; }
                                if !root.use-link: LineEdit { text <=> root.f-pass; placeholder-text: "Password"; input-type: password; font-size: Theme.fs; accessible-label: "Password"; accepted => { root.login(root.f-server, root.f-user, root.f-pass, ""); } }
                                if root.use-link: LineEdit { text <=> root.f-link; placeholder-text: "Paste your one-time login link"; font-size: Theme.fs; accepted => { root.login(root.f-server, "", "", root.f-link); } }
                                if root.login-error != "": Text { text: root.login-error; color: Theme.danger; wrap: word-wrap; font-size: Theme.fs; }
                                PrimaryButton {
                                    text: root.busy ? "Signing in..." : "Sign in";
                                    enabled: !root.busy;
                                    clicked => {
                                        if root.use-link { root.login(root.f-server, "", "", root.f-link); } else { root.login(root.f-server, root.f-user, root.f-pass, ""); }
                                    }
                                }
                                Link {
                                    text: root.use-link ? "Use username and password instead" : "I have a one-time login link";
                                    clicked => { root.use-link = !root.use-link; }
                                }
                            }
                        }
                    }
                }

                // ======================= main =======================
                if root.signed-in: HorizontalLayout {
                    // ---- sidebar ----
                    if root.wide || !root.show-chat: Rectangle {
                        width: root.wide ? 310px * max(1.0, Theme.scale * 0.95) : root.width;
                        background: Theme.sidebar;
                        VerticalLayout {
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Rectangle {
                                    width: av.width;
                                    av := Avatar { initials: root.me-initials; tint: root.me-color; size: 34px * Theme.scale; presence: root.presence-pref == "dnd" ? 3 : (root.presence-pref == "away" ? 2 : 1); }
                                    TouchArea { clicked => { root.open-settings(); } accessible-role: button; accessible-label: "Profile and settings"; }
                                }
                                Text { text: root.me-name; font-size: Theme.fs; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                Link { text: "Threads"; clicked => { root.open-threads(); } }
                                Link { text: "New"; clicked => { root.open-people(); } }
                                Link { text: "Settings"; clicked => { root.open-settings(); } }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-bottom: 6px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 38px * Theme.scale;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    Text { x: 10px; text: "Search"; color: Theme.muted; font-size: Theme.fs; vertical-alignment: center; }
                                    TouchArea { clicked => { root.open-search(); } accessible-role: button; accessible-label: "Search"; }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-bottom: 6px;
                                spacing: 6px;
                                Pill { text: "A-Z"; on: root.sort-alpha; clicked => { root.sort-alpha = !root.sort-alpha; root.setting-changed("sort"); } }
                                Pill { text: "Unread"; on: root.unread-only; clicked => { root.unread-only = !root.unread-only; root.setting-changed("sort"); } }
                                Pill { text: "Hide muted"; on: root.hide-muted; clicked => { root.hide-muted = !root.hide-muted; root.setting-changed("sort"); } }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-bottom: 4px;
                                Link { text: root.scheduled-count > 0 ? "Drafts & sent (" + root.scheduled-count + " scheduled)" : "Drafts & sent"; clicked => { root.open-drafts(); } }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for c[i] in root.conversations: ConvRow {
                                    item: c;
                                    selected: c.id == root.current-conv;
                                    clicked => { root.select-conv(c.id); root.show-chat = true; }
                                    long-pressed => { root.menu-conv = c.id; root.menu-title = c.title; root.menu-kind = "conv"; }
                                }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                Text { text: root.status; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                    }
                    if root.wide: Rectangle { width: 1px; background: Theme.line; }

                    // ---- conversation ----
                    if (root.wide || root.show-chat) && !(root.thread-id != "" && !root.wide): VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 280px;
                        Rectangle {
                            height: max(56px, 40px * Theme.scale);
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                if !root.wide: GhostButton { text: "\u{2190}"; clicked => { root.show-chat = false; } }
                                if root.wide: Link { text: "\u{2039}"; enabled: root.can-back; clicked => { root.nav-back(); } }
                                if root.wide: Link { text: "\u{203A}"; enabled: root.can-forward; clicked => { root.nav-forward(); } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: root.current-title == "" ? "Choose a conversation" : root.current-title; font-size: Theme.fs-title; font-weight: 700; overflow: elide; }
                                    if root.current-sub != "": Text { text: root.current-sub; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                }
                                if root.current-conv != "": Link { text: root.current-fav ? "\u{2605}" : "\u{2606}"; clicked => { root.toggle-fav(root.current-conv); } }
                                if root.current-conv != "": Link { text: "Options"; clicked => { root.menu-conv = root.current-conv; root.menu-title = root.current-title; root.menu-kind = "conv"; } }
                                if root.current-conv != "": Link { text: "Go to date"; clicked => { root.jump-open = !root.jump-open; } }
                            }
                        }
                        if root.current-conv != "": HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            height: 36px * Theme.scale;
                            Pill { text: "Messages"; on: root.tab == 0; clicked => { root.tab = 0; root.tab-changed(0); } }
                            Pill { text: "Files"; on: root.tab == 1; clicked => { root.tab = 1; root.tab-changed(1); } }
                            Pill { text: "Pins"; on: root.tab == 2; clicked => { root.tab = 2; root.tab-changed(2); } }
                            if root.is-bot-dm: Pill { text: "Home"; on: root.tab == 3; clicked => { root.tab = 3; root.tab-changed(3); } }
                            Rectangle { horizontal-stretch: 1; }
                            if root.first-unread: Link { text: "First unread"; clicked => { root.jump-unread(); } }
                        }
                        if (root.bookmarks.length > 0 || root.can-curate) && root.current-conv != "": Flickable {
                            height: 34px * Theme.scale;
                            content-width: bm.preferred-width;
                            bm := HorizontalLayout {
                                padding-left: 12px;
                                spacing: 8px;
                                for b in root.bookmarks: Pill { text: "\u{1F516} " + b.title; clicked => { root.open-link(b.url); } }
                                if root.can-curate: Pill { text: "+ Bookmark"; clicked => { root.bm-title = ""; root.bm-url = ""; root.bookmark-open = true; } }
                            }
                        }
                        if root.jump-open: HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            LineEdit { text <=> root.jump-text; placeholder-text: "dd/mm/yyyy"; font-size: Theme.fs; accepted => { root.jump-date(root.jump-text); root.jump-open = false; } }
                            PrimaryButton { text: "Go"; clicked => { root.jump-date(root.jump-text); root.jump-open = false; } }
                        }
                        Rectangle { height: 1px; background: Theme.line; }

                        if root.tab == 0: ListView {
                            vertical-stretch: 1;
                            content-y <=> root.list-y;
                            changed visible-height => { root.list-vh = self.visible-height; }
                            changed content-height => { root.list-h = self.content-height; }
                            for m[i] in root.messages: MessageRow {
                                playing-id: root.playing-id;
                                play-audio(f) => { root.play-audio(f); }
                                m: m;
                                selected: m.id == root.selected-msg;
                                toggle-select => { root.selected-msg = root.selected-msg == m.id ? "" : m.id; }
                                edit => { root.composer = root.begin-edit(m.id); root.editing-id = m.id; root.selected-msg = ""; }
                                remove => { root.delete-msg(m.id); root.selected-msg = ""; }
                                react(e) => { root.react(m.id, e); }
                                open-picker => { root.picker-target = m.id; root.picker-open = true; }
                                retry => { root.retry(m.id); }
                                open-thread => { root.open-thread(m.id); root.selected-msg = ""; }
                                pin => { root.pin(m.id); root.selected-msg = ""; }
                                copy-link => { root.copy-link(m.id); root.selected-msg = ""; }
                                forward => { root.menu-msg = m.id; root.menu-kind = "forward"; root.selected-msg = ""; }
                                open-file(f) => { root.open-file(f); }
                                open-link(l) => { root.open-link(l); }
                                form-action(b) => { root.form-action(m.id, b); }
                            }
                        }
                        if root.tab == 3 && root.home.length == 0: Text { text: "This app has no Home page."; color: Theme.muted; horizontal-alignment: center; }
                        if root.tab == 3: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;
                                for h in root.home: VerticalLayout {
                                    spacing: 4px;
                                    if h.kind == 0: Text { text: h.text; font-size: Theme.fs-title; font-weight: 700; wrap: word-wrap; }
                                    if h.kind == 1: Text { text: h.text; font-size: Theme.fs; wrap: word-wrap; }
                                    if h.kind == 2: Rectangle { height: 1px; background: Theme.line; }
                                    if h.kind == 3: HorizontalLayout { alignment: start; if h.sub == "primary": PrimaryButton { text: h.text; clicked => { root.home-action("button", h.id); } } if h.sub != "primary": GhostButton { text: h.text; danger: h.sub == "danger"; clicked => { root.home-action("button", h.id); } } }
                                    if h.kind == 4: Rectangle {
                                        border-radius: 10px; border-width: 1px; border-color: Theme.line; background: Theme.bubble-other;
                                        height: hf.preferred-height;
                                        hf := VerticalLayout {
                                            padding: 12px; spacing: 6px;
                                            if h.title != "": Text { text: h.title; font-weight: 700; font-size: Theme.fs; wrap: word-wrap; }
                                            if h.text != "": Text { text: h.text; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                            HorizontalLayout { alignment: start; PrimaryButton { text: "Open form"; clicked => { root.home-action("form", h.id); } } }
                                        }
                                    }
                                }
                            }
                        }
                        if root.tab == 1 && root.files.length == 0: Text { text: "No files in this conversation yet."; color: Theme.muted; horizontal-alignment: center; }
                        if root.tab == 1: ListView {
                            vertical-stretch: 1;
                            for f[i] in root.files: Rectangle {
                                height: max(56px, 46px * Theme.scale);
                                background: ft.has-hover ? Theme.bubble-other : transparent;
                                VerticalLayout {
                                    padding: 10px;
                                    alignment: center;
                                    Text { text: f.title; font-size: Theme.fs; overflow: elide; }
                                    Text { text: f.sub; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                }
                                ft := TouchArea { clicked => { root.open-file(f.id); } }
                            }
                        }
                        if root.tab == 2 && root.pins.length == 0: Text { text: "No pinned messages. Select a message and choose Pin."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; }
                        if root.tab == 2: ListView {
                            vertical-stretch: 1;
                            for p[i] in root.pins: Rectangle {
                                height: max(64px, 52px * Theme.scale);
                                background: pn.has-hover ? Theme.bubble-other : transparent;
                                VerticalLayout {
                                    padding: 10px;
                                    alignment: center;
                                    Text { text: p.title; font-size: Theme.fs-small; color: Theme.muted; }
                                    Text { text: p.text; font-size: Theme.fs; overflow: elide; }
                                }
                                pn := TouchArea { clicked => { root.row-clicked("pin", p.id, p.conv); root.tab = 0; } }
                            }
                        }
                        if root.typing-text != "": HorizontalLayout {
                            padding-left: 12px;
                            Text { text: root.typing-text; font-size: Theme.fs-small; color: Theme.muted; }
                        }
                        if root.attach-open: HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            LineEdit { placeholder-text: "Full path of the file (or drop / paste it here)"; font-size: Theme.fs; text <=> root.attach-path; accepted => { root.attach(root.attach-path); root.attach-path = ""; root.attach-open = false; } }
                            GhostButton { text: "Browse"; clicked => { root.browse-file(); } }
                            GhostButton { text: "Paste image"; clicked => { root.paste-image(); } }
                            PrimaryButton { text: "Send file"; clicked => { root.attach(root.attach-path); root.attach-path = ""; root.attach-open = false; } }
                        }
                        if root.mentions.length > 0 && root.tab == 0: Rectangle {
                            height: min(root.mentions.length, 4) * 38px * Theme.scale;
                            background: Palette.background;
                            border-width: 1px;
                            border-color: Theme.line;
                            VerticalLayout {
                                for p in root.mentions: Rectangle {
                                    height: 38px * Theme.scale;
                                    background: mt.has-hover ? Theme.bubble-other : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        Avatar { initials: p.initials; tint: p.color; size: 26px * Theme.scale; y: (parent.height - self.height) / 2; }
                                        Text { text: p.name + "  " + p.sub; font-size: Theme.fs; vertical-alignment: center; }
                                    }
                                    mt := TouchArea { clicked => { root.pick-mention(p.id); } }
                                }
                            }
                        }
                        if root.tab == 0 && root.current-conv != "": VerticalLayout {
                            if !root.can-write: Text { text: "You cannot write in this conversation."; color: Theme.muted; font-size: Theme.fs-small; horizontal-alignment: center; }
                            if root.can-write: HorizontalLayout {
                                padding-left: 10px;
                                spacing: 4px;
                                Link { text: "B"; strong: true; clicked => { root.format("*"); } }
                                Link { text: "I"; clicked => { root.format("_"); } }
                                Link { text: "S"; clicked => { root.format("~"); } }
                                Link { text: "</>"; clicked => { root.format("`"); } }
                                Link { text: "Quote"; clicked => { root.format("> "); } }
                                Link { text: "List"; clicked => { root.format("- "); } }
                                Link { text: "\u{1F600}"; clicked => { root.picker-target = ""; root.picker-open = true; } }
                                Link { text: "Attach"; clicked => { root.attach-open = !root.attach-open; } }
                                if root.can-record: Link { text: root.recording ? "Stop recording" : "Voice"; danger: root.recording; clicked => { root.record-toggle(); } }
                                Link { text: "Schedule"; clicked => { root.schedule-error = ""; root.schedule-when = ""; root.schedule-open = true; } }
                            }
                            if root.can-write: HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: root.editing-id != "" ? "Editing message (Enter to save)" : "Message";
                                    font-size: Theme.fs;
                                    text <=> root.composer;
                                    accessible-label: "Message";
                                    edited(t) => { root.typing(); root.composer-edited(t); }
                                    accepted(t) => {
                                        if root.editing-id != "" { root.save-edit(root.editing-id, t); root.editing-id = ""; } else { root.send(t); }
                                        root.composer = "";
                                    }
                                }
                                if root.editing-id != "": GhostButton { text: "Cancel"; clicked => { root.editing-id = ""; root.composer = ""; } }
                                PrimaryButton {
                                    text: root.editing-id != "" ? "Save" : "Send";
                                    clicked => {
                                        if root.editing-id != "" { root.save-edit(root.editing-id, root.composer); root.editing-id = ""; } else { root.send(root.composer); }
                                        root.composer = "";
                                    }
                                }
                            }
                        }
                    }

                    // ---- thread panel ----
                    if root.thread-id != "": Rectangle {
                        width: root.wide ? 340px : root.width;
                        background: Theme.sidebar;
                        VerticalLayout {
                            Header { title: "Thread"; back => { root.close-thread(); } show-back: !root.thread-side; Link { text: "Close"; clicked => { root.close-thread(); } } }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                MessageRow {
                                playing-id: root.playing-id;
                                play-audio(f) => { root.play-audio(f); }
                                    m: root.thread-root;
                                    in-thread: true;
                                    selected: false;
                                    open-file(f) => { root.open-file(f); }
                                    open-link(l) => { root.open-link(l); }
                                }
                                for m[i] in root.thread-messages: MessageRow {
                                playing-id: root.playing-id;
                                play-audio(f) => { root.play-audio(f); }
                                    m: m;
                                    in-thread: true;
                                    selected: m.id == root.selected-msg;
                                    toggle-select => { root.selected-msg = root.selected-msg == m.id ? "" : m.id; }
                                    react(e) => { root.react(m.id, e); }
                                    open-picker => { root.picker-target = m.id; root.picker-open = true; }
                                    retry => { root.retry(m.id); }
                                    edit => { root.composer = root.begin-edit(m.id); root.editing-id = m.id; root.selected-msg = ""; }
                                    remove => { root.delete-msg(m.id); root.selected-msg = ""; }
                                    copy-link => { root.copy-link(m.id); }
                                    open-file(f) => { root.open-file(f); }
                                    open-link(l) => { root.open-link(l); }
                                }
                                }
                            }
                            if root.can-write: HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "Reply in thread";
                                    font-size: Theme.fs;
                                    text <=> root.thread-composer;
                                    accessible-label: "Thread reply";
                                    edited(t) => { root.typing(); }
                                    accepted(t) => { root.thread-send(t); root.thread-composer = ""; }
                                }
                                PrimaryButton { text: "Reply"; clicked => { root.thread-send(root.thread-composer); root.thread-composer = ""; } }
                            }
                        }
                    }
                }

                // ======================= screens =======================
                if root.signed-in && root.screen == "search": Rectangle {
                    background: Palette.background;
                    TouchArea { }
                    VerticalLayout {
                        Header { title: "Search"; back => { root.screen = ""; } }
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            LineEdit {
                                placeholder-text: "Search messages, files, people, channels";
                                font-size: Theme.fs;
                                text <=> root.search-text;
                                accessible-label: "Search text";
                                accepted(t) => { root.search(t); }
                                edited(t) => { if !root.ai-on { root.search(t); } }
                            }
                            PrimaryButton { text: root.ai-on ? "Ask" : "Search"; clicked => { root.search(root.search-text); } }
                            if root.search-text != "": GhostButton { text: "Save"; clicked => { root.save-search(root.search-text); } }
                        }
                        if root.ai-enabled: VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            Switch { text: "Ask AI (natural-language search)"; checked: root.ai-on; toggled => { root.ai-on = self.checked; root.ai-answer = ""; } }
                            Text { text: "When on, your question and the names of your people and channels are sent to the AI provider your admin set up. Message text is sent only for recaps and answers."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            if root.ai-busy: Text { text: "Asking the AI..."; font-size: Theme.fs-small; color: Theme.accent; }
                            if root.ai-note != "": Text { text: root.ai-note; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            if root.ai-answer != "": Rectangle { background: Theme.bubble-other; border-radius: 8px; height: aat.preferred-height + 16px; aat := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.ai-answer; wrap: word-wrap; font-size: Theme.fs; } }
                        }
                        Flickable {
                            height: 38px * Theme.scale;
                            content-width: chips.preferred-width;
                            chips := HorizontalLayout {
                                padding-left: 10px;
                                spacing: 6px;
                                Pill { text: "from:"; clicked => { root.search-text = root.search-text + " from:"; } }
                                Pill { text: "in:"; clicked => { root.search-text = root.search-text + " in:"; } }
                                Pill { text: "has:link"; clicked => { root.search-text = root.search-text + " has:link"; root.search(root.search-text); } }
                                Pill { text: "has:file"; clicked => { root.search-text = root.search-text + " has:file"; root.search(root.search-text); } }
                                Pill { text: "has:reaction"; clicked => { root.search-text = root.search-text + " has:reaction"; root.search(root.search-text); } }
                                Pill { text: "before:"; clicked => { root.search-text = root.search-text + " before:dd/mm/yyyy"; } }
                                Pill { text: "after:"; clicked => { root.search-text = root.search-text + " after:dd/mm/yyyy"; } }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                            alignment: start;
                            if root.search-text == "" && root.saved.length > 0: Text { text: "Saved searches"; color: Theme.muted; font-size: Theme.fs-small; }
                            if root.search-text == "": VerticalLayout {
                                for r in root.saved: Rectangle {
                                    height: 40px * Theme.scale;
                                    Text { x: 12px; text: "\u{2605} " + r.title; font-size: Theme.fs; vertical-alignment: center; }
                                    TouchArea { clicked => { root.search-text = r.title; root.search(r.title); } }
                                }
                            }
                            if root.search-text == "" && root.recents.length > 0: Text { text: "Recent searches"; color: Theme.muted; font-size: Theme.fs-small; }
                            if root.search-text == "": VerticalLayout {
                                for r in root.recents: Rectangle {
                                    height: 40px * Theme.scale;
                                    Text { x: 12px; text: r.title; font-size: Theme.fs; vertical-alignment: center; }
                                    TouchArea { clicked => { root.search-text = r.title; root.search(r.title); } }
                                }
                            }
                            for r[i] in root.results: Rectangle {
                                height: r.header != "" ? max(96px, 78px * Theme.scale) : max(64px, 52px * Theme.scale);
                                VerticalLayout {
                                    if r.header != "": SectionHeader { text: r.header; }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: rt.has-hover ? Theme.bubble-other : transparent;
                                        HorizontalLayout {
                                            padding: 8px;
                                            spacing: 10px;
                                            if r.kind >= 2: Avatar { initials: r.initials; tint: r.color; size: 34px * Theme.scale; y: (parent.height - self.height) / 2; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: r.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                                Text { text: r.text; font-size: Theme.fs; overflow: elide; }
                                            }
                                        }
                                        rt := TouchArea { clicked => { root.result-clicked(r.kind, r.id, r.conv); } }
                                    }
                                }
                            }
                            }
                        }
                    }
                }

                if root.signed-in && root.screen == "threads": Rectangle {
                    background: Palette.background;
                    TouchArea { }
                    VerticalLayout {
                        Header { title: "Threads"; back => { root.screen = ""; } }
                        if root.threads.length == 0: Text { text: "Threads you start, reply in or follow appear here."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; }
                        ListView {
                            vertical-stretch: 1;
                            for t[i] in root.threads: Rectangle {
                                height: max(76px, 62px * Theme.scale);
                                background: tt.has-hover ? Theme.bubble-other : transparent;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: t.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                        Text { text: t.text; font-size: Theme.fs; overflow: elide; font-weight: t.badge > 0 ? 700 : 400; }
                                        Text { text: t.sub; font-size: Theme.fs-small; color: Theme.muted; }
                                    }
                                    if t.badge > 0: Rectangle {
                                        width: 24px * Theme.scale; height: 24px * Theme.scale; border-radius: 12px * Theme.scale; background: Theme.accent;
                                        Text { text: t.badge; color: white; font-size: Theme.fs-small; font-weight: 700; }
                                    }
                                }
                                tt := TouchArea { clicked => { root.row-clicked("thread", t.id, t.conv); } }
                            }
                        }
                    }
                }

                if root.signed-in && root.screen == "scheduled": Rectangle {
                    background: Palette.background;
                    TouchArea { }
                    VerticalLayout {
                        Header { title: "Drafts & sent"; back => { root.screen = ""; } }
                        if root.drafts-rows.length == 0: Text { text: "Nothing scheduled and no drafts. Use Schedule next to the message box to send later."; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for r[i] in root.drafts-rows: VerticalLayout {
                                    if r.header != "": SectionHeader { text: r.header; }
                                    Rectangle {
                                        height: max(70px, 58px * Theme.scale);
                                        background: dr.has-hover ? Theme.bubble-other : transparent;
                                        HorizontalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: r.title; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                                Text { text: r.text; font-size: Theme.fs; overflow: elide; }
                                                Text { text: r.sub; font-size: Theme.fs-small; color: r.flag ? Theme.danger : Theme.muted; overflow: elide; }
                                            }
                                            if r.kind == 0: Link { text: "Cancel"; danger: true; clicked => { root.cancel-scheduled(r.id); } }
                                        }
                                        dr := TouchArea { clicked => { if r.kind != 0 { root.row-clicked("conv", r.conv, r.conv); } } }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.signed-in && root.screen == "people": Rectangle {
                    background: Palette.background;
                    TouchArea { }
                    VerticalLayout {
                        Header { title: "Message someone"; back => { root.screen = ""; } }
                        ListView {
                            vertical-stretch: 1;
                            for p[i] in root.people: Rectangle {
                                height: max(56px, 46px * Theme.scale);
                                background: pt.has-hover ? Theme.bubble-other : transparent;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Avatar { initials: p.initials; tint: p.color; size: 36px * Theme.scale; y: (parent.height - self.height) / 2; }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: p.name; font-size: Theme.fs; }
                                        if p.sub != "": Text { text: p.sub; font-size: Theme.fs-small; color: Theme.muted; }
                                    }
                                }
                                pt := TouchArea { clicked => { root.start-dm(p.id); root.screen = ""; root.show-chat = true; } }
                            }
                        }
                    }
                }

                if root.signed-in && root.screen == "switcher": Rectangle {
                    background: Palette.background.with-alpha(0.97);
                    TouchArea { clicked => { root.screen = ""; } }
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "Jump to a conversation"; font-size: Theme.fs-title; font-weight: 700; }
                        LineEdit {
                            placeholder-text: "Type a name";
                            font-size: Theme.fs;
                            text <=> root.switcher-text;
                            accessible-label: "Quick switcher";
                            edited(t) => { root.switcher-edited(t); }
                            accepted(t) => { if root.switcher.length > 0 { root.row-clicked("conv", root.switcher[0].id, root.switcher[0].id); } }
                        }
                        for r[i] in root.switcher: Rectangle {
                            height: 44px * Theme.scale;
                            background: sw.has-hover || i == 0 ? Theme.bubble-other : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 10px;
                                Avatar { initials: r.initials; tint: r.color; size: 30px * Theme.scale; y: (parent.height - self.height) / 2; }
                                Text { text: r.title; font-size: Theme.fs; vertical-alignment: center; }
                            }
                            sw := TouchArea { clicked => { root.row-clicked("conv", r.id, r.id); } }
                        }
                    }
                }

                if root.signed-in && root.screen == "settings": Rectangle {
                    background: Palette.background;
                    TouchArea { }
                    VerticalLayout {
                        Header { title: "Settings"; back => { root.screen = ""; } }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                alignment: start;
                                SettingRow {
                                    label: "Profile";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { text <=> root.edit-name; placeholder-text: "Display name"; font-size: Theme.fs; accessible-label: "Display name"; }
                                        PrimaryButton { text: "Save"; clicked => { root.save-profile(root.edit-name); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { text <=> root.avatar-path; placeholder-text: "Path of a profile photo (png or jpg)"; font-size: Theme.fs; accessible-label: "Profile photo path"; }
                                        GhostButton { text: "Set photo"; clicked => { root.set-avatar(root.avatar-path); } }
                                    }
                                }
                                SettingRow {
                                    label: "Status";
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        GhostButton { text: "Online"; on: root.presence-pref == "auto"; clicked => { root.set-presence("auto"); } }
                                        GhostButton { text: "Away"; on: root.presence-pref == "away"; clicked => { root.set-presence("away"); } }
                                        GhostButton { text: "Do not disturb"; on: root.presence-pref == "dnd"; clicked => { root.set-presence("dnd"); } }
                                    }
                                }
                                SettingRow {
                                    label: "Theme";
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        GhostButton { text: "System"; on: root.theme-mode == 0; clicked => { root.theme-mode = 0; root.setting-changed("theme"); } }
                                        GhostButton { text: "Light"; on: root.theme-mode == 1; clicked => { root.theme-mode = 1; root.setting-changed("theme"); } }
                                        GhostButton { text: "Dark"; on: root.theme-mode == 2; clicked => { root.theme-mode = 2; root.setting-changed("theme"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px; alignment: start;
                                        for c[i] in [#0dbd8b, #0467dd, #7b61ff, #e8590c]: Rectangle {
                                            width: 38px * Theme.scale; height: 38px * Theme.scale; border-radius: self.width / 2; background: c;
                                            border-width: Theme.accent-index == i ? 3px : 0px; border-color: Palette.foreground;
                                            accessible-role: button; accessible-label: "Accent colour " + (i + 1);
                                            TouchArea { clicked => { Theme.accent-index = i; root.setting-changed("accent"); } }
                                        }
                                    }
                                }
                                SettingRow {
                                    label: "Text size";
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        GhostButton { text: "Regular"; on: root.font-step == 0; clicked => { root.font-step = 0; root.setting-changed("font"); } }
                                        GhostButton { text: "Large"; on: root.font-step == 1; clicked => { root.font-step = 1; root.setting-changed("font"); } }
                                        GhostButton { text: "Extra large"; on: root.font-step == 2; clicked => { root.font-step = 2; root.setting-changed("font"); } }
                                    }
                                }
                                if !root.is-android: SettingRow {
                                    label: "Zoom";
                                    hint: "Ctrl and + / - / 0 also work.";
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        GhostButton { text: "-"; clicked => { root.zoom-step(-10); } }
                                        Text { text: root.zoom + "%"; font-size: Theme.fs; vertical-alignment: center; }
                                        GhostButton { text: "+"; clicked => { root.zoom-step(10); } }
                                        GhostButton { text: "Reset"; clicked => { root.zoom-step(0); } }
                                    }
                                }
                                SettingRow {
                                    label: "Display";
                                    Switch { text: "Compact density"; checked: Theme.compact; toggled => { Theme.compact = self.checked; root.setting-changed("compact"); } }
                                    Switch { text: "Reduce motion"; checked: Theme.reduce-motion; toggled => { Theme.reduce-motion = self.checked; root.setting-changed("motion"); } }
                                    Switch { text: "24-hour clock"; checked: root.hour24; toggled => { root.hour24 = self.checked; root.setting-changed("hour24"); } }
                                }
                                SettingRow {
                                    label: "Notifications";
                                    Switch { text: "Show notifications"; checked: root.notif; toggled => { root.notif = self.checked; root.setting-changed("notif"); } }
                                    Switch { text: "Show message preview"; checked: root.notif-preview; toggled => { root.notif-preview = self.checked; root.setting-changed("notif"); } }
                                }
                                if root.is-android: SettingRow {
                                    label: "Push notifications";
                                    hint: "Pushes never contain message text: the app wakes, syncs and shows its own notification.";
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        GhostButton { text: "Off"; on: root.push-choice == "none"; clicked => { root.push-choice = "none"; root.setting-changed("push"); } }
                                        GhostButton { text: "ntfy"; on: root.push-choice == "ntfy"; clicked => { root.push-choice = "ntfy"; root.setting-changed("push"); } }
                                        GhostButton { text: "Google (FCM)"; on: root.push-choice == "fcm"; clicked => { root.push-choice = "fcm"; root.setting-changed("push"); } }
                                    }
                                    if root.push-choice == "ntfy": LineEdit { text <=> root.ntfy-url; placeholder-text: "ntfy server (empty for the server's default)"; font-size: Theme.fs; accessible-label: "ntfy server"; edited => { root.setting-changed("push"); } }
                                }
                                if !root.is-android: SettingRow {
                                    label: "Desktop";
                                    Switch { text: "Start when I sign in"; checked: root.launch-login; toggled => { root.launch-login = self.checked; root.setting-changed("launch"); } }
                                    Switch { text: "Start minimised to the tray"; checked: root.start-min; toggled => { root.start-min = self.checked; root.setting-changed("launch"); } }
                                    Switch { text: "Keep running in the tray when the window is closed"; checked: root.close-tray; toggled => { root.close-tray = self.checked; root.setting-changed("tray"); } }
                                }
                                if root.privacy-enabled: SettingRow {
                                    label: "Privacy";
                                    Switch { text: "Hide my last active time"; checked: root.hide-last-active; toggled => { root.hide-last-active = self.checked; root.setting-changed("privacy"); } }
                                }
                                SettingRow {
                                    label: "Sections";
                                    hint: "Group conversations in the sidebar. Right-click or long-press a conversation to file it.";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { text <=> root.new-section-name; placeholder-text: "New section name"; font-size: Theme.fs; accessible-label: "New section name"; }
                                        GhostButton { text: "Add"; clicked => { root.new-section(root.new-section-name); root.new-section-name = ""; } }
                                    }
                                }
                                SettingRow {
                                    label: "Devices";
                                    hint: "Where you are signed in.";
                                    VerticalLayout {
                                        for s in root.sessions: HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Text { text: s.title; font-size: Theme.fs; overflow: elide; }
                                                Text { text: s.sub; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
                                            }
                                            if !s.flag: Link { text: "Sign out"; danger: true; clicked => { root.revoke-session(s.id); } }
                                            if s.flag: Text { text: "This device"; font-size: Theme.fs-small; color: Theme.muted; vertical-alignment: center; }
                                        }
                                        Link { text: "Sign out all other devices"; danger: true; clicked => { root.revoke-others(); } }
                                    }
                                }
                                HorizontalLayout {
                                    padding-top: 12px; spacing: 8px; alignment: start;
                                    GhostButton { text: "Sign out"; danger: true; clicked => { root.screen = ""; root.sign-out(); } }
                                    PrimaryButton { text: "Close"; clicked => { root.screen = ""; } }
                                }
                                Text { text: root.version + "  |  Built with Slint (slint.dev), colour emoji by Noto Color Emoji"; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                    }
                }

                // ---- emoji picker ----
                if root.picker-open: Overlay {
                    dismiss => { root.picker-open = false; }
                    Rectangle {
                        y: parent.height - self.height;
                        height: min(parent.height * 0.6, 330px);
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Theme.line;
                        TouchArea { }
                        VerticalLayout {
                            padding: 8px;
                            Text { text: root.picker-target == "" ? "Insert emoji" : "React"; font-size: Theme.fs-small; color: Theme.muted; }
                            ScrollView {
                                content-height: (floor(root.emoji-list.length / 8) + 1) * 44px * Theme.scale;
                                for e[i] in root.emoji-list: Rectangle {
                                    x: mod(i, 8) * 44px * Theme.scale;
                                    y: floor(i / 8) * 44px * Theme.scale;
                                    width: 44px * Theme.scale;
                                    height: 44px * Theme.scale;
                                    background: ea.has-hover ? Theme.bubble-other : transparent;
                                    accessible-role: button;
                                    accessible-label: e.ch;
                                    if e.has-img: Image { source: e.img; width: 28px * Theme.scale; height: 28px * Theme.scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                    if !e.has-img: Text { text: e.ch; font-size: 24px * Theme.scale; }
                                    ea := TouchArea { clicked => { root.emoji-picked(e.ch); root.picker-open = false; } }
                                }
                            }
                        }
                    }
                }

                // ---- conversation menu / forward ----
                if root.menu-kind != "": Overlay {
                    dismiss => { root.menu-kind = ""; }
                    Rectangle {
                        width: min(parent.width - 32px, 380px);
                        height: min(parent.height - 32px, 520px);
                        background: Palette.background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        TouchArea { }
                        ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                alignment: start;
                                if root.menu-kind == "conv": Text { text: root.menu-title; font-size: Theme.fs-title; font-weight: 700; overflow: elide; }
                                if root.menu-kind == "forward": Text { text: "Forward to"; font-size: Theme.fs-title; font-weight: 700; }
                                if root.menu-kind == "share": Text { text: "Share to"; font-size: Theme.fs-title; font-weight: 700; }
                                if root.menu-kind == "share" && root.share-text != "": Text { text: root.share-text; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                                if root.menu-kind == "conv": Link { text: "Favourite or unfavourite"; clicked => { root.toggle-fav(root.menu-conv); root.menu-kind = ""; } }
                                if root.menu-kind == "conv": Link { text: "Mark as unread"; clicked => { root.mark-unread(root.menu-conv); root.menu-kind = ""; } }
                                if root.menu-kind == "conv": SectionHeader { text: "Mute"; }
                                if root.menu-kind == "conv": HorizontalLayout {
                                    spacing: 6px;
                                    Pill { text: "1 hour"; clicked => { root.mute(root.menu-conv, "1h"); root.menu-kind = ""; } }
                                    Pill { text: "8 hours"; clicked => { root.mute(root.menu-conv, "8h"); root.menu-kind = ""; } }
                                    Pill { text: "Tomorrow"; clicked => { root.mute(root.menu-conv, "tomorrow"); root.menu-kind = ""; } }
                                }
                                if root.menu-kind == "conv": HorizontalLayout {
                                    spacing: 6px;
                                    Pill { text: "Forever"; clicked => { root.mute(root.menu-conv, "forever"); root.menu-kind = ""; } }
                                    Pill { text: "Unmute"; clicked => { root.mute(root.menu-conv, "off"); root.menu-kind = ""; } }
                                }
                                if root.menu-kind == "conv": SectionHeader { text: "Notify me about"; }
                                if root.menu-kind == "conv": HorizontalLayout {
                                    spacing: 6px;
                                    Pill { text: "All"; clicked => { root.notify-level(root.menu-conv, "all"); root.menu-kind = ""; } }
                                    Pill { text: "Mentions"; clicked => { root.notify-level(root.menu-conv, "mentions"); root.menu-kind = ""; } }
                                    Pill { text: "Nothing"; clicked => { root.notify-level(root.menu-conv, "nothing"); root.menu-kind = ""; } }
                                }
                                if root.menu-kind == "conv": SectionHeader { text: "Move to section"; }
                                if root.menu-kind == "conv": Link { text: "No section"; clicked => { root.set-section(root.menu-conv, ""); root.menu-kind = ""; } }
                                if root.menu-kind == "conv": VerticalLayout { for s in root.sections: Link { text: s.title; clicked => { root.set-section(root.menu-conv, s.id); root.menu-kind = ""; } } }
                                if root.menu-kind == "forward" || root.menu-kind == "share": VerticalLayout { for c in root.conversations: Rectangle {
                                    height: 44px * Theme.scale;
                                    background: fw.has-hover ? Theme.bubble-other : transparent;
                                    Text { x: 8px; text: c.title; font-size: Theme.fs; vertical-alignment: center; overflow: elide; }
                                    fw := TouchArea { clicked => { root.forward-to(root.menu-msg, c.id); root.menu-kind = ""; } }
                                } }
                                Link { text: "Close"; clicked => { root.menu-kind = ""; } }
                            }
                        }
                    }
                }

                // ---- certificate fingerprint (trust on first use) ----
                if root.tofu-open: Overlay {
                    shade: #000000aa;
                    dismiss => { }
                    Rectangle {
                        width: min(parent.width - 32px, 460px);
                        height: tc.preferred-height + 32px;
                        background: Palette.background;
                        border-radius: 12px;
                        tc := VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: "Trust this server?"; font-size: Theme.fs-title; font-weight: 700; }
                            Text { text: root.tofu-host + " uses a certificate that no public authority signed. If you trust this server, check that this fingerprint matches the one your administrator gave you."; wrap: word-wrap; font-size: Theme.fs; }
                            Rectangle {
                                background: Theme.bubble-other;
                                border-radius: 6px;
                                height: fpt.preferred-height + 16px;
                                fpt := Text { x: 8px; y: 8px; width: parent.width - 16px; text: root.tofu-fp; font-family: "monospace"; wrap: word-wrap; font-size: Theme.fs-small * 1.1; }
                            }
                            HorizontalLayout { spacing: 8px; alignment: end; GhostButton { text: "Cancel"; clicked => { root.tofu-cancel(); } } PrimaryButton { text: "Trust and sign in"; clicked => { root.tofu-accept(); } } }
                        }
                    }
                }

                // ---- bot form (A-03) ----
                if root.form-open: Overlay {
                    shade: #000000aa;
                    dismiss => { root.form-open = false; }
                    Rectangle {
                        width: min(parent.width - 24px, 460px);
                        height: min(parent.height - 24px, 560px);
                        background: Palette.background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        TouchArea { }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.form-title; font-size: Theme.fs-title; font-weight: 700; wrap: word-wrap; }
                            if root.form-desc != "": Text { text: root.form-desc; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for f[i] in root.form-fields: VerticalLayout {
                                        spacing: 3px;
                                        Text { text: f.label + (f.required ? " *" : ""); font-size: Theme.fs; font-weight: 700; wrap: word-wrap; }
                                        if f.kind == 0: LineEdit { text: f.text; placeholder-text: f.placeholder; font-size: Theme.fs; accessible-label: f.label; edited(t) => { root.form-text(i, t); } }
                                        if f.kind == 1: TextEdit { text: f.text; height: 90px * Theme.scale; font-size: Theme.fs; accessible-label: f.label; edited(t) => { root.form-text(i, t); } }
                                        if f.kind == 2: Switch { text: f.placeholder != "" ? f.placeholder : "Yes"; checked: f.flag; toggled => { root.form-toggle(i, ""); } }
                                        if f.kind >= 3: VerticalLayout {
                                            for o in f.options: Rectangle {
                                                height: 36px * Theme.scale;
                                                background: oa.has-hover ? Theme.bubble-other : transparent;
                                                accessible-role: checkbox;
                                                accessible-label: o.label;
                                                accessible-checked: o.on;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    spacing: 8px;
                                                    Text { text: f.kind == 3 ? (o.on ? "\u{25C9}" : "\u{25CB}") : (o.on ? "\u{2611}" : "\u{2610}"); font-size: Theme.fs * 1.2; vertical-alignment: center; color: o.on ? Theme.accent : Palette.foreground; }
                                                    Text { text: o.label; font-size: Theme.fs; vertical-alignment: center; horizontal-alignment: left; horizontal-stretch: 1; }
                                                }
                                                oa := TouchArea { clicked => { root.form-toggle(i, o.value); } }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.form-error != "": Text { text: root.form-error; color: Theme.danger; font-size: Theme.fs; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                GhostButton { text: "Cancel"; clicked => { root.form-open = false; } }
                                PrimaryButton { text: root.form-submit-label; clicked => { root.form-submit(""); } }
                            }
                        }
                    }
                }

                // ---- schedule send (M-23) ----
                if root.schedule-open: Overlay {
                    shade: #000000aa;
                    dismiss => { root.schedule-open = false; }
                    Rectangle {
                        width: min(parent.width - 24px, 420px);
                        height: scv.preferred-height + 4px;
                        background: Palette.background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        TouchArea { }
                        scv := VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Schedule send"; font-size: Theme.fs-title; font-weight: 700; }
                            Text { text: "The server sends the message at that time, even if this app is closed. See it under Drafts & sent."; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; }
                            HorizontalLayout { spacing: 6px; Pill { text: "In 1 hour"; clicked => { root.schedule("1h"); } } Pill { text: "In 3 hours"; clicked => { root.schedule("3h"); } } }
                            HorizontalLayout { spacing: 6px; Pill { text: "Tomorrow 9:00 am"; clicked => { root.schedule("tomorrow"); } } Pill { text: "Monday 9:00 am"; clicked => { root.schedule("monday"); } } }
                            LineEdit { text <=> root.schedule-when; placeholder-text: "Custom: dd/mm/yyyy hh:mm (24-hour)"; font-size: Theme.fs; accessible-label: "Custom date and time"; accepted => { root.schedule(root.schedule-when); } }
                            if root.schedule-error != "": Text { text: root.schedule-error; color: Theme.danger; font-size: Theme.fs-small; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px; alignment: end; GhostButton { text: "Cancel"; clicked => { root.schedule-open = false; } } PrimaryButton { text: "Schedule"; clicked => { root.schedule(root.schedule-when); } } }
                        }
                    }
                }

                // ---- add bookmark (C-07) ----
                if root.bookmark-open: Overlay {
                    shade: #000000aa;
                    dismiss => { root.bookmark-open = false; }
                    Rectangle {
                        width: min(parent.width - 24px, 420px);
                        height: bmv.preferred-height + 4px;
                        background: Palette.background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        TouchArea { }
                        bmv := VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Add a bookmark"; font-size: Theme.fs-title; font-weight: 700; }
                            LineEdit { text <=> root.bm-title; placeholder-text: "Title"; font-size: Theme.fs; accessible-label: "Bookmark title"; }
                            LineEdit { text <=> root.bm-url; placeholder-text: "https://..."; font-size: Theme.fs; accessible-label: "Bookmark link"; accepted => { root.add-bookmark(root.bm-title, root.bm-url); } }
                            HorizontalLayout { spacing: 8px; alignment: end; GhostButton { text: "Cancel"; clicked => { root.bookmark-open = false; } } PrimaryButton { text: "Add"; clicked => { root.add-bookmark(root.bm-title, root.bm-url); } } }
                        }
                    }
                }

                if root.toast != "": Rectangle {
                    y: parent.height - 90px;
                    height: tt2.preferred-height + 20px;
                    width: min(parent.width - 32px, tt2.preferred-width + 32px);
                    x: (parent.width - self.width) / 2;
                    background: Palette.foreground;
                    border-radius: 10px;
                    tt2 := Text { text: root.toast; color: Palette.background; font-size: Theme.fs; wrap: word-wrap; }
                }
            }
        }
    }
}

// The system tray icon (E-08): click to show the window, menu to open or quit.
export component AtomicTray inherits SystemTrayIcon {
    in property <int> unread: 0;
    callback open-app;
    callback quit-app;
    icon: @image-url("assets/icon.png");
    title: "Atomic Chat";
    clicked => { root.open-app(); }
    tooltip: root.unread > 0 ? "Atomic Chat - " + root.unread + " unread" : "Atomic Chat";
    Menu {
        MenuItem { title: "Open Atomic Chat"; activated => { root.open-app(); } }
        MenuItem { title: "Quit"; activated => { root.quit-app(); } }
    }
}
