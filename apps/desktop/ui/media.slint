// Attachment cards: the voice-message player (waveform, play/pause, seek, speed), the video card with its poster frame
// and the file card (PDF and others).
import { Theme, FileItem } from "theme.slint";
import { Icon } from "icons.slint";
import { FileGlyph } from "filetype.slint";

// M-30: a voice message. Click the waveform to jump, the round button plays or pauses, the pill cycles 1x / 1.5x / 2x.
export component AudioCard {
    in property <FileItem> f;
    in property <bool> active; // this is the message the player is on (playing or paused)
    in property <bool> playing;
    in property <float> frac;
    in property <string> time-text;
    in property <string> speed-text: "1x";
    callback toggle;
    callback seek(float);
    callback speed;
    height: max(48px, 42px * Theme.scale);
    preferred-width: 360px * max(1.0, Theme.scale * 0.9);
    min-width: 220px;
    horizontal-stretch: 0;
    Rectangle {
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            Rectangle {
                width: 38px * Theme.scale;
                height: self.width;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: Theme.accent;
                Icon { name: root.playing ? "pause" : "play"; size: 18px * Theme.scale; filled: true; weight: 1px; tint: Theme.on-accent; x: (parent.width - self.width) / 2 + (root.playing ? 0px : 1px); y: (parent.height - self.height) / 2; }
                TouchArea { clicked => { root.toggle(); } }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                wave := Rectangle {
                    height: 28px * Theme.scale;
                    property <int> n: max(1, root.f.peaks.length);
                    // Without stored peaks (older messages) a plain progress track is drawn.
                    if root.f.peaks.length == 0: Rectangle { y: (parent.height - 4px) / 2; height: 4px; border-radius: 2px; background: Theme.line; Rectangle { width: parent.width * root.frac; border-radius: 2px; background: Theme.accent; } }
                    for p[i] in root.f.peaks: Rectangle {
                        x: i * wave.width / wave.n;
                        width: max(2px, wave.width / wave.n * 0.62);
                        height: max(3px, wave.height * p / 255);
                        y: (wave.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: (i + 0.5) / wave.n <= root.frac && root.active ? Theme.accent : Theme.icon-soft.with-alpha(0.55);
                    }
                    TouchArea { clicked => { root.seek(max(0, min(1, self.mouse-x / self.width))); } }
                }
                Text { text: root.time-text != "" && root.active ? root.time-text : root.f.dur-text; font-size: Theme.fs-small; color: Theme.muted; }
            }
            Rectangle {
                width: 44px;
                height: 26px * Theme.scale;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: sp.has-hover ? Theme.row-hover : transparent;
                border-width: 1px;
                border-color: Theme.line;
                Text { text: root.speed-text; font-size: Theme.fs-small; font-weight: 700; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                sp := TouchArea { clicked => { root.speed(); } }
            }
        }
    }
}

// M-31: a video clip: the poster frame with a play button and the duration.
export component VideoCard {
    in property <FileItem> f;
    callback open;
    height: (root.f.has-poster ? 190px : 64px) * max(1.0, Theme.scale * 0.8);
    preferred-width: root.f.has-poster ? 320px * max(1.0, Theme.scale * 0.9) : 340px;
    min-width: 200px;
    horizontal-stretch: 0;
    Rectangle {
        border-radius: 12px;
        background: #11151a;
        clip: true;
        border-width: 1px;
        border-color: Theme.line;
        if root.f.has-poster: Image { source: root.f.poster; width: parent.width; height: parent.height; image-fit: cover; }
        if !root.f.has-poster: Text { x: 70px; width: parent.width - 80px; text: root.f.name + "  (" + root.f.size + ")"; color: white; font-size: Theme.fs-small; vertical-alignment: center; overflow: elide; }
        Rectangle {
            x: root.f.has-poster ? (parent.width - self.width) / 2 : 14px;
            y: (parent.height - self.height) / 2;
            width: 44px; height: 44px; border-radius: 22px; background: #000000a0;
            Icon { name: "play"; size: 22px; filled: true; weight: 1px; tint: white; x: (parent.width - self.width) / 2 + 1px; y: (parent.height - self.height) / 2; }
        }
        if root.f.dur-text != "": Rectangle {
            x: parent.width - self.width - 8px; y: parent.height - self.height - 8px;
            width: dt.preferred-width + 12px; height: 20px; border-radius: 10px; background: #000000b0;
            dt := Text { text: root.f.dur-text; color: white; font-size: Theme.fs-small * 0.95; horizontal-alignment: center; vertical-alignment: center; }
        }
        TouchArea { clicked => { root.open(); } }
    }
}

// F-03 and others: a file card with a type badge (PDF, ZIP...), name, size and Open. A PDF whose first page has been
// drawn by the server shows that page as a preview above the name.
export component FileCard {
    in property <FileItem> f;
    callback open;
    property <bool> preview: root.f.has-poster && !root.f.removed;
    preferred-height: root.preview ? max(210px, 190px * Theme.scale) + max(60px, 52px * Theme.scale) : max(60px, 52px * Theme.scale);
    preferred-width: 340px * max(1.0, Theme.scale * 0.9);
    min-width: 200px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    Rectangle {
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.line;
        background: ta.has-hover ? Theme.bubble-other : Theme.bg;
        clip: true;
        VerticalLayout {
            if root.preview: Rectangle {
                height: max(210px, 190px * Theme.scale);
                background: #ffffff;
                clip: true;
                // The top of the page at full width (the rest is cut off), like a document thumbnail.
                Image { source: root.f.poster; x: 0px; y: 0px; width: parent.width; height: parent.width * root.f.poster.height / max(1, root.f.poster.width); image-fit: fill; image-rendering: smooth; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            }
            HorizontalLayout {
                padding: 8px;
                padding-left: 10px;
                padding-right: 12px;
                spacing: 10px;
                height: max(60px, 52px * Theme.scale);
                FileGlyph { ext: root.f.ext; kind: root.f.kind; size: 40px * min(Theme.scale, 1.3); y: (parent.height - self.height) / 2; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.f.removed ? "File removed" : root.f.name; font-size: Theme.fs-small * 1.05; color: Theme.text; overflow: elide; }
                    if !root.f.removed: Text { text: root.f.size; font-size: Theme.fs-small * 0.92; color: Theme.muted; }
                }
                if !root.f.removed: Text { text: "Open"; color: Theme.accent-text; font-size: Theme.fs-small; vertical-alignment: center; }
            }
        }
        ta := TouchArea { enabled: !root.f.removed; clicked => { root.open(); } }
    }
}
