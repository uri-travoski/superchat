    callback set-sound(string, string);
    in-out property <string> push-choice: "none";
    in-out property <string> ntfy-url;
    in-out property <bool> privacy-enabled: false;
    // Self-service sign-out is only offered to admins and to users whose Privacy options is Allow.
    in-out property <bool> sign-out-allowed: false;
    in-out property <bool> confirm-sign-out-all: false;
    in-out property <length> settings-scroll-y: 0px;
    in-out property <bool> hide-last-active: false;
    in-out property <bool> launch-login: false;
    in-out property <bool> start-min: false;
    in-out property <string> settings-page;
    in-out property <bool> info-open: false;
    in-out property <string> info-page; // "" = the details list (phone) / About (desktop), about, members, settings, files, pins, bookmarks, home
    in-out property <[PersonItem]> members;
    in-out property <string> confirm; // alert dialog kind: signout, signout-all, revoke-others, delete-msg, remove-pin
    in-out property <MsgItem> sel-msg;
    in-out property <bool> sel-in-thread: false;
    in-out property <[EmojiItem]> quick-emoji;
    in-out property <string> me-username;
    in-out property <string> server-text;
    in-out property <bool> formatting-open: false;
    in-out property <int> banner-i: 0;
    in-out property <string> people-text;
    in-out property <bool> is-admin: false;
    in-out property <bool> menu-fav: false;
    in-out property <string> new-channel-name;
    // C-06: delete channel with the typed name.
    in-out property <bool> delete-open: false;
    in-out property <string> delete-typed;
    callback delete-channel(string);
    in-out property <bool> new-channel-open: false;
    callback back-pressed() -> bool;
    callback people-filter(string);
    callback create-channel(string);
    callback scan-image();
    in-out property <bool> sort-alpha: false;
    in-out property <bool> unread-only: false;
    in-out property <bool> hide-muted: false;
    in-out property <length> list-y;
    // Position of the first unread message as a fraction of the list, and how many messages follow it.
    in-out property <float> first-unread-frac: 0;
    in-out property <int> unread-new: 0;
    property <float> view-top: root.list-h > 0px ? (-root.list-y / root.list-h) : 0;
    property <float> view-bottom: root.list-h > 0px ? ((-root.list-y + root.list-vh) / root.list-h) : 1;
    // True while the first unread message is scrolled out of view (above or below the visible part).
    property <bool> unread-away: root.first-unread && root.list-h > 0px && (root.first-unread-frac < root.view-top - 0.01 || root.first-unread-frac > root.view-bottom + 0.01);
    property <bool> unread-above: root.first-unread-frac < root.view-top;
    in-out property <length> list-h;
    in-out property <length> list-vh;
    out property <bool> wide: self.width >= 720px;
    out property <bool> thread-side: self.width >= 1000px;

    callback login(string, string, string, string);
    callback scan-qr();
    // ---- App Lock ----
    in-out property <bool> lock-set: false;
    in-out property <bool> lock-engaged: false;
    in-out property <bool> lock-entry-open: false;
    in-out property <string> lock-error;
    in-out property <string> lock-pin;
    in-out property <string> lock-title: "App Lock";
    in-out property <string> lock-hint: "Enter your PIN";
    in-out property <int> lock-shake: 0;
    // Auto-lock minutes (0 = as soon as the app is left / idle) and its label.
    in-out property <int> lock-timeout: 5;
    in-out property <string> lock-timeout-label: "5 minutes";
    in-out property <bool> toast-undo: false;
