import { Palette } from "std-widgets.slint";

export struct ConvItem {
    id: string,
    title: string,
    initials: string,
    color: color,
    unread: int,
    mentions: int,
    preview: string,
    stamp: string,
    kind: string,
    favourite: bool,
    muted: bool,
    archived: bool,
    header: string, // non-empty on the first row of a section
}

export struct BlockItem {
    kind: int, // 0 paragraph/list, 1 code, 2 quote
    text: string,
    styled: styled-text,
}

export struct ReactItem {
    emoji: string,
    count: int,
    mine: bool,
    img: image,
    has-img: bool,
}

// A picker emoji; `img` is the colour picture (the text renderers draw colour fonts as outlines).
export struct EmojiItem {
    ch: string,
    img: image,
    has-img: bool,
}

export struct FormOptionItem {
    value: string,
    label: string,
    on: bool,
}

export struct FormFieldItem {
    id: string,
    kind: int, // 0 text, 1 multiline, 2 boolean, 3 select, 4 multi select
    label: string,
    placeholder: string,
    required: bool,
    text: string,
    flag: bool,
    options: [FormOptionItem],
}

export struct FormButtonItem {
    id: string,
    label: string,
    style: string, // primary, danger or empty
    modal: bool,
}

export struct FileItem {
    id: string,
    name: string,
    size: string,
    kind: int, // 0 other, 1 image, 2 video, 3 audio
    img: image,
    has-img: bool,
    removed: bool,
    // M-30 / M-31 / F-03: audio waveform and duration, video poster frame, file type label.
    peaks: [int],
    dur-text: string,
    has-poster: bool,
    poster: image,
    ext: string,
}

export struct PersonItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    sub: string,
    sel: bool,
    tag: string,
}

export struct MsgItem {
    id: string,
    sender: string,
    initials: string,
    color: color,
    time: string,
    mine: bool,
    edited: bool,
    deleted: bool,
    can-edit: bool,
    state: int, // 0 sent, 1 sending, 2 failed, 3 delivered
    day: string,
    blocks: [BlockItem],
    files: [FileItem],
    reactions: [ReactItem],
    replies: int,
    pinned: bool,
    forwarded: string,
    quote: string,
    divider: bool,
    can-pin: bool,
    is-app: bool,
    has-form: bool,
    form-title: string,
    form-desc: string,
    form-fields: bool,
    form-buttons: [FormButtonItem],
    responded: bool,
    grouped: bool, // continuation of the previous sender's run: no avatar or name
    system: bool,
    saved: bool,
    reply-people: [PersonItem],
    reply-time: string,
    reply-unread: bool,
    sender-id: string,
    // F-01: upload progress of a message that is still being sent (-1 = not uploading, 0..100 = percent).
    upload-pct: int,
    upload-text: string,
    upload-error: string,
}

// One row of a generic list: search results, threads, files, pins, sessions, quick switcher.
export struct RowItem {
    kind: int, // search: 0 message, 1 file, 2 person, 3 channel
    id: string,
    conv: string,
    title: string,
    sub: string,
    text: string,
    badge: int,
    flag: bool,
    initials: string,
    color: color,
    header: string,
    pre: string,
    hit: string,
    post: string,
    // Files: upper-case extension for the file icon.
    ext: string,
}

// One row of the sidebar, the DM list or the phone Home list.
export struct SideRow {
    kind: int, // 0 section header, 1 conversation, 2 quick link (Threads, Drafts, Later), 3 hint text
    id: string,
    title: string,
    icon: string,
    initials: string,
    color: color,
    unread: int,
    mentions: int,
    muted: bool,
    favourite: bool,
    collapsed: bool,
    count: int,
    conv-kind: string, // dm, self, group, channel
    presence: int,
    locked: bool,
    // A picture is set for this channel or group (everyone's, or the one this account chose): shown instead of the icon.
    pic: bool,
    draft: bool,
    plus: string, // header "+" action: channel, dm or empty
    preview: string,
    stamp: string,
    user-id: string,
}

export struct LabelItem {
    id: string,
    name: string,
    tint: color,
    on: bool,
}

// A saved message of the Later view.
export struct SavedRow {
    id: string,
    conv: string,
    conv-title: string,
    sender: string,
    initials: string,
    color: color,
    time: string,
    text: string,
    deleted: bool,
    labels: [LabelItem],
    user-id: string,
}

export struct ActivityRow {
    id: string,
    kind: int, // 0 mention, 1 reaction, 2 thread reply
    actor: string,
    initials: string,
    color: color,
    title: string,
    snippet: string,
    conv: string,
    msg: string,
    root: string,
    time: string,
    unread: bool,
    emoji: string,
    img: image,
    has-img: bool,
    user-id: string,
}

export struct BookmarkItem {
    id: string,
    title: string,
    url: string,
}

// P-03: profile photos by user id (downloaded by client-core, filled in by the app); initials show when there is none.
export struct AvatarImg { id: string, img: image }
export global Avatars { in-out property <[AvatarImg]> items; }

export global Theme {
    // Text size multiplier (Regular 1.0, Large 1.15, XL 1.3) times zoom times the Android system scale.
    in-out property <float> scale: 1.0;
    in-out property <bool> compact: false;
    // True when the window is wide enough for the desktop layout (popover menus, compact rows).
    in-out property <bool> wide: false;
    in-out property <int> accent-index: 0;
    in-out property <bool> reduce-motion: false;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: [#0dbd8b, #0467dd, #6a4cf5, #e8590c][accent-index];
    out property <color> accent-text: dark ? [#3ddcae, #6aa9ff, #a898ff, #ff9a5c][accent-index] : [#087a5c, #0467dd, #5a3fe0, #b8460a][accent-index];
    // Text on an accent fill must keep 4.5:1; the orange and green accents need dark text.
    out property <color> on-accent: [#06281f, #ffffff, #ffffff, #1f0d02][accent-index];
    out property <length> fs: 15px * scale;
    out property <length> fs-small: 12px * scale;
    out property <length> fs-title: 19px * scale;
    out property <length> fs-large: 24px * scale;
    out property <length> pad: compact ? 5px : 10px;

    // ---- spacing scale (4 / 8 / 12 / 16 / 24), radii, touch target ----
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp6: 24px;
    out property <length> r-sm: 8px;
    out property <length> r-md: 12px;
    out property <length> r-lg: 16px;
    out property <length> r-sheet: 24px;
    out property <length> touch: 48px;

    // ---- colour tokens: a soft dark theme (never pure black), light icons ----
    out property <color> bg: dark ? #1c1f24 : #ffffff;
    out property <color> surface: dark ? #262a31 : #f2f4f8;
    out property <color> surface-high: dark ? #30353d : #e7eaf0;
    out property <color> sheet-bg: dark ? #272b32 : #ffffff;
    out property <color> scrim: #000000;
    out property <color> muted: dark ? #aab1bd : #596273;
    out property <color> line: dark ? #ffffff1f : #0000001a;
    out property <color> icon: dark ? #c4cad4 : #5a6372;
    out property <color> icon-soft: dark ? #aeb5c1 : #6b7482;
    out property <color> text: dark ? #eceff4 : #1b1f24;
    out property <color> bubble-mine: accent.with-alpha(0.2);
    out property <color> bubble-other: dark ? #ffffff14 : #00000010;
    out property <color> sidebar: dark ? #1c1f24 : #ffffff;
    // Slack-style shell: a darker rail, a tinted sidebar, hover rows and a floating toolbar.
    out property <color> rail: dark ? #121417 : #e8ecf2;
    out property <color> side-bg: dark ? #181b20 : #f3f5f9;
    out property <color> row-hover: dark ? #ffffff0d : #00000009;
    out property <color> row-sel: accent.with-alpha(dark ? 0.26 : 0.16);
    out property <color> toolbar-bg: dark ? #2b3038 : #ffffff;
    out property <color> mention-bg: dark ? #f2c94c26 : #fff3c4;
    out property <color> danger: dark ? #ff8a80 : #c62828;
    out property <color> on-danger: dark ? #1c1f24 : #ffffff;
    out property <color> ok: dark ? #5fd38a : #2e7d32;
    out property <color> warn: dark ? #ffd166 : #b26a00;
}

// NV-04: state of a sidebar drag. The row being dragged writes the pointer position, every row below the pointer
// marks itself as the target (and whether the drop lands before or after it).
export global Drag {
    in-out property <bool> active: false;
    // 1.4: a long press armed a phone list row for dragging (the list stops scrolling until it is let go).
    in-out property <bool> holding: false;
    in-out property <string> src;
    in-out property <string> label;
    in-out property <string> target;
    in-out property <int> zone: 0;
    in-out property <length> x;
    in-out property <length> y;
    public function reset() {
        self.active = false;
        self.holding = false;
        self.src = "";
        self.target = "";
        self.zone = 0;
    }
}

// E-05: a red squiggle under a misspelled word of the message box (position inside the text field, width, zigzag path).
export struct SpellMark {
    x: length,
    y: length,
    w: length,
    path: string,
}
