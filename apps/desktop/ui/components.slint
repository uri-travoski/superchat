import { Palette } from "std-widgets.slint";
import { Theme, Avatars } from "theme.slint";
import { Icon } from "icons.slint";
export { Icon }

// A cached picture (profile photo, or "conv:<id>" for a channel or group) drawn over whatever is under it.
export component PicFill {
    in property <string> key;
    Rectangle {
        for a in Avatars.items: Rectangle {
            if a.id == root.key: Image { source: a.img; width: parent.width; height: parent.height; image-fit: cover; }
        }
    }
}

export component Avatar {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 40px * Theme.scale;
    in property <int> presence: 0; // 0 none, 1 online, 2 away, 3 dnd
    // The user's id: when a profile photo is cached for it, the photo replaces the initials.
    in property <string> uid;
    width: size;
    height: size;
    Rectangle {
        border-radius: parent.width / 2;
        background: root.tint;
        clip: true;
        Text {
            text: root.initials;
            color: white;
            font-size: root.size * 0.4;
            font-weight: 700;
        }
        if root.uid != "": Rectangle {
            for a in Avatars.items: Rectangle {
                if a.id == root.uid: Image { source: a.img; width: parent.width; height: parent.height; image-fit: cover; }
            }
        }
    }
    if root.presence > 0: Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: root.size * 0.3;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.bg;
        background: root.presence == 1 ? Theme.ok : (root.presence == 2 ? Theme.warn : Theme.danger);
    }
}

// A touch area that also reports a long press (450 ms without moving) and a right click.
export component PressArea inherits TouchArea {
    callback tapped;
    callback long-pressed;
    // NV-04: with `draggable`, pulling the pointer away from where it went down starts a drag (the pointer position is
    // reported in window coordinates); `drag-ended` fires when the button is released.
    in property <bool> draggable: false;
    // 1.4 phone lists: with `hold-drag` a long press arms the row (`hold-started`: it lifts and shows a handle) instead of
    // opening the menu at once. Moving then drags it; letting go without moving reports `long-pressed` (the menu).
    in property <bool> hold-drag: false;
    callback drag-started;
    callback drag-moved(length, length);
    callback drag-ended;
    callback hold-started;
    callback hold-ended;
    property <bool> fired: false;
    property <bool> dragging: false;
    in-out property <bool> holding: false;
    out property <bool> active: root.holding || root.dragging;
    Timer {
        interval: 450ms;
        running: root.pressed && !root.fired && abs(root.mouse-x - root.pressed-x) < 12px && abs(root.mouse-y - root.pressed-y) < 12px;
        triggered => {
            root.fired = true;
            if root.hold-drag { root.holding = true; root.hold-started(); } else { root.long-pressed(); }
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.fired = false; root.dragging = false; root.holding = false; }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right { root.long-pressed(); }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
            if root.dragging { root.dragging = false; root.holding = false; root.drag-ended(); }
            else if root.holding { root.holding = false; root.hold-ended(); root.long-pressed(); }
        }
        if e.kind == PointerEventKind.cancel {
            if root.dragging { root.dragging = false; root.holding = false; root.drag-ended(); }
            else if root.holding { root.holding = false; root.hold-ended(); }
        }
    }
    moved => {
        if root.hold-drag && root.holding && !root.dragging && (abs(root.mouse-y - root.pressed-y) > 8px || abs(root.mouse-x - root.pressed-x) > 8px) {
            root.dragging = true;
            root.drag-started();
        }
        if root.draggable && root.pressed && !root.dragging && !root.fired && (abs(root.mouse-y - root.pressed-y) > 8px || abs(root.mouse-x - root.pressed-x) > 8px) {
            root.dragging = true;
            root.fired = true;
            root.drag-started();
        }
        if root.dragging { root.drag-moved(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y); }
    }
    clicked => { if !root.fired { root.tapped(); } }
}

// Flat text button used for small actions.
export component Link {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> strong: false;
    in property <bool> enabled: true;
    callback clicked;
    min-height: 32px;
    min-width: lbl.preferred-width + 16px;
    lbl := Text {
        text: root.text;
        font-size: Theme.fs-small * 1.1;
        font-weight: root.strong ? 700 : 500;
        color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.accent-text);
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Pill {
    in property <string> text;
    in property <bool> on: false;
    callback clicked;
    height: 34px * Theme.scale;
    min-width: lbl.preferred-width + 24px;
    Rectangle {
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        background: root.on ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.bubble-other : transparent);
        lbl := Text {
            text: root.text;
            font-size: Theme.fs-small * 1.1;
            color: Theme.text;
        }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

export component PrimaryButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: max(44px, 34px * Theme.scale);
    min-width: lbl.preferred-width + 32px;
    Rectangle {
        border-radius: Theme.r-sm;
        background: root.enabled ? (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : Theme.surface-high;
        lbl := Text {
            text: root.text;
            color: root.enabled ? Theme.on-accent : Theme.muted;
            font-size: Theme.fs;
            font-weight: 600;
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component GhostButton {
    in property <string> text;
    in property <bool> on: false;
    in property <bool> danger: false;
    callback clicked;
    height: max(44px, 34px * Theme.scale);
    min-width: lbl.preferred-width + 28px;
    Rectangle {
        border-radius: Theme.r-sm;
        border-width: 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        background: root.on ? Theme.accent.with-alpha(0.15) : (ta.has-hover ? Theme.bubble-other : transparent);
        lbl := Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.fs;
        }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

// A borderless text button for dialog footers (Cancel / OK).
export component TextButton {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: max(48px, 38px * Theme.scale);
    min-width: max(64px, lbl.preferred-width + 24px);
    Rectangle {
        border-radius: Theme.r-sm;
        background: ta.has-hover ? Theme.bubble-other : transparent;
        lbl := Text {
            text: root.text;
            color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.accent-text);
            font-size: Theme.fs;
            font-weight: root.strong ? 700 : 500;
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component SectionHeader {
    in property <string> text;
    height: Theme.fs-small * 2.4;
    Text {
        x: 16px;
        text: root.text;
        font-size: Theme.fs-small;
        font-weight: 700;
        color: Theme.muted;
        vertical-alignment: bottom;
    }
}

// A 48dp round icon button.
export component IconButton {
    in property <string> icon;
    in property <string> label;
    in property <brush> tint: Theme.icon;
    in property <bool> enabled: true;
    in property <length> glyph: 24px;
    in property <length> weight: 1.75px;
    callback clicked;
    width: 48px;
    height: 48px;
    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.6) : transparent);
        Icon { name: root.icon; size: root.glyph; weight: root.weight; tint: root.enabled ? root.tint : Theme.muted.with-alpha(0.5); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Round floating action button.
// 1.4.1 radio button: one round ring and a centred dot. The ring is a single Rectangle with border-radius = width / 2; the dot
// is a child placed at (ring - dot) / 2 on both axes, so it is centred whatever the screen density. Sizes are even numbers.
export component Radio {
    in property <bool> on: false;
    width: 24px;
    height: 24px;
    ring := Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        border-width: 2px;
        border-color: root.on ? Theme.accent : Theme.icon-soft;
        background: root.on ? Theme.accent.with-alpha(0.10) : transparent;
        if root.on: Rectangle {
            width: 12px;
            height: 12px;
            x: (ring.width - self.width) / 2;
            y: (ring.height - self.height) / 2;
            border-radius: 6px;
            background: Theme.accent;
        }
    }
}

// The new-message button: 59.92 px (1.4.1: 7 % bigger than the 56 px of 1.4.0), the plus scaled with it.
export component Fab {
    in property <string> icon;
    in property <string> label;
    in property <brush> glyph: Theme.on-accent;
    callback clicked;
    width: 59.92px;
    height: 59.92px;
    Rectangle {
        border-radius: 29.96px;
        background: ta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000066;
        Icon { name: root.icon; size: 29.96px; tint: root.glyph; weight: 2.4px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

// Top app bar of a full-screen page: back arrow (or none), title, right-hand actions as children.
export component AppBar {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-back: true;
    in property <string> back-icon: "back";
    callback back;
    height: max(56px, 42px * Theme.scale);
    HorizontalLayout {
        padding-left: root.show-back ? 4px : 16px;
        padding-right: 4px;
        spacing: 4px;
        if root.show-back: IconButton { icon: root.back-icon; label: "Back"; clicked => { root.back(); } y: (parent.height - self.height) / 2; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; overflow: elide; }
            if root.subtitle != "": Text { text: root.subtitle; font-size: Theme.fs-small; color: Theme.muted; overflow: elide; }
        }
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// A row inside a sheet or menu: optional icon, label, optional detail, check mark.
export component SheetRow {
    in property <string> icon;
    in property <string> text;
    in property <string> detail;
    in property <bool> danger: false;
    in property <bool> checked: false;
    /// 1.4.1: a single-choice row: a radio button (round ring, centred dot) instead of the check mark.
    in property <bool> radio: false;
    in property <bool> chevron: false;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.wide ? max(38px, 32px * Theme.scale) : max(48px, 40px * Theme.scale);
    Rectangle {
        background: ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.5) : transparent);
        HorizontalLayout {
            padding-left: Theme.wide ? 14px : 20px;
            padding-right: Theme.wide ? 14px : 20px;
            spacing: Theme.wide ? 12px : 16px;
            if root.icon != "": Icon { name: root.icon; size: Theme.wide ? 20px : 24px; tint: root.danger ? Theme.danger : Theme.icon; y: (parent.height - self.height) / 2; }
            Text { text: root.text; font-size: Theme.fs; color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.text); vertical-alignment: center; horizontal-stretch: 1; min-width: 40px; overflow: elide; }
            if root.detail != "": Text { text: root.detail; font-size: Theme.fs-small; color: Theme.muted; vertical-alignment: center; overflow: elide; max-width: 110px * Theme.scale; }
            if root.checked && !root.radio: Icon { name: "check"; size: Theme.wide ? 18px : 24px; tint: Theme.accent-text; y: (parent.height - self.height) / 2; }
            if root.radio: Radio { on: root.checked; y: (parent.height - self.height) / 2; }
            if root.chevron: Icon { name: "chevron-right"; tint: Theme.icon-soft; size: 20px; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

// A pill-shaped on/off control (no std-widgets Switch: it does not follow the accent or the soft dark theme).
export component Toggle {
    in-out property <bool> checked: false;
    callback toggled;
    width: 46px;
    height: 28px;
    Rectangle {
        border-radius: 14px;
        background: root.checked ? Theme.accent : Theme.surface-high;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.icon-soft;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            y: 4px;
            x: root.checked ? parent.width - self.width - 5px : 5px;
            background: root.checked ? Theme.on-accent : Theme.icon-soft;
            animate x { duration: Theme.reduce-motion ? 0ms : 120ms; }
        }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

// A row of a menu that picks one option (`radio`, a filled circle) or switches one setting (a pill). The menu stays open.
export component ChoiceRow {
    in property <string> text;
    in property <string> icon;
    in property <bool> radio: false;
    in property <bool> on: false;
    callback clicked;
    height: max(48px, 40px * Theme.scale);
    Rectangle {
        background: ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.bubble-other.with-alpha(0.5) : transparent);
        HorizontalLayout {
            padding-left: Theme.wide ? 14px : 20px;
            padding-right: Theme.wide ? 14px : 20px;
            spacing: Theme.wide ? 12px : 16px;
            if root.icon != "": Icon { name: root.icon; size: Theme.wide ? 20px : 24px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
            Text { text: root.text; font-size: Theme.fs; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; min-width: 40px; overflow: elide; }
            if root.radio: Radio { on: root.on; y: (parent.height - self.height) / 2; }
            if !root.radio: Toggle { checked: root.on; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
}

// A small muted heading inside a menu or sheet ("Sort", "Filter").
export component MenuLabel {
    in property <string> text;
    height: max(32px, Theme.fs-small * 2.6);
    Text { x: Theme.wide ? 14px : 20px; width: parent.width - 40px; text: root.text; font-size: Theme.fs-small; font-weight: 700; color: Theme.muted; vertical-alignment: bottom; overflow: elide; }
}

// Settings: a rounded card that holds rows.
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r-lg;
    clip: true;
    VerticalLayout {
        alignment: start;
        @children
    }
}

// Settings row: coloured round icon, title, optional summary, chevron or switch.
export component SettingRow {
    in property <string> icon;
    in property <color> badge: Theme.accent;
    in property <string> title;
    in property <string> summary;
    in property <bool> chevron: true;
    in property <bool> has-switch: false;
    in property <bool> danger: false;
    in-out property <bool> on: false;
    in property <bool> divider: true;
    // A switch whose state the app decides (a tap only asks `clicked`, the switch follows `on`).
    in property <bool> fixed-switch: false;
    callback clicked;
    callback toggled;
    height: max(60px, 46px * Theme.scale);
    Rectangle {
        background: ta.pressed ? Theme.bubble-other : transparent;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 14px;
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: root.badge;
                Icon { name: root.icon; size: 20px; tint: white; weight: 2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { text: root.title; font-size: Theme.fs; color: root.danger ? Theme.danger : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; min-width: min(self.preferred-width, 200px * Theme.scale); }
            if root.summary != "" && !root.has-switch: Text { text: root.summary; font-size: Theme.fs-small * 1.05; color: Theme.muted; vertical-alignment: center; overflow: elide; max-width: 190px * Theme.scale; }
            if root.has-switch: Toggle { checked: root.on; y: (parent.height - self.height) / 2; toggled => { root.on = self.checked; root.toggled(); } }
            if root.chevron && !root.has-switch: Icon { name: "chevron-right"; size: 20px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { clicked => { if root.has-switch && !root.fixed-switch { root.on = !root.on; root.toggled(); } else { root.clicked(); } } }
    }
    if root.divider: Rectangle { x: 66px; y: parent.height - 1px; height: 1px; width: parent.width - 66px; background: Theme.line; }
}

// A modal bottom sheet: scrim, rounded top corners, drag handle, tap outside or swipe down to close.
// On wide windows it is a centred card (or, with `menu`, a popover at the top right).
export component BottomSheet inherits Rectangle {
    in property <string> title;
    in property <bool> wide: false;
    in property <bool> menu: false;
    in property <length> inset-bottom: 0px;
    in property <length> anchor-x: -1px;
    in property <length> anchor-y: -1px;
    in property <length> menu-width: 300px;
    // Open upwards: anchor-y is the bottom edge of the card (menus opened from the bottom of the window).
    in property <bool> anchor-up: false;
    callback dismiss;
    property <bool> shown: false;
    property <length> drag: 0px;
    property <length> max-h: root.height * 0.94;
    // Menus size to their content: a width that grows with the text size, never wider than the window.
    property <length> menu-w: min(root.width - 16px, root.menu-width * max(1.0, Theme.scale * 0.95));
    init => { root.shown = true; }
    background: Theme.scrim.with-alpha(root.shown ? 0.5 : 0.0);
    animate background { duration: Theme.reduce-motion ? 0ms : 180ms; }
    TouchArea { clicked => { root.dismiss(); } }
    card := Rectangle {
        width: root.wide ? (root.menu ? root.menu-w : min(root.width - 16px, 400px * max(1.0, Theme.scale * 0.95))) : root.width;
        height: min(root.max-h, (root.wide ? 12px : 28px) + ttl.height + body.content-height + root.inset-bottom + (root.wide ? 8px : 24px));
        x: root.wide ? (root.menu ? (root.anchor-x >= 0px ? max(8px, min(root.anchor-x, root.width - self.width - 8px)) : root.width - self.width - 12px) : (root.width - self.width) / 2) : 0px;
        y: root.wide ? (root.menu ? (root.anchor-y >= 0px ? max(8px, min(root.anchor-up ? root.anchor-y - self.height : root.anchor-y, root.height - self.height - 8px)) : 8px) : max(12px, (root.height - self.height) / 2)) : (root.shown ? root.height - self.height + root.drag : root.height);
        background: Theme.sheet-bg;
        border-top-left-radius: Theme.r-sheet;
        border-top-right-radius: Theme.r-sheet;
        border-bottom-left-radius: root.wide ? Theme.r-md : 0px;
        border-bottom-right-radius: root.wide ? Theme.r-md : 0px;
        drop-shadow-blur: root.wide ? 18px : 0px;
        drop-shadow-color: #00000066;
        animate y { duration: Theme.reduce-motion || root.drag > 0px ? 0ms : 200ms; easing: ease-out; }
        TouchArea { }
        // Drag handle + title: swipe down here to dismiss.
        VerticalLayout {
            Rectangle {
                height: root.wide ? 6px : 28px;
                if !root.wide: Rectangle { width: 36px; height: 4px; border-radius: 2px; background: Theme.icon-soft.with-alpha(0.6); y: 10px; x: (parent.width - self.width) / 2; }
                TouchArea {
                    moved => { if !root.wide { root.drag = max(0px, self.mouse-y - self.pressed-y); } }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up { if root.drag > 70px { root.dismiss(); } root.drag = 0px; }
                    }
                }
            }
            ttl := Rectangle {
                height: root.title != "" ? max(36px, 28px * Theme.scale) : 0px;
                if root.title != "": Text { x: 20px; text: root.title; font-size: Theme.fs-small * 1.05; font-weight: 700; color: Theme.muted; vertical-alignment: center; overflow: elide; width: parent.width - 40px; }
            }
            body := Flickable {
                height: min(self.content-height, root.max-h - (root.wide ? 12px : 28px) - ttl.height - root.inset-bottom - (root.wide ? 8px : 24px));
                content-height: inner.preferred-height;
                inner := VerticalLayout {
                    alignment: start;
                    @children
                }
            }
            Rectangle { height: root.inset-bottom + (root.wide ? 8px : 24px); }
        }
    }
}

// A modal page-style card for forms: title, visible close X, scrolling body, sticky footer. A bottom sheet on phones.
export component ModalCard inherits Rectangle {
    in property <string> title;
    in property <string> ok-text;
    in property <bool> ok-enabled: true;
    callback ok;
    in property <bool> wide: false;
    in property <length> inset-bottom: 0px;
    callback dismiss;
    property <bool> shown: false;
    property <length> card-w: root.wide ? min(460px, root.width - 32px) : root.width;
    init => { root.shown = true; }
    background: Theme.scrim.with-alpha(0.55);
    TouchArea { clicked => { root.dismiss(); } }
    card := Rectangle {
        width: root.card-w;
        height: min(root.height - (root.wide ? 32px : 24px), 24px + ttl.height + body.content-height + ftr.preferred-height + root.inset-bottom + 8px);
        x: (root.width - self.width) / 2;
        y: root.wide ? (root.height - self.height) / 2 : root.height - self.height;
        background: Theme.sheet-bg;
        border-top-left-radius: root.wide ? Theme.r-lg : Theme.r-sheet;
        border-top-right-radius: root.wide ? Theme.r-lg : Theme.r-sheet;
        border-bottom-left-radius: root.wide ? Theme.r-lg : 0px;
        border-bottom-right-radius: root.wide ? Theme.r-lg : 0px;
        TouchArea { }
        VerticalLayout {
            ttl := HorizontalLayout {
                height: max(56px, 42px * Theme.scale);
                padding-left: 20px;
                padding-right: 4px;
                Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                IconButton { icon: "close"; label: "Close"; clicked => { root.dismiss(); } y: (parent.height - self.height) / 2; }
            }
            body := Flickable {
                width: root.card-w;
                height: min(self.content-height, root.height - 140px - root.inset-bottom);
                content-height: inner.preferred-height;
                inner := VerticalLayout {
                    width: root.card-w;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    alignment: start;
                    @children
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            ftr := HorizontalLayout {
                padding: 10px;
                padding-left: 20px;
                padding-right: 16px;
                spacing: 8px;
                alignment: end;
                TextButton { text: "Cancel"; clicked => { root.dismiss(); } }
                if root.ok-text != "": PrimaryButton { text: root.ok-text; enabled: root.ok-enabled; clicked => { root.ok(); } }
            }
            Rectangle { height: root.inset-bottom; }
        }
    }
}

// A confirmation: title, message, two text buttons (Cancel / OK).
export component AlertDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> ok-text: "OK";
    in property <bool> danger: false;
    callback cancel;
    callback ok;
    background: Theme.scrim.with-alpha(0.55);
    TouchArea { clicked => { root.cancel(); } }
    Rectangle {
        width: min(root.width - 48px, 340px);
        height: col.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        background: Theme.sheet-bg;
        border-radius: Theme.r-lg;
        TouchArea { }
        col := VerticalLayout {
            padding: 24px;
            padding-bottom: 12px;
            spacing: 12px;
            Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            Text { text: root.message; font-size: Theme.fs; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                TextButton { text: "Cancel"; clicked => { root.cancel(); } }
                TextButton { text: root.ok-text; strong: true; danger: root.danger; clicked => { root.ok(); } }
            }
        }
    }
}


// A small count badge (unread, mentions).
export component CountBadge {
    in property <int> n;
    in property <bool> hot: false; // mentions: red
    in property <bool> quiet: false; // muted: grey
    width: max(20px * Theme.scale, lbl.preferred-width + 12px);
    height: 20px * Theme.scale;
    Rectangle {
        border-radius: self.height / 2;
        background: root.quiet ? Theme.icon-soft : (root.hot ? Theme.danger : Theme.accent);
        lbl := Text {
            text: root.n > 99 ? "99+" : root.n;
            font-size: Theme.fs-small * 0.92;
            font-weight: 700;
            color: root.quiet ? Theme.bg : (root.hot ? Theme.on-danger : Theme.on-accent);
        }
    }
}

// A coloured label chip (Later view, label picker).
export component LabelChip {
    in property <string> text;
    in property <color> tint: Theme.accent;
    in property <bool> on: false;
    in property <bool> removable: false;
    callback clicked;
    callback removed;
    height: 26px * Theme.scale;
    min-width: row.preferred-width;
    Rectangle {
        border-radius: self.height / 2;
        background: root.on ? root.tint : root.tint.with-alpha(0.18);
        border-width: 1px;
        border-color: root.tint.with-alpha(0.7);
        row := HorizontalLayout {
            padding-left: 9px;
            padding-right: root.removable ? 4px : 9px;
            spacing: 4px;
            Text { text: root.text; font-size: Theme.fs-small * 1.05; font-weight: 600; color: root.on ? white : Theme.text; vertical-alignment: center; }
            if root.removable: Icon { name: "close"; size: 14px; tint: Theme.icon; weight: 2px; y: (parent.height - self.height) / 2; }
        }
        TouchArea { clicked => { root.clicked(); } }
    }
}

// The helpful line shown for an empty list: icon, title, one sentence, optional action.
export component EmptyState {
    in property <string> icon: "info";
    in property <string> title;
    in property <string> hint;
    in property <string> action;
    callback act;
    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 8px;
        HorizontalLayout { alignment: center; Icon { name: root.icon; size: 36px; tint: Theme.icon-soft; weight: 1.5px; } }
        Text { text: root.title; font-size: Theme.fs-title * 0.95; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: root.hint; font-size: Theme.fs; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
        if root.action != "": HorizontalLayout { alignment: center; padding-top: 6px; PrimaryButton { text: root.action; clicked => { root.act(); } } }
    }
}

// A tab bar with an underline on the active tab (conversation tabs, details tabs, search tabs).
export component TabBar {
    in property <[string]> tabs;
    in property <int> current;
    in property <bool> fill: false; // tabs share the width (phone)
    callback picked(int);
    height: max(40px, 34px * Theme.scale);
    HorizontalLayout {
        padding-left: root.fill ? 0px : 12px;
        spacing: root.fill ? 0px : 4px;
        alignment: root.fill ? stretch : start;
        for t[i] in root.tabs: Rectangle {
            horizontal-stretch: root.fill ? 1 : 0;
            min-width: lbl.preferred-width + 24px;
            background: ta.has-hover && root.current != i ? Theme.row-hover : transparent;
            border-radius: Theme.r-sm;
            lbl := Text { text: t; font-size: Theme.fs * 0.95; font-weight: root.current == i ? 700 : 500; color: root.current == i ? Theme.text : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            if root.current == i: Rectangle { y: parent.height - 3px; height: 3px; border-radius: 1.5px; background: Theme.accent; x: 10px; width: parent.width - 20px; }
            ta := TouchArea { clicked => { root.picked(i); } }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; z: -1; }
}

// A desktop menu row (right-click and dropdown menus).
export component MenuRow {
    in property <string> icon;
    in property <string> text;
    in property <string> hint;
    in property <bool> danger: false;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked;
    height: max(34px, 30px * Theme.scale);
    Rectangle {
        border-radius: Theme.r-sm;
        background: ta.has-hover && root.enabled ? Theme.accent.with-alpha(0.18) : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            if root.icon != "": Icon { name: root.icon; size: 18px; tint: root.danger ? Theme.danger : Theme.icon; y: (parent.height - self.height) / 2; }
            Text { text: root.text; font-size: Theme.fs * 0.95; color: !root.enabled ? Theme.muted : (root.danger ? Theme.danger : Theme.text); vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.hint != "": Text { text: root.hint; font-size: Theme.fs-small; color: Theme.muted; vertical-alignment: center; }
            if root.checked: Icon { name: "check"; size: 16px; tint: Theme.accent-text; y: (parent.height - self.height) / 2; }
        }
        ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component MenuDivider {
    height: 9px;
    Rectangle { y: 4px; height: 1px; background: Theme.line; }
}

// A small square icon button for toolbars (hover toolbar, formatting row).
export component ToolButton {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <length> size: 30px;
    in property <length> glyph: 18px;
    in property <bool> filled: false;
    in property <brush> tint: Theme.icon;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: Theme.r-sm;
        background: root.active ? Theme.accent.with-alpha(0.22) : (ta.pressed ? Theme.bubble-other : (ta.has-hover ? Theme.row-hover.with-alpha(0.14) : transparent));
        Icon { name: root.icon; size: root.glyph; filled: root.filled; tint: root.active ? Theme.accent-text : root.tint; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}
