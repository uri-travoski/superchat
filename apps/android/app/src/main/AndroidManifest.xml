<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Saving a picture to the gallery needs no permission from Android 10 (MediaStore); before that it needs this one. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Update checks: the downloaded APK is handed to the system installer (the user must allow "Install unknown apps" for SuperChat once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:hasCode="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density|keyboard|navigation"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="atomic_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- One-time login links: a phone camera app that scans the admin panel's QR code opens SuperChat -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="superchat" android:host="login" />
            </intent-filter>
            <!-- The same link as a web URL, https://<server>/l/<token> (also http for a LAN server). autoVerify is off: Android may
                 ask once whether to open SuperChat or the browser. The server's landing page also opens the app by itself. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="*" />
                <data android:pathPrefix="/l/" />
            </intent-filter>
            <!-- E-06: share text, pictures and files from other apps into a conversation -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".MediaActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Status of the PackageInstaller session that installs a downloaded update (see Installer.kt). -->
        <receiver android:name=".Installer$ResultReceiver" android:exported="false">
            <intent-filter>
                <action android:name="app.superchat.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Spike aid: lets adb post a message notification that opens a conversation. -->
        <receiver android:name=".TestNotifyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="app.superchat.TEST_NOTIFY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
