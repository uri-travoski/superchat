import { Palette } from "std-widgets.slint";

export struct ConvItem {
    id: string,
    title: string,
    initials: string,
    color: color,
    unread: int,
    mentions: int,
    preview: string,
    stamp: string,
    kind: string,
    favourite: bool,
    muted: bool,
    archived: bool,
    header: string, // non-empty on the first row of a section
}

export struct BlockItem {
    kind: int, // 0 paragraph/list, 1 code, 2 quote
    text: string,
    styled: styled-text,
}

export struct ReactItem {
    emoji: string,
    count: int,
    mine: bool,
    img: image,
    has-img: bool,
}

// A picker emoji; `img` is the colour picture (the text renderers draw colour fonts as outlines).
export struct EmojiItem {
    ch: string,
    img: image,
    has-img: bool,
}

export struct FormOptionItem {
    value: string,
    label: string,
    on: bool,
}

export struct FormFieldItem {
    id: string,
    kind: int, // 0 text, 1 multiline, 2 boolean, 3 select, 4 multi select
    label: string,
    placeholder: string,
    required: bool,
    text: string,
    flag: bool,
    options: [FormOptionItem],
}

export struct FormButtonItem {
    id: string,
    label: string,
    style: string, // primary, danger or empty
    modal: bool,
}

export struct FileItem {
    id: string,
    name: string,
    size: string,
    kind: int, // 0 other, 1 image, 2 video, 3 audio
    img: image,
    has-img: bool,
    removed: bool,
}

export struct MsgItem {
    id: string,
    sender: string,
    initials: string,
    color: color,
    time: string,
    mine: bool,
    edited: bool,
    deleted: bool,
    can-edit: bool,
    state: int, // 0 sent, 1 sending, 2 failed, 3 delivered
    day: string,
    blocks: [BlockItem],
    files: [FileItem],
    reactions: [ReactItem],
    replies: int,
    pinned: bool,
    forwarded: string,
    quote: string,
    divider: bool,
    can-pin: bool,
    is-app: bool,
    has-form: bool,
    form-title: string,
    form-desc: string,
    form-fields: bool,
    form-buttons: [FormButtonItem],
    responded: bool,
}

export struct PersonItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    sub: string,
}

// One row of a generic list: search results, threads, files, pins, sessions, quick switcher.
export struct RowItem {
    kind: int, // search: 0 message, 1 file, 2 person, 3 channel
    id: string,
    conv: string,
    title: string,
    sub: string,
    text: string,
    badge: int,
    flag: bool,
    initials: string,
    color: color,
    header: string,
}

export struct BookmarkItem {
    id: string,
    title: string,
    url: string,
}

export global Theme {
    // Text size multiplier (Regular 1.0, Large 1.15, XL 1.3) times zoom times the Android system scale.
    in-out property <float> scale: 1.0;
    in-out property <bool> compact: false;
    in-out property <int> accent-index: 0;
    in-out property <bool> reduce-motion: false;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: [#0dbd8b, #0467dd, #6a4cf5, #e8590c][accent-index];
    out property <color> accent-text: dark ? [#3ddcae, #6aa9ff, #a898ff, #ff9a5c][accent-index] : [#087a5c, #0467dd, #5a3fe0, #b8460a][accent-index];
    // Text on an accent fill must keep 4.5:1; the orange and green accents need dark text.
    out property <color> on-accent: [#06281f, #ffffff, #ffffff, #1f0d02][accent-index];
    out property <length> fs: 15px * scale;
    out property <length> fs-small: 12px * scale;
    out property <length> fs-title: 19px * scale;
    out property <length> fs-large: 24px * scale;
    out property <length> pad: compact ? 5px : 10px;

    // ---- spacing scale (4 / 8 / 12 / 16 / 24), radii, touch target ----
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp6: 24px;
    out property <length> r-sm: 8px;
    out property <length> r-md: 12px;
    out property <length> r-lg: 16px;
    out property <length> r-sheet: 24px;
    out property <length> touch: 48px;

    // ---- colour tokens: a soft dark theme (never pure black), light icons ----
    out property <color> bg: dark ? #1c1f24 : #ffffff;
    out property <color> surface: dark ? #262a31 : #f2f4f8;
    out property <color> surface-high: dark ? #30353d : #e7eaf0;
    out property <color> sheet-bg: dark ? #272b32 : #ffffff;
    out property <color> scrim: #000000;
    out property <color> muted: dark ? #aab1bd : #596273;
    out property <color> line: dark ? #ffffff1f : #0000001a;
    out property <color> icon: dark ? #c4cad4 : #5a6372;
    out property <color> icon-soft: dark ? #aeb5c1 : #6b7482;
    out property <color> text: dark ? #eceff4 : #1b1f24;
    out property <color> bubble-mine: accent.with-alpha(0.2);
    out property <color> bubble-other: dark ? #ffffff14 : #00000010;
    out property <color> sidebar: dark ? #1c1f24 : #ffffff;
    out property <color> danger: dark ? #ff8a80 : #c62828;
    out property <color> on-danger: dark ? #1c1f24 : #ffffff;
    out property <color> ok: dark ? #5fd38a : #2e7d32;
    out property <color> warn: dark ? #ffd166 : #b26a00;
}
