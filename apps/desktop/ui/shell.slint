// The app shell: rail, top bar, sidebar rows, bottom navigation, list rows of the Activity / DMs / Later views.
import { Theme, SideRow, ActivityRow, SavedRow, LabelItem, Drag } from "theme.slint";
import { Icon } from "icons.slint";
import { Avatar, PressArea, ToolButton, LabelChip, CountBadge, IconButton, Fab, PicFill } from "components.slint";

// The thin left rail (desktop): server tile, Home / DMs / Activity / Later / More, and the profile button.
export component Rail {
    in property <string> tab;
    // Highlights the More button while its popover is open.
    in property <bool> more-open: false;
    in property <string> server-initials;
    in property <int> activity-unread;
    in property <int> dm-unread;
    in property <string> me-initials;
    in property <string> me-id;
    in property <color> me-color;
    in property <int> presence: 1;
    // A newer release exists: a small download button above the profile opens Settings > About.
    in property <bool> update-available: false;
    callback update-clicked;
    callback picked(string);
    callback server-clicked;
    // The More button and the avatar open popovers next to the rail: (right edge x, anchor y).
    callback more-clicked(length, length);
    callback profile-clicked(length, length);
    width: 68px * max(1.0, Theme.scale * 0.9);
    Rectangle {
        background: Theme.rail;
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 6px;
            HorizontalLayout {
                alignment: center;
                height: 44px * Theme.scale;
                Rectangle {
                    width: 40px * Theme.scale;
                    height: self.width;
                    border-radius: 10px * Theme.scale;
                    background: Theme.accent;
                    Text { text: root.server-initials; color: Theme.on-accent; font-weight: 700; font-size: Theme.fs * 1.15; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.server-clicked(); } }
                }
            }
            for t[i] in [{id: "home", icon: "home", label: "Home"}, {id: "dms", icon: "chat", label: "DMs"}, {id: "activity", icon: "bell", label: "Activity"}, {id: "later", icon: "bookmark", label: "Later"}, {id: "more", icon: "more-h", label: "More"}]: Rectangle {
                height: 58px * Theme.scale;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px * Theme.scale;
                            height: 32px * Theme.scale;
                            border-radius: 10px;
                            background: root.tab == t.id || (t.id == "more" && root.more-open) ? Theme.accent.with-alpha(0.25) : (ta.has-hover ? Theme.row-hover : transparent);
                            Icon { name: t.icon; size: 22px * Theme.scale; filled: root.tab == t.id && t.id == "bookmark"; tint: root.tab == t.id ? Theme.accent-text : Theme.icon; weight: root.tab == t.id ? 2.2px : 1.75px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            if (t.id == "activity" && root.activity-unread > 0) || (t.id == "dms" && root.dm-unread > 0): Rectangle {
                                x: parent.width - 16px; y: -2px; width: 16px; height: 16px; border-radius: 8px; background: Theme.danger;
                                Text { text: t.id == "activity" ? (root.activity-unread > 9 ? "9+" : root.activity-unread) : (root.dm-unread > 9 ? "9+" : root.dm-unread); font-size: 10px; font-weight: 700; color: Theme.on-danger; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Text { text: t.label; font-size: Theme.fs-small * 0.92; font-weight: root.tab == t.id ? 700 : 500; color: root.tab == t.id ? Theme.text : Theme.muted; horizontal-alignment: center; }
                }
                ta := TouchArea { clicked => { if t.id == "more" { root.more-clicked(root.width, self.absolute-position.y); } else { root.picked(t.id); } } }
            }
            Rectangle { vertical-stretch: 1; }
            if root.update-available: Rectangle {
                height: 52px * Theme.scale;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px * Theme.scale; height: 32px * Theme.scale; border-radius: 10px;
                            background: ua.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.22);
                            Icon { name: "download"; size: 20px * Theme.scale; tint: Theme.accent-text; weight: 2.2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            Rectangle { x: parent.width - 11px; y: 1px; width: 9px; height: 9px; border-radius: 4.5px; background: Theme.danger; }
                        }
                    }
                    Text { text: "Update"; font-size: Theme.fs-small * 0.92; font-weight: 600; color: Theme.accent-text; horizontal-alignment: center; }
                }
                ua := TouchArea { clicked => { root.update-clicked(); } }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 38px * Theme.scale;
                    height: self.width;
                    Avatar { uid: root.me-id; initials: root.me-initials; tint: root.me-color; size: parent.width; presence: root.presence; }
                    TouchArea { clicked => { root.profile-clicked(root.width, self.absolute-position.y + self.height); } }
                }
            }
        }
    }
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
}

// Top bar (desktop): history arrows, the centred search field, help.
export component TopBar {
    in property <string> server-name;
    in property <bool> can-back;
    in property <bool> can-forward;
    callback back;
    callback forward;
    callback search;
    callback help;
    height: max(44px, 36px * Theme.scale);
    Rectangle {
        background: Theme.rail;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            ToolButton { icon: "chevron-left"; label: "Back"; size: 30px * Theme.scale; tint: root.can-back ? Theme.icon : Theme.icon-soft.with-alpha(0.4); y: (parent.height - self.height) / 2; clicked => { root.back(); } }
            ToolButton { icon: "chevron-right"; label: "Forward"; size: 30px * Theme.scale; tint: root.can-forward ? Theme.icon : Theme.icon-soft.with-alpha(0.4); y: (parent.height - self.height) / 2; clicked => { root.forward(); } }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: min(560px, max(240px, parent.width * 0.45));
                height: 30px * Theme.scale;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.r-sm;
                background: sa.has-hover ? Theme.surface-high : Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 8px;
                    Icon { name: "search"; size: 16px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
                    Text { text: "Search " + root.server-name; font-size: Theme.fs * 0.95; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                }
                sa := TouchArea { clicked => { root.search(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            ToolButton { icon: "help"; label: "Help and keyboard shortcuts"; size: 30px * Theme.scale; y: (parent.height - self.height) / 2; clicked => { root.help(); } }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// One row of the sidebar / Home list: a section header, a conversation, a quick link or a hint.
export component SideItem {
    in property <SideRow> r;
    in property <bool> selected;
    in property <bool> wide: true;
    callback clicked;
    callback toggle;
    callback plus;
    callback menu(length, length);
    callback dropped;
    // NV-04: desktop rows (conversations and section headers) can be dragged to a new place.
    property <bool> reorderable: root.wide && (r.kind == 1 || (r.kind == 0 && r.id != "sec:shortcuts" && r.id != "sec:archived"));
    property <int> zone: (Drag.active && root.wide && (r.kind == 0 || r.kind == 1 || r.id == "sec:archived") && Drag.src != r.id && Drag.y >= root.absolute-position.y && Drag.y < root.absolute-position.y + root.height) ? (Drag.y < root.absolute-position.y + root.height / 2 ? 1 : 2) : 0;
    changed zone => { if root.zone != 0 { Drag.target = r.id; Drag.zone = root.zone; } }
    opacity: Drag.active && Drag.src == r.id ? 0.4 : 1.0;
    property <length> row-h: root.wide ? max(30px, 26px * Theme.scale) : max(52px, 46px * Theme.scale);
    height: r.kind == 0 ? (root.wide ? max(32px, 28px * Theme.scale) : max(48px, 40px * Theme.scale)) : (r.kind == 3 ? 56px * Theme.scale : (r.kind == 4 ? (root.wide ? 0px : 88px) : root.row-h));
    if r.kind == 0: Rectangle {
        background: hh.has-hover ? Theme.row-hover : transparent;
        border-radius: Theme.r-sm;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 4px;
            Icon { name: r.collapsed ? "chevron-right" : "chevron-down"; size: 16px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
            Text { text: r.title; font-size: Theme.fs * (root.wide ? 0.95 : 1.0); font-weight: 700; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if r.collapsed && r.unread > 0: Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: Theme.accent; }
            if r.plus != "": ToolButton {
                icon: "plus";
                label: r.plus == "channel" ? "Add or browse channels" : (r.plus == "dm" ? "New message" : "Add");
                size: root.wide ? 26px * Theme.scale : 40px;
                y: (parent.height - self.height) / 2;
                tint: Theme.icon;
                clicked => { root.plus(); }
            }
        }
        hh := PressArea {
            width: parent.width - (r.plus != "" ? (root.wide ? 30px * Theme.scale : 44px) : 0px);
            draggable: root.reorderable;
            tapped => { root.toggle(); }
            long-pressed => { if r.id != "sec:shortcuts" && r.id != "sec:archived" { root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
            drag-started => { Drag.src = r.id; Drag.label = r.title; Drag.active = true; }
            drag-moved(x, y) => { Drag.x = x; Drag.y = y; }
            drag-ended => { root.dropped(); }
        }
    }
    if r.kind == 1 || r.kind == 2: Rectangle {
        background: root.selected ? Theme.row-sel : (pa.has-hover ? Theme.row-hover : transparent);
        border-radius: Theme.r-sm;
        HorizontalLayout {
            padding-left: root.wide ? 12px : 16px;
            padding-right: 8px;
            spacing: root.wide ? 8px : 14px;
            if r.kind == 2: Icon { name: r.icon; size: (root.wide ? 18px : 22px) * Theme.scale; tint: Theme.icon; y: (parent.height - self.height) / 2; }
            if r.kind == 1 && r.pic && (r.conv-kind == "channel" || r.conv-kind == "group"): Rectangle { width: (root.wide ? 22px : 32px) * Theme.scale; height: self.width; y: (parent.height - self.height) / 2; border-radius: 6px; clip: true; PicFill { x: 0px; y: 0px; width: parent.width; height: parent.height; key: "conv:" + r.id; } }
            if r.kind == 1 && !r.pic && (r.conv-kind == "channel"): Icon { name: "hash"; size: (root.wide ? 18px : 22px) * Theme.scale; tint: r.muted ? Theme.icon-soft.with-alpha(0.6) : Theme.icon; y: (parent.height - self.height) / 2; }
            if r.kind == 1 && !r.pic && r.conv-kind == "group": Icon { name: "users"; size: (root.wide ? 18px : 22px) * Theme.scale; tint: Theme.icon; y: (parent.height - self.height) / 2; }
            if r.kind == 1 && (r.conv-kind == "dm" || r.conv-kind == "self"): Avatar { uid: r.user-id; initials: r.initials; tint: r.color; size: (root.wide ? 22px : 32px) * Theme.scale; presence: r.presence; y: (parent.height - self.height) / 2; }
            Text {
                text: r.title;
                font-size: Theme.fs * (root.wide ? 0.97 : 1.03);
                font-weight: (r.unread > 0 || r.mentions > 0) ? 800 : 400;
                color: r.muted ? Theme.muted.with-alpha(0.75) : (r.unread > 0 ? Theme.text : Theme.text.with-alpha(0.9));
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if r.locked: Icon { name: "lock"; size: 13px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
            if r.draft: Icon { name: "edit"; size: 14px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
            if r.mentions > 0: CountBadge { n: r.mentions; hot: true; y: (parent.height - self.height) / 2; }
            if r.mentions == 0 && r.unread > 0 && (r.kind == 2 || !root.wide): CountBadge { n: r.unread; quiet: r.muted; y: (parent.height - self.height) / 2; }
            if r.mentions == 0 && r.kind == 2 && r.count > 0 && r.unread == 0: Text { text: r.count; font-size: Theme.fs-small; color: Theme.muted; vertical-alignment: center; }
        }
        pa := PressArea {
            draggable: root.reorderable;
            tapped => { root.clicked(); }
            long-pressed => { if r.kind == 1 { root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
            drag-started => { Drag.src = r.id; Drag.label = r.title; Drag.active = true; }
            drag-moved(x, y) => { Drag.x = x; Drag.y = y; }
            drag-ended => { root.dropped(); }
        }
    }
    // The drop marker: a line above or below this row (a section header takes a dragged conversation into the section).
    if root.zone == 1: Rectangle { y: 0px; height: 2px; x: 8px; width: parent.width - 16px; background: Theme.accent; border-radius: 1px; }
    if root.zone == 2: Rectangle { y: parent.height - 2px; height: 2px; x: 8px; width: parent.width - 16px; background: Theme.accent; border-radius: 1px; }
    if r.kind == 3: Text { x: 16px; width: parent.width - 32px; text: r.title; font-size: Theme.fs-small; color: Theme.muted; wrap: word-wrap; vertical-alignment: center; }
}

// A direct-message row of the DMs list: avatar with presence, name, last message, time and unread badge.
export component DmRow {
    in property <SideRow> r;
    in property <bool> selected;
    callback clicked;
    callback menu(length, length);
    height: max(64px, 54px * Theme.scale);
    Rectangle {
        background: root.selected ? Theme.row-sel : (pa.has-hover ? Theme.row-hover : transparent);
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 12px;
            if r.conv-kind == "group": Rectangle { width: 40px * Theme.scale; height: self.width; y: (parent.height - self.height) / 2; border-radius: 10px; background: r.color; clip: true; Icon { name: "users"; size: 22px; tint: white; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } if r.pic: PicFill { x: 0px; y: 0px; width: parent.width; height: parent.height; key: "conv:" + r.id; } }
            if r.conv-kind != "group": Avatar { uid: r.user-id; initials: r.initials; tint: r.color; size: 40px * Theme.scale; presence: r.presence; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: r.title; font-size: Theme.fs; font-weight: r.unread > 0 ? 800 : 600; color: r.muted ? Theme.muted : Theme.text; overflow: elide; horizontal-stretch: 1; }
                    if r.locked: Icon { name: "lock"; size: 13px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                    Text { text: r.stamp; font-size: Theme.fs-small; color: Theme.muted; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: r.preview; font-size: Theme.fs-small * 1.05; color: r.unread > 0 ? Theme.text : Theme.muted; font-weight: r.unread > 0 ? 600 : 400; overflow: elide; horizontal-stretch: 1; }
                    if r.mentions > 0: CountBadge { n: r.mentions; hot: true; }
                    if r.mentions == 0 && r.unread > 0: CountBadge { n: r.unread; quiet: r.muted; }
                }
            }
        }
        pa := PressArea {
            tapped => { root.clicked(); }
            long-pressed => { root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
}

// One entry of the Activity view.
export component ActivityItem {
    in property <ActivityRow> a;
    callback clicked;
    height: max(76px, 64px * Theme.scale);
    Rectangle {
        background: pa.has-hover ? Theme.row-hover : (a.unread ? Theme.accent.with-alpha(0.07) : transparent);
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            Rectangle {
                width: 8px;
                Rectangle { width: 8px; height: 8px; y: 14px; border-radius: 4px; background: a.unread ? Theme.accent : transparent; }
            }
            Rectangle {
                width: 38px * Theme.scale;
                height: self.width;
                y: 10px;
                Avatar { uid: a.user-id; initials: a.initials; tint: a.color; size: parent.width; }
                Rectangle {
                    x: parent.width - 16px; y: parent.height - 16px; width: 18px; height: 18px; border-radius: 9px; background: Theme.bg; border-width: 1px; border-color: Theme.line;
                    if a.kind == 0: Icon { name: "at"; size: 12px; tint: Theme.accent-text; weight: 2.2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    if a.kind == 2: Icon { name: "thread"; size: 12px; tint: Theme.accent-text; weight: 2.2px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    if a.kind == 1 && a.has-img: Image { source: a.img; width: 12px; height: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    if a.kind == 1 && !a.has-img: Text { text: a.emoji; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: a.title; font-size: Theme.fs * 0.97; font-weight: a.unread ? 800 : 600; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                    Text { text: a.time; font-size: Theme.fs-small; color: Theme.muted; }
                }
                Text { text: a.snippet; font-size: Theme.fs-small * 1.05; color: Theme.muted; overflow: elide; }
            }
        }
        pa := TouchArea { clicked => { root.clicked(); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; x: 70px; }
}

// A saved message (Later view): conversation, sender, text, label chips and its two actions.
export component SavedCard {
    in property <SavedRow> s;
    callback clicked;
    callback label;
    callback remove;
    height: card.preferred-height + 1px;
    card := Rectangle {
        background: pa.has-hover ? Theme.row-hover : transparent;
        height: col.preferred-height;
        col := VerticalLayout {
            padding: 12px;
            padding-left: 14px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Icon { name: "bookmark"; size: 16px; filled: true; tint: Theme.accent-text; y: 2px; }
                Text { text: s.conv-title; font-size: Theme.fs-small * 1.05; color: Theme.muted; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                Text { text: s.time; font-size: Theme.fs-small; color: Theme.muted; }
            }
            HorizontalLayout {
                spacing: 10px;
                if !s.deleted: Avatar { uid: s.user-id; initials: s.initials; tint: s.color; size: 30px * Theme.scale; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    if !s.deleted: Text { text: s.sender; font-size: Theme.fs; font-weight: 700; color: Theme.text; }
                    Text { text: s.deleted ? "Message deleted" : s.text; font-size: Theme.fs; color: s.deleted ? Theme.muted : Theme.text; font-italic: s.deleted; wrap: word-wrap; max-height: 5 * Theme.fs * 1.4; overflow: elide; }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for l in s.labels: LabelChip { text: l.name; tint: l.tint; }
                Rectangle { horizontal-stretch: 1; }
                ToolButton { icon: "tag"; label: "Labels"; size: 28px * Theme.scale; glyph: 16px; clicked => { root.label(); } }
                ToolButton { icon: "close"; label: "Remove from saved items"; size: 28px * Theme.scale; glyph: 16px; clicked => { root.remove(); } }
            }
        }
        pa := TouchArea { z: -1; clicked => { root.clicked(); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// 1.4.1 phone: the top bar of every tab. Its title IS the screen name ("Direct Messages", "Channels", "Search", "Menu", the
// same size and weight as before), so no heading repeats below it. On the right, on the two lists only, the 3-dot menu (the
// App Lock "Lock" / "Unlock" row lives in that menu, there is no padlock in the bar).
export component PhoneTopBar {
    in property <string> title;
    in property <bool> show-more: true;
    callback more;
    height: max(56px, 44px * Theme.scale);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        spacing: 0px;
        Text { text: root.title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.show-more: IconButton { icon: "more"; label: "More options"; clicked => { root.more(); } y: (parent.height - self.height) / 2; }
    }
}

// 1.4 phone: one row of the DMs or Channels list. Pinned rows (`favourite`) sit at the top without a header; a long press arms
// one for dragging (a handle appears) and sliding it up or down re-orders the pinned rows; letting go in place opens the menu.
export component PhoneRow {
    in property <SideRow> r;
    in property <bool> selected;
    callback clicked;
    callback menu(length, length);
    callback dropped;
    property <int> zone: (Drag.active && r.kind == 1 && r.favourite && Drag.src != r.id && Drag.y >= root.absolute-position.y && Drag.y < root.absolute-position.y + root.height) ? (Drag.y < root.absolute-position.y + root.height / 2 ? 1 : 2) : 0;
    changed zone => { if root.zone != 0 { Drag.target = r.id; Drag.zone = root.zone; } }
    opacity: Drag.active && Drag.src == r.id ? 0.45 : 1.0;
    height: r.kind == 5 ? max(40px, 32px * Theme.scale) : max(68px, 58px * Theme.scale);
    if r.kind == 5: Text { x: 16px; width: parent.width - 32px; text: r.title; font-size: Theme.fs-small; font-weight: 700; color: Theme.muted; vertical-alignment: center; overflow: elide; }
    if r.kind == 1: Rectangle {
        background: pa.active ? Theme.surface-high : (root.selected ? Theme.row-sel : (pa.has-hover ? Theme.row-hover : transparent));
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 12px;
            if r.conv-kind == "channel": Rectangle {
                width: 44px * min(Theme.scale, 1.3); height: self.width; y: (parent.height - self.height) / 2; border-radius: 12px; background: r.color.with-alpha(0.18); clip: true;
                Icon { name: "hash"; size: 22px * min(Theme.scale, 1.3); tint: r.muted ? Theme.icon-soft : (Theme.dark ? r.color.brighter(0.4) : r.color.darker(0.2)); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                if r.pic: PicFill { x: 0px; y: 0px; width: parent.width; height: parent.height; key: "conv:" + r.id; }
            }
            if r.conv-kind == "group": Rectangle { width: 44px * min(Theme.scale, 1.3); height: self.width; y: (parent.height - self.height) / 2; border-radius: 12px; background: r.color; clip: true; Icon { name: "users"; size: 22px; tint: white; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } if r.pic: PicFill { x: 0px; y: 0px; width: parent.width; height: parent.height; key: "conv:" + r.id; } }
            if r.conv-kind == "dm" || r.conv-kind == "self": Avatar { uid: r.user-id; initials: r.initials; tint: r.color; size: 44px * min(Theme.scale, 1.3); presence: r.presence; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: r.title; font-size: Theme.fs; font-weight: r.unread > 0 ? 800 : 600; color: r.muted ? Theme.muted : Theme.text; overflow: elide; horizontal-stretch: 1; }
                    if r.locked: Icon { name: "lock"; size: 13px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                    if r.favourite && !pa.active: Icon { name: "pin"; size: 13px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                    Text { text: r.stamp; font-size: Theme.fs-small; color: Theme.muted; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    if r.draft: Icon { name: "edit"; size: 14px; tint: Theme.icon-soft; y: (parent.height - self.height) / 2; }
                    Text { text: r.preview; font-size: Theme.fs-small * 1.05; color: r.unread > 0 ? Theme.text : Theme.muted; font-weight: r.unread > 0 ? 600 : 400; overflow: elide; horizontal-stretch: 1; }
                    if r.mentions > 0: CountBadge { n: r.mentions; hot: true; }
                    if r.mentions == 0 && r.unread > 0: CountBadge { n: r.unread; quiet: r.muted; }
                }
            }
            if pa.active: Icon { name: "grip"; size: 24px; tint: Theme.icon; y: (parent.height - self.height) / 2; }
        }
        pa := PressArea {
            hold-drag: r.favourite;
            tapped => { root.clicked(); }
            long-pressed => { root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            hold-started => { Drag.holding = true; }
            hold-ended => { Drag.holding = false; }
            drag-started => { Drag.src = r.id; Drag.label = r.title; Drag.active = true; }
            drag-moved(x, y) => { Drag.x = x; Drag.y = y; }
            drag-ended => { root.dropped(); }
        }
    }
    if root.zone == 1: Rectangle { y: 0px; height: 2px; x: 8px; width: parent.width - 16px; background: Theme.accent; border-radius: 1px; }
    if root.zone == 2: Rectangle { y: parent.height - 2px; height: 2px; x: 8px; width: parent.width - 16px; background: Theme.accent; border-radius: 1px; }
}

// 1.4 phone: the scrolling list of one tab. Stops scrolling while a row is armed for dragging; leaves room under the last row
// so the "+" button never covers it.
export component PhoneList {
    in property <[SideRow]> rows;
    in property <string> selected;
    // Channels, for admins: a first entry that creates a channel.
    in property <bool> can-create: false;
    callback clicked(string);
    callback menu(string, string, bool, length, length);
    callback dropped;
    callback create;
    callback fab;
    // The "+" button hides while scrolling down and returns on scroll up or at the end of the list. At rest it only shows when
    // it covers no row (the list fits).
    property <length> scroll-y <=> fl.viewport-y;
    property <length> prev-y;
    property <bool> fab-up: false;
    property <bool> fab-shown: (fl.viewport-y >= 0px && fl.viewport-height <= fl.height + 2px) || (fl.viewport-height > fl.height && fl.viewport-y <= fl.height - fl.viewport-height + 4px) || (root.fab-up && fl.viewport-y < 0px);
    changed scroll-y => {
        if root.scroll-y >= 0px { root.fab-up = false; }
        else if root.scroll-y > root.prev-y + 1px { root.fab-up = true; }
        else if root.scroll-y < root.prev-y - 1px { root.fab-up = false; }
        root.prev-y = root.scroll-y;
    }
    fl := Flickable {
        interactive: !Drag.holding && !Drag.active;
        viewport-height: lay.preferred-height;
        lay := VerticalLayout {
            alignment: start;
            if root.can-create: Rectangle {
                height: max(60px, 52px * Theme.scale);
                background: cr.pressed ? Theme.row-hover : transparent;
                HorizontalLayout {
                    padding-left: 14px; spacing: 12px;
                    Rectangle { width: 44px * min(Theme.scale, 1.3); height: self.width; y: (parent.height - self.height) / 2; border-radius: 12px; background: Theme.accent.with-alpha(0.18);
                        Icon { name: "plus"; size: 22px; tint: Theme.accent-text; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
                    Text { text: "Create channel"; font-size: Theme.fs; font-weight: 600; color: Theme.accent-text; vertical-alignment: center; }
                }
                cr := TouchArea { clicked => { root.create(); } }
            }
            for r[i] in root.rows: PhoneRow {
                r: r;
                selected: r.kind == 1 && r.id == root.selected;
                clicked => { root.clicked(r.id); }
                menu(x, y) => { root.menu(r.id, r.title, r.favourite, x, y); }
                dropped => { root.dropped(); }
            }
            Rectangle { height: 96px; }
        }
    }
    if root.fab-shown: Fab {
        icon: "plus";
        glyph: #ffffff;
        label: "New message";
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        clicked => { root.fab(); }
    }
}

// Phone bottom navigation: DMs, Channels, Search, Menu.
export component BottomNav {
    in property <string> tab;
    in property <int> menu-unread;
    in property <int> dm-unread;
    in property <int> chan-unread;
    callback picked(string);
    // The bar never shrinks below its content (pill + label), so the pill always sits fully inside it.
    min-height: max(64px, 54px * Theme.scale);
    max-height: max(64px, 54px * Theme.scale);
    vertical-stretch: 0;
    Rectangle {
        background: Theme.sidebar;
        VerticalLayout {
            // One hairline at the very top edge of the bar.
            Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            for t[i] in [{id: "dms", icon: "chat", label: "DMs"}, {id: "channels", icon: "hash", label: "Channels"}, {id: "search", icon: "search", label: "Search"}, {id: "menu", icon: "menu", label: "Menu"}]: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 30px * Theme.scale;
                            border-radius: 15px * Theme.scale;
                            background: root.tab == t.id ? Theme.accent.with-alpha(0.25) : transparent;
                            Icon { name: t.icon; size: 24px * min(Theme.scale, 1.3); filled: false; tint: root.tab == t.id ? Theme.accent-text : Theme.icon; weight: root.tab == t.id ? 2.2px : 1.75px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            if (t.id == "menu" && root.menu-unread > 0) || (t.id == "dms" && root.dm-unread > 0) || (t.id == "channels" && root.chan-unread > 0): Rectangle {
                                x: parent.width / 2 + 6px; y: -2px; width: 18px; height: 18px; border-radius: 9px; background: Theme.danger;
                                Text { text: t.id == "menu" ? (root.menu-unread > 9 ? "9+" : root.menu-unread) : (t.id == "dms" ? (root.dm-unread > 9 ? "9+" : root.dm-unread) : (root.chan-unread > 9 ? "9+" : root.chan-unread)); font-size: 10px; font-weight: 700; color: Theme.on-danger; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Text { text: t.label; font-size: Theme.fs-small * 0.95; font-weight: root.tab == t.id ? 700 : 500; color: root.tab == t.id ? Theme.text : Theme.muted; horizontal-alignment: center; }
                }
                TouchArea { clicked => { root.picked(t.id); } }
            }
        }
        }
    }
}
