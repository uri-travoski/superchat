// Inter (SIL OFL 1.1, see fonts/Inter-OFL.txt) is bundled so every platform renders the same without a system install.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-Italic.ttf";
import { LineEdit, ListView, ScrollView, Palette, TextEdit } from "std-widgets.slint";
import { Theme, Avatars, AvatarImg, ConvItem, MsgItem, PersonItem, RowItem, BookmarkItem, BlockItem, FileItem, ReactItem, EmojiItem, FormFieldItem, FormOptionItem, FormButtonItem, SideRow, LabelItem, SavedRow, ActivityRow, Drag, SpellMark } from "theme.slint";
import { Avatar, Icon, IconButton, Fab, AppBar, BottomSheet, ModalCard, AlertDialog, SheetRow, SettingRow, Card, TextButton, Toggle, Link, Pill, PrimaryButton, GhostButton, SectionHeader, ToolButton, LabelChip, EmptyState, TabBar, CountBadge, MenuRow, MenuDivider, ChoiceRow, MenuLabel } from "components.slint";
import { MessageRow, Composer, PeoplePicker } from "chat.slint";
import { PinPad } from "pinpad.slint";
import { Rail, TopBar, SideItem, DmRow, ActivityItem, SavedCard, BottomNav, PhoneTopBar, PhoneList } from "shell.slint";
import { DetailsView } from "details.slint";
import { FileGlyph } from "filetype.slint";
