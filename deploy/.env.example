# Copy to .env and edit. Never commit .env.

# --- Server ---------------------------------------------------------------
# The public address clients use, including scheme. Used in one-time login links.
#   domain:  https://chat.example.com
#   bare IP: https://203.0.113.7   (with the caddy profile)  or  http://192.168.1.10:8080 (LAN testing only)
ATOMIC_PUBLIC_URL=http://localhost:8080
ATOMIC_NAME=SuperChat
# Host port that publishes the server when no proxy profile is used.
ATOMIC_PORT=8080
# First-run convenience: creates this owner account if no users exist (user:password). Leave empty to use the
# setup wizard at /admin instead.
ATOMIC_BOOTSTRAP_ADMIN=
ATOMIC_MAX_UPLOAD_MB=100
# Server image. Empty = the newest release (ghcr.io/uri-travoski/superchat-server:latest, public). To stay on one version:
#   SUPERCHAT_IMAGE=ghcr.io/uri-travoski/superchat-server:1.3.1
# Update with:  docker compose pull && docker compose up -d
SUPERCHAT_IMAGE=

# --- caddy profile (docker compose --profile caddy up -d) ------------------------
# Domain or bare IP that Caddy serves. For a bare IP also set CADDY_TLS=tls internal
ATOMIC_HOST=chat.example.com
CADDY_TLS=

# --- tunnel profile (Cloudflare Tunnel, no open ports) -------------------------
# Token from Zero Trust > Networks > Tunnels. Point the public hostname at http://superchat:8080
CLOUDFLARE_TUNNEL_TOKEN=

# --- ntfy profile (self-hosted push, used from Phase 3) -------------------------
ATOMIC_NTFY_URL=

# --- minio profile (development only; a local S3 for trying the storage settings) ----
MINIO_ROOT_USER=atomicdev
MINIO_ROOT_PASSWORD=change-me-dev-only
