    callback lock-cancel();
    callback lock-key(string);
    callback lock-start(string);
    callback lock-timeout-pick(int);
    callback toast-action();
    callback toggle-conv-lock(string);
    pure callback is-conv-locked(string) -> bool;
    callback paste-clip();
